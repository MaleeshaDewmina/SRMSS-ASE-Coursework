@model SRMSS.Web.Models.MaintenanceLog

@{
    ViewData["Title"] = "Delete Maintenance";
    ViewData["PageTitle"] = "Delete Maintenance";
    ViewData["PageSubtitle"] = "Remove an incorrect maintenance record from the system.";
}

<div class="srmss-card danger-panel">
    <h3 class="card-title">Delete Maintenance Record</h3>
    <p class="card-subtitle">This action permanently removes this maintenance record.</p>
    <div class="detail-list mb-4">
        <div><span>Vehicle</span><strong>@(Model.Vehicle?.RegistrationNumber ?? "Unknown")</strong></div>
        <div><span>Date</span><strong>@Model.MaintenanceDate.ToString("dd MMM yyyy")</strong></div>
        <div><span>Type</span><strong>@Model.MaintenanceType</strong></div>
        <div><span>Cost</span><strong>Rs. @Model.Cost.ToString("N2")</strong></div>
    </div>
    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="enterprise-form-actions">
            <a asp-action="Index" class="srmss-btn secondary">Cancel</a>
            <button type="submit" class="srmss-btn danger">Delete Maintenance</button>
        </div>
    </form>
</div>



