@model SRMSS.Web.Models.Announcement

@{
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Announcement" : "Create Announcement";
    ViewData["PageTitle"] = isEdit ? "Edit Announcement" : "Create Announcement";
    ViewData["PageSubtitle"] = "Publish operational notices, service alerts and customer-facing updates.";
}

<div class="srmss-card enterprise-form-card">
    <h3 class="card-title">Announcement Details</h3>
    <p class="card-subtitle">Select audience, priority, publish date and expiry date for controlled communication.</p>

    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
        @Html.AntiForgeryToken()
        @if (isEdit)
        {
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="CreatedBy" />
        }
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="enterprise-form-grid">
            <div class="enterprise-form-wide">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Audience" class="form-label"></label>
                <select asp-for="Audience" class="form-select">
                    <option>All</option>
                    <option>User</option>
                    <option>Customer</option>
                    <option>Admin</option>
                </select>
                <span asp-validation-for="Audience" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Priority" class="form-label"></label>
                <select asp-for="Priority" class="form-select">
                    <option>Normal</option>
                    <option>High</option>
                    <option>Critical</option>
                </select>
                <span asp-validation-for="Priority" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option>Published</option>
                    <option>Draft</option>
                    <option>Archived</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="PublishDate" class="form-label"></label>
                <input asp-for="PublishDate" type="date" class="form-control" />
                <span asp-validation-for="PublishDate" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="ExpiryDate" class="form-label"></label>
                <input asp-for="ExpiryDate" type="date" class="form-control" />
                <span asp-validation-for="ExpiryDate" class="text-danger"></span>
            </div>
            <div class="enterprise-form-wide">
                <label asp-for="Message" class="form-label"></label>
                <textarea asp-for="Message" rows="7" class="form-control"></textarea>
                <span asp-validation-for="Message" class="text-danger"></span>
            </div>
        </div>

        <div class="enterprise-form-actions">
            <a asp-action="Index" class="srmss-btn secondary">Back</a>
            <button type="submit" class="srmss-btn primary">@(isEdit ? "Update Announcement" : "Publish Announcement")</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}



