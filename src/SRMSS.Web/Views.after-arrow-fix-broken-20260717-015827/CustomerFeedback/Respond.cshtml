@model SRMSS.Web.Models.CustomerFeedback

@{
    ViewData["Title"] = "Respond Feedback";
    ViewData["PageTitle"] = "Respond Feedback";
    ViewData["PageSubtitle"] = "Update customer feedback status and provide an official depot response.";
}

<div class="srmss-card enterprise-form-card">
    <h3 class="card-title">Respond to Feedback</h3>
    <p class="card-subtitle">@Model.Subject</p>

    <div class="feedback-message-box mb-4">@Model.Message</div>

    <form asp-action="Respond" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="enterprise-form-grid">
            <div>
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="Open" selected="@(Model.Status == "Open")">Open</option>
                    <option value="In Review" selected="@(Model.Status == "In Review")">In Review</option>
                    <option value="Resolved" selected="@(Model.Status == "Resolved")">Resolved</option>
                    <option value="Closed" selected="@(Model.Status == "Closed")">Closed</option>
                </select>
            </div>
            <div>
                <label class="form-label">Priority</label>
                <select name="priority" class="form-select">
                    <option value="Low" selected="@(Model.Priority == "Low")">Low</option>
                    <option value="Normal" selected="@(Model.Priority == "Normal")">Normal</option>
                    <option value="High" selected="@(Model.Priority == "High")">High</option>
                    <option value="Critical" selected="@(Model.Priority == "Critical")">Critical</option>
                </select>
            </div>
            <div class="enterprise-form-wide">
                <label class="form-label">Response</label>
                <textarea name="response" rows="6" class="form-control">@Model.Response</textarea>
            </div>
        </div>

        <div class="enterprise-form-actions">
            <a asp-action="Details" asp-route-id="@Model.Id" class="srmss-btn secondary">Back</a>
            <button type="submit" class="srmss-btn primary">Save Response</button>
        </div>
    </form>
</div>



