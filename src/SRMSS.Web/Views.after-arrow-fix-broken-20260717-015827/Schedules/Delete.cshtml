@model SRMSS.Web.Models.Schedule

@{
    ViewData["Title"] = "Delete Schedule";
    ViewData["PageTitle"] = "Delete Schedule";
    ViewData["PageSubtitle"] = "Confirm before removing this trip schedule.";
}

<div class="schedule-create-grid">
    <div class="srmss-card">
        <h3 class="card-title">Delete Confirmation</h3>
        <p class="card-subtitle">
            Review the schedule before deleting it from the system.
        </p>

        <div class="validation-panel">
            <h3>Warning</h3>
            <p>
                This action will remove the selected schedule. Make sure this trip is not required for reports or testing evidence.
            </p>
        </div>

        <div class="details-list">
            <div class="details-row">
                <span>Route</span>
                <strong>@(Model.TransportRoute?.RouteName ?? "Unknown Route")</strong>
            </div>

            <div class="details-row">
                <span>Vehicle</span>
                <strong>@(Model.Vehicle?.RegistrationNumber ?? "Unknown Vehicle")</strong>
            </div>

            <div class="details-row">
                <span>Driver</span>
                <strong>@(Model.Driver?.FullName ?? "Unknown Driver")</strong>
            </div>

            <div class="details-row">
                <span>Schedule Date</span>
                <strong>@Model.ScheduleDate.ToString("dd MMM yyyy")</strong>
            </div>

            <div class="details-row">
                <span>Trip Time</span>
                <strong>@Model.DepartureTime.ToString(@"hh\:mm") - @Model.ArrivalTime.ToString(@"hh\:mm")</strong>
            </div>

            <div class="details-row">
                <span>Status</span>
                <strong>@Model.Status</strong>
            </div>

            <div class="details-row">
                <span>Notes</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes" : Model.Notes)</strong>
            </div>
        </div>

        <form asp-action="Delete" class="mt-4">
            <input type="hidden" asp-for="Id" />

            <div class="d-flex gap-3 flex-wrap">
                <button type="submit" class="srmss-btn danger">
                    Delete Schedule
                </button>

                <a asp-action="Index" class="srmss-btn secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>

    <div class="srmss-card amber">
        <h3 class="card-title">Delete Impact</h3>
        <p class="card-subtitle">
            This schedule will be removed from depot trip planning.
        </p>

        <div class="schedule-preview-card danger-preview">
            <div class="schedule-preview-top">
                <span class="status-pill red">Deleting</span>
                <strong>@Model.ScheduleDate.ToString("dd MMM")</strong>
            </div>

            <h4>@(Model.TransportRoute?.RouteName ?? "Route")</h4>

            <div class="schedule-preview-time">
                <span>@Model.DepartureTime.ToString(@"hh\:mm")</span>
                <div></div>
                <span>@Model.ArrivalTime.ToString(@"hh\:mm")</span>
            </div>
        </div>

        <div class="empty-stop-panel mt-4">
            <div class="empty-stop-icon">!</div>
            <h4>Before Deleting</h4>
            <p>
                Check that this trip is not needed for conflict testing or demonstration screenshots.
            </p>
        </div>
    </div>
</div>


