    font-size: 12px;
    font-weight: 900;
    margin-bottom: 14px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.route-flow-wrapper {
    display: flex;
    align-items: stretch;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 6px;
    max-width: 100%;
}

.route-flow-item {
    min-width: 170px;
    max-width: 210px;
    border-radius: 16px;
    padding: 14px;
    border: 1px solid #CBD5E1;
    flex: 0 0 auto;
}

.route-flow-item span {
    display: block;
    font-size: 11px;
    font-weight: 900;
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
}

.route-flow-item strong {
    display: block;
    font-size: 13px;
    font-weight: 900;
    color: #0F172A;
    line-height: 1.35;
}

.route-flow-item.start {
    background: #ECFDF3;
    border-color: #86EFAC;
}

.route-flow-item.start span {
    color: #16A34A;
}

.route-flow-item.stop {
    background: #EFF6FF;
    border-color: #93C5FD;
}

.route-flow-item.stop span {
    color: #2563EB;
}

.route-flow-item.end {
    background: #FEF2F2;
    border-color: #FCA5A5;
}

.route-flow-item.end span {
    color: #DC2626;
}

.route-flow-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1E3A8A;
    font-size: 24px;
    font-weight: 900;
    min-width: 24px;
    flex: 0 0 auto;
}

.route-map-warning {
    background: #FFF7ED;
    color: #9A3412;
    border: 1px solid #FDBA74;
    border-radius: 14px;
    padding: 12px 14px;
    font-size: 12px;
    font-weight: 800;
}

.transport-route-row.active {
    background: #F8FAFC;
}

.view-route-btn.active {
    background: #0F172A;
    color: white;
}

@media (max-width: 1100px) {
    .route-preview-grid {
        grid-template-columns: 1fr;
    }

    .route-map-frame,
    .live-route-map {
        height: 420px;
        min-height: 420px;
    }
}

@media (max-width: 700px) {
    .route-preview-topbar {
        display: block;
    }

    .route-preview-badge {
        display: inline-flex;
        margin-top: 12px;
    }

    .route-map-header {
        display: block;
    }

    .route-map-header .status-pill {
        margin-top: 12px;
    }

    .route-map-frame,
    .live-route-map {
        height: 320px;
        min-height: 320px;
    }

    .route-flow-wrapper {
        flex-direction: column;
        overflow-x: hidden;
    }

    .route-flow-item {
        max-width: 100%;
        width: 100%;
    }

    .route-flow-arrow {
        transform: rotate(90deg);
        min-height: 20px;
    }
}

/* Customer Route Search */

.customer-route-hero,
.customer-route-details-hero {
    background: linear-gradient(135deg, #0F172A, #1E3A8A);
    border-radius: 24px;
    padding: 28px;
    color: white;
    margin-bottom: 24px;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: center;
    box-shadow: 0 18px 35px rgba(15, 23, 42, 0.18);
}

.customer-route-hero h2,
.customer-route-details-hero h2 {
    font-size: 34px;
    font-weight: 900;
    margin: 12px 0 8px;
}

.customer-route-hero p,
.customer-route-details-hero p {
    color: #D7E4F7;
    font-weight: 600;
    margin: 0;
    max-width: 720px;
}

.customer-portal-pill {
    display: inline-flex;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: white;
    border-radius: 999px;
    padding: 7px 13px;
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.customer-route-hero-card {
    background: white;
    color: #0F172A;
    border-radius: 20px;
    padding: 22px;
    min-width: 180px;
    text-align: center;
}

.customer-route-hero-card strong {
    display: block;
    font-size: 38px;
    font-weight: 900;
}

.customer-route-hero-card span {
    color: #64748B;
    font-weight: 800;
    font-size: 13px;
}

.customer-search-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 180px 140px;
    gap: 14px;
    align-items: end;
}

.customer-search-button-area {
    display: flex;
    align-items: end;
}

.customer-route-layout {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(300px, 0.8fr);
    gap: 24px;
}

.customer-route-results {
    display: grid;
    gap: 18px;
}

.customer-route-card {
    border: 1px solid var(--border-soft);
    border-radius: 20px;
    padding: 18px;
    background: #FFFFFF;
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.05);
}

.customer-route-card-top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: start;
    margin-bottom: 14px;
}

.customer-route-card-top h4 {
    font-size: 18px;
    font-weight: 900;
    color: #0F172A;
    margin: 0 0 5px;
}

.customer-route-card-top p {
    color: #64748B;
    font-weight: 700;
    margin: 0;
}

.customer-route-meta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 14px;
}

.customer-route-meta div {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
    padding: 12px;
}

.customer-route-meta span {
    display: block;
    color: #64748B;
    font-size: 11px;
    font-weight: 900;
    margin-bottom: 5px;
}

.customer-route-meta strong {
    color: #0F172A;
    font-weight: 900;
}

.customer-mini-flow {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    padding: 13px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-bottom: 14px;
}

.customer-mini-flow span {
    font-size: 12px;
    font-weight: 900;
}

.flow-start {
    color: #16A34A;
}

.flow-stop {
    color: #2563EB;
}

.flow-end {
    color: #DC2626;
}

.flow-more {
    color: #F59E0B;
}

.flow-arrow {
    color: #64748B;
}

.customer-route-schedule-preview {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 14px;
}

.customer-route-schedule-preview span {
    color: #64748B;
    font-size: 12px;
    font-weight: 900;
}

.customer-route-schedule-preview strong {
    color: #0F172A;
    font-weight: 900;
}

.customer-route-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.customer-help-list {
    display: grid;
    gap: 14px;
}

.customer-help-list div {
    display: flex;
    gap: 12px;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    padding: 14px;
}

.customer-help-list span {
    background: #1E3A8A;
    color: white;
    border-radius: 999px;
    width: 28px;
    height: 28px;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
}

.customer-help-list p {
    margin: 0;
    color: #334155;
    font-weight: 700;
}

.customer-empty-state {
    background: #F8FAFC;
    border: 1px dashed #CBD5E1;
    border-radius: 18px;
    padding: 28px;
    text-align: center;
    color: #64748B;
    font-weight: 800;
}

.customer-empty-state h4 {
    color: #0F172A;
    font-weight: 900;
}

.customer-empty-state.small {
    padding: 18px;
}

.customer-route-details-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    min-width: 520px;
}

.customer-route-details-stats div {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 16px;
    padding: 14px;
}

.customer-route-details-stats span {
    display: block;
    color: #D7E4F7;
    font-size: 11px;
    font-weight: 900;
    margin-bottom: 6px;
}

.customer-route-details-stats strong {
    color: white;
    font-weight: 900;
}

.customer-route-detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(320px, 0.8fr);
    gap: 24px;
}

.customer-detail-flow {
    display: flex;
    overflow-x: auto;
    gap: 10px;
    padding-bottom: 8px;
}

.detail-flow-item {
    min-width: 180px;
    border-radius: 16px;
    padding: 15px;
    border: 1px solid #CBD5E1;
    flex: 0 0 auto;
}

.detail-flow-item span {
    display: block;
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
    margin-bottom: 6px;
}

.detail-flow-item strong {
    display: block;
    color: #0F172A;
    font-weight: 900;
}

.detail-flow-item small {
    display: block;
    color: #64748B;
    font-weight: 800;
    margin-top: 5px;
}

.detail-flow-item.start {
    background: #ECFDF3;
    border-color: #86EFAC;
}

.detail-flow-item.start span {
    color: #16A34A;
}

.detail-flow-item.stop {
    background: #EFF6FF;
    border-color: #93C5FD;
}

.detail-flow-item.stop span {
    color: #2563EB;
}

.detail-flow-item.end {
    background: #FEF2F2;
    border-color: #FCA5A5;
}

.detail-flow-item.end span {
    color: #DC2626;
}

.detail-flow-arrow {
    display: flex;
    align-items: center;
    color: #1E3A8A;
    font-size: 24px;
    font-weight: 900;
}

.customer-stop-list {
    display: grid;
    gap: 12px;
}

.customer-stop-row {
    display: flex;
    gap: 12px;
    align-items: center;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    padding: 13px;
}

.customer-stop-number {
    background: #1E3A8A;
    color: white;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
}

.customer-stop-row strong {
    display: block;
    color: #0F172A;
    font-weight: 900;
}

.customer-stop-row span {
    color: #64748B;
    font-size: 12px;
    font-weight: 800;
}

@media (max-width: 1100px) {
    .customer-route-layout,
    .customer-route-detail-grid {
        grid-template-columns: 1fr;
    }

    .customer-route-details-hero {
        display: block;
    }

    .customer-route-details-stats {
        min-width: 0;
        margin-top: 18px;
    }
}

@media (max-width: 800px) {
    .customer-route-hero {
        display: block;
    }

    .customer-route-hero-card {
        margin-top: 18px;
    }

    .customer-search-grid,
    .customer-route-meta,
    .customer-route-details-stats {
        grid-template-columns: 1fr;
    }

    .customer-detail-flow {
        flex-direction: column;
        overflow-x: hidden;
    }

    .detail-flow-arrow {
        transform: rotate(90deg);
        justify-content: center;
    }
}

/* Customer Details Inline Map */

.customer-inline-map-panel {
    margin-top: 26px;
    background: #F8FAFC;
    border: 1px solid #DCEEF5;
    border-radius: 20px;
    padding: 18px;
}

.customer-inline-map-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 14px;
}

.customer-inline-map-header h4 {
    color: #0F172A;
    font-size: 18px;
    font-weight: 900;
    margin: 0 0 4px;
}

.customer-inline-map-header p {
    color: #64748B;
    font-size: 13px;
    font-weight: 700;
    margin: 0;
}

.customer-inline-map-header span {
    background: #EFF6FF;
    color: #1E3A8A;
    border: 1px solid #BFDBFE;
    border-radius: 999px;
    padding: 7px 12px;
    font-size: 12px;
    font-weight: 900;
    white-space: nowrap;
}

.customer-inline-map-frame {
    height: 360px;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid #CBD5E1;
    background: white;
}

.customer-inline-map-frame .live-route-map {
    width: 100%;
    height: 100%;
    min-height: 360px;
}

.customer-inline-map-actions {
    margin-top: 14px;
}

@media (max-width: 700px) {
    .customer-inline-map-header {
        display: block;
    }

    .customer-inline-map-header span {
        display: inline-flex;
        margin-top: 10px;
    }

    .customer-inline-map-frame,
    .customer-inline-map-frame .live-route-map {
        height: 300px;
        min-height: 300px;
    }
}

/* Customer Favorite Routes */

.favorite-routes-list {
    display: grid;
    gap: 12px;
}

.favorite-route-item {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    padding: 14px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: center;
}

.favorite-route-item strong {
    display: block;
    color: #0F172A;
    font-weight: 900;
    margin-bottom: 4px;
}

.favorite-route-item span {
    color: #64748B;
    font-size: 12px;
    font-weight: 800;
}

.favorite-route-actions {
    display: flex;
    gap: 8px;
    align-items: center;
}

.favorite-view-link,
.favorite-remove-btn {
    border: 0;
    border-radius: 999px;
    padding: 7px 11px;
    font-size: 12px;
    font-weight: 900;
    text-decoration: none;
}

.favorite-view-link {
    background: #EAF2FF;
    color: #1E3A8A;
}

.favorite-remove-btn {
    background: #FEF2F2;
    color: #EF4444;
}

.favorite-route-btn.favorite-active {
    background: #F59E0B;
    color: white;
}

@media (max-width: 700px) {
    .favorite-route-item {
        display: block;
    }

    .favorite-route-actions {
        margin-top: 12px;
    }
}

/* Trip Status Board */

.trip-status-hero {
    background: linear-gradient(135deg, #0F172A, #1E3A8A);
    color: white;
    border-radius: 26px;
    padding: 28px;
    margin-bottom: 24px;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: center;
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.22);
}

.trip-status-hero h2 {
    font-size: 30px;
    font-weight: 900;
    margin: 12px 0 8px;
}

.trip-status-hero p {
    color: #CBD5E1;
    max-width: 700px;
    margin: 0;
    font-weight: 600;
}

.trip-status-pill {
    display: inline-flex;
    background: rgba(245, 158, 11, 0.16);
    color: #FBBF24;
    border: 1px solid rgba(251, 191, 36, 0.35);
    border-radius: 999px;
    padding: 7px 13px;
    font-size: 12px;
    font-weight: 900;
}

.trip-status-hero-card {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 20px;
    padding: 20px 24px;
    min-width: 150px;
    text-align: center;
}

.trip-status-hero-card strong {
    display: block;
    font-size: 34px;
    font-weight: 950;
}

.trip-status-hero-card span {
    color: #CBD5E1;
    font-size: 13px;
    font-weight: 800;
}

.trip-status-metrics {
    display: grid;
    grid-template-columns: repeat(6, minmax(120px, 1fr));
    gap: 14px;
    margin-bottom: 24px;
}

.trip-status-metric-card {
    background: white;
    border: 1px solid #E2E8F0;
    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.06);
}

.trip-status-metric-card span {
    display: block;
    color: #64748B;
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
    margin-bottom: 8px;
}

.trip-status-metric-card strong {
    color: #0F172A;
    font-size: 28px;
    font-weight: 950;
}

.trip-status-metric-card.warning {
    border-color: #FDE68A;
    background: #FFFBEB;
}

.trip-status-metric-card.success {
    border-color: #BBF7D0;
    background: #F0FDF4;
}

.trip-status-metric-card.danger {
    border-color: #FECACA;
    background: #FEF2F2;
}

.trip-status-filter-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 160px 120px;
    gap: 16px;
    align-items: end;
}

.trip-status-filter-actions {
    display: flex;
    align-items: end;
}

.trip-status-update-form {
    display: flex;
    gap: 8px;
    align-items: center;
    min-width: 230px;
}

.small-btn {
    padding: 8px 12px;
    font-size: 12px;
}

.status-pill.purple {
    background: #F3E8FF;
    color: #7E22CE;
    border: 1px solid #E9D5FF;
}

.srmss-alert {
    border-radius: 16px;
    font-weight: 800;
}

@media (max-width: 1100px) {
    .trip-status-metrics {
        grid-template-columns: repeat(3, 1fr);
    }

    .trip-status-filter-grid {
        grid-template-columns: 1fr 1fr;
    }
}

@media (max-width: 700px) {
    .trip-status-hero {
        display: block;
    }

    .trip-status-hero-card {
        margin-top: 18px;
    }

    .trip-status-metrics {
        grid-template-columns: 1fr;
    }

    .trip-status-filter-grid {
        grid-template-columns: 1fr;
    }

    .trip-status-update-form {
        display: block;
        min-width: 170px;
    }

    .trip-status-update-form button {
        width: 100%;
        margin-top: 8px;
    }
}

/* Advanced Database Favorite Routes */

.favorite-routes-list {
    display: grid;
    gap: 12px;
}

.favorite-route-item {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    padding: 14px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: center;
}

.favorite-route-item strong {
    display: block;
    color: #0F172A;
    font-weight: 900;
    margin-bottom: 4px;
}

.favorite-route-item span {
    display: block;
    color: #64748B;
    font-size: 12px;
    font-weight: 800;
}

.favorite-route-item small {
    display: block;
    color: #94A3B8;
    font-size: 11px;
    font-weight: 700;
    margin-top: 4px;
}

.favorite-route-actions {
    display: flex;
    gap: 8px;
    align-items: center;
}

.favorite-inline-form,
.favorite-remove-form {
    margin: 0;
}

.favorite-view-link,
.favorite-remove-btn {
    border: 0;
    border-radius: 999px;
    padding: 7px 11px;
    font-size: 12px;
    font-weight: 900;
    text-decoration: none;
}

.favorite-view-link {
    background: #EAF2FF;
    color: #1E3A8A;
}

.favorite-remove-btn {
    background: #FEF2F2;
    color: #EF4444;
}

.favorite-route-btn.favorite-active {
    background: #F59E0B;
    color: white;
}

.srmss-alert {
    border-radius: 16px;
    font-weight: 800;
}

@media (max-width: 700px) {
    .favorite-route-item {
        display: block;
    }

    .favorite-route-actions {
        margin-top: 12px;
    }
}

/* =========================================================
   CUSTOMER ROUTE DETAILS TOP ACTIONS
   ========================================================= */

.customer-details-top-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
}

.customer-details-action-group {
    display: flex;
    align-items: center;
    gap: 10px;
}

.customer-details-action-group form {
    margin: 0;
}

.customer-details-action-group .favorite-route-btn {
    min-width: 140px;
}

.customer-details-action-group .favorite-route-btn.favorite-active {
    background: #F59E0B;
    border-color: #F59E0B;
    color: #FFFFFF;
}


/* =========================================================
   CUSTOMER DETAILS INLINE MAP
   ========================================================= */

.customer-inline-map-panel {
    margin-top: 26px;
    background: #F8FAFC;
    border: 1px solid #DCEEF5;
    border-radius: 20px;
    padding: 18px;
}

.customer-inline-map-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 14px;
}

.customer-inline-map-header h4 {
    color: #0F172A;
    font-size: 18px;
    font-weight: 900;
    margin: 0 0 4px;
}

.customer-inline-map-header p {
    color: #64748B;
    font-size: 13px;
    font-weight: 700;
    margin: 0;
}

.customer-inline-map-header span {
    background: #EFF6FF;
    color: #1E3A8A;
    border: 1px solid #BFDBFE;
    border-radius: 999px;
    padding: 7px 12px;
    font-size: 12px;
    font-weight: 900;
    white-space: nowrap;
}

.customer-inline-map-frame {
    height: 360px;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid #CBD5E1;
    background: #FFFFFF;
}

.customer-inline-map-frame .live-route-map {
    width: 100%;
    height: 100%;
    min-height: 360px;
}

.customer-inline-map-actions {
    margin-top: 14px;
}


/* =========================================================
   DATABASE FAVORITE ROUTES
   ========================================================= */

.favorite-routes-list {
    display: grid;
    gap: 12px;
}

.favorite-route-item {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    padding: 14px;

    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: center;
}

.favorite-route-item strong {
    display: block;
    color: #0F172A;
    font-weight: 900;
    margin-bottom: 4px;
}

.favorite-route-item span {
    display: block;
    color: #64748B;
    font-size: 12px;
    font-weight: 800;
}

.favorite-route-item small {
    display: block;
    color: #94A3B8;
    font-size: 11px;
    font-weight: 700;
    margin-top: 4px;
}

.favorite-route-actions {
    display: flex;
    gap: 8px;
    align-items: center;
}

.favorite-inline-form,
.favorite-remove-form {
    margin: 0;
}

.favorite-view-link,
.favorite-remove-btn {
    border: 0;
    border-radius: 999px;
    padding: 7px 11px;
    font-size: 12px;
    font-weight: 900;
    text-decoration: none;
}

.favorite-view-link {
    background: #EAF2FF;
    color: #1E3A8A;
}

.favorite-view-link:hover {
    background: #DBEAFE;
    color: #1E3A8A;
}

.favorite-remove-btn {
    background: #FEF2F2;
    color: #EF4444;
}

.favorite-remove-btn:hover {
    background: #FEE2E2;
}

.favorite-route-btn.favorite-active {
    background: #F59E0B;
    border-color: #F59E0B;
    color: #FFFFFF;
}

.srmss-alert {
    border-radius: 16px;
    font-weight: 800;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 700px) {

    .customer-details-top-actions {
        display: block;
    }

    .customer-details-action-group {
        margin-top: 12px;
        display: grid;
        grid-template-columns: 1fr;
    }

    .customer-details-action-group .srmss-btn,
    .customer-details-action-group form,
    .customer-details-action-group button {
        width: 100%;
    }

    .customer-inline-map-header {
        display: block;
    }

    .customer-inline-map-header span {
        display: inline-flex;
        margin-top: 10px;
    }

    .customer-inline-map-frame,
    .customer-inline-map-frame .live-route-map {
        height: 300px;
        min-height: 300px;
    }

    .favorite-route-item {
        display: block;
    }

    .favorite-route-actions {
        margin-top: 12px;
    }
}
/* =========================
   Integrated navigation fixes
========================= */
.srmss-sidebar {
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.side-nav {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding-right: 4px;
    padding-bottom: 8px;
}

.side-nav::-webkit-scrollbar {
    width: 6px;
}

.side-nav::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.35);
    border-radius: 999px;
}

.side-link.logout-link {
    margin-top: 8px;
    color: #fecaca;
}

.side-link.logout-link:hover {
    background: #7f1d1d;
    color: #ffffff;
}

.sidebar-user {
    position: static;
    left: auto;
    right: auto;
    bottom: auto;
    margin-top: 18px;
    flex-shrink: 0;
}

.sidebar-user-copy {
    min-width: 0;
}

.sidebar-user-copy strong,
.sidebar-user-copy small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 145px;
}

@media (max-width: 900px) {
    .srmss-sidebar {
        overflow: visible;
    }

    .side-nav {
        overflow: visible;
        padding-right: 0;
    }
}

.trip-status-metrics {
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
}

/* =========================================================
   SRMSS MODERN SHARED SHELL
   ========================================================= */

:root {
    --shell-bg: #f4f8fc;
    --surface: #ffffff;
    --surface-soft: #f8fafc;

    --sidebar-bg: #06111f;
    --sidebar-soft: #0b1f38;

    --text-primary: #0f172a;
    --text-secondary: #64748b;
    --text-muted: #94a3b8;

    --border-color: #d8e6f3;

    --primary: #2563eb;
    --primary-soft: #dbeafe;
    --cyan: #38bdf8;

    --success: #22c55e;

    --shadow-soft:
        0 16px 40px rgba(15, 23, 42, 0.06);

    --sidebar-width: 280px;
    --sidebar-collapsed-width: 92px;

    --topbar-height: 92px;
}


html[data-theme="dark"] {
    --shell-bg: #07101d;
    --surface: #0d1929;
    --surface-soft: #111f31;

    --text-primary: #f1f5f9;
    --text-secondary: #94a3b8;
    --text-muted: #64748b;

    --border-color: #1e344d;

    --primary-soft: rgba(37, 99, 235, 0.16);

    --shadow-soft:
        0 16px 40px rgba(0, 0, 0, 0.22);
}


.srmss-body {
    margin: 0;
    background: var(--shell-bg);
    color: var(--text-primary);
    transition:
        background 0.3s ease,
        color 0.3s ease;
}


.modern-shell {
    display: grid;

    grid-template-columns:
        var(--sidebar-width)
        minmax(0, 1fr);

    min-height: 100vh;

    background: var(--shell-bg);

    transition:
        grid-template-columns 0.32s
        cubic-bezier(0.4, 0, 0.2, 1);
}


.modern-shell.sidebar-collapsed {
    grid-template-columns:
        var(--sidebar-collapsed-width)
        minmax(0, 1fr);
}


/* Sidebar */

.modern-sidebar {
    position: sticky;

    top: 0;

    height: 100vh;

    display: flex;

    flex-direction: column;

    overflow: hidden;

    background:
        radial-gradient(
            circle at 20% 10%,
            rgba(37, 99, 235, 0.20),
            transparent 28%
        ),
        linear-gradient(
            180deg,
            #06111f 0%,
            #081827 55%,
            #06111f 100%
        );

    color: white;

    border-right:
        1px solid rgba(255, 255, 255, 0.06);

    z-index: 1000;

    transition:
        width 0.3s ease,
        transform 0.3s ease;
}


.sidebar-brand {
    min-height: 92px;

    padding: 18px 20px;

    display: flex;

    align-items: center;

    gap: 13px;

    border-bottom:
        1px solid rgba(255, 255, 255, 0.08);
}


.brand-mark {
    flex: 0 0 48px;

    width: 48px;

    height: 48px;

    border-radius: 16px;

    display: grid;

    place-items: center;

    color: white;

    background:
        linear-gradient(
            135deg,
            #2563eb,
            #38bdf8
        );

    font-size: 22px;

    font-weight: 950;

    box-shadow:
        0 12px 30px
        rgba(37, 99, 235, 0.30);
}


.brand-copy {
    min-width: 0;

    display: flex;

    flex-direction: column;

    flex: 1;

    opacity: 1;

    transform: translateX(0);

    transition:
        opacity 0.2s ease,
        transform 0.3s ease;
}


.brand-copy strong {
    font-size: 20px;

    font-weight: 950;

    letter-spacing: 0.5px;
}


.brand-copy small {
    color: #94a3b8;

    font-size: 11px;

    white-space: nowrap;
}


.sidebar-collapse-btn {
    width: 31px;

    height: 31px;

    flex: 0 0 31px;

    display: grid;

    place-items: center;

    border: 1px solid
        rgba(255, 255, 255, 0.12);

    border-radius: 10px;

    background:
        rgba(255, 255, 255, 0.06);

    color: white;

    cursor: pointer;

    transition:
        background 0.2s ease,
        transform 0.3s ease;
}


.sidebar-collapse-btn:hover {
    background:
        rgba(255, 255, 255, 0.12);
}


.sidebar-system-status {
    margin: 16px 16px 5px;

    padding: 13px 14px;

    display: flex;

    align-items: center;

    gap: 11px;

    border-radius: 15px;

    background:
        rgba(255, 255, 255, 0.055);

    border:
        1px solid
        rgba(255, 255, 255, 0.07);

    overflow: hidden;

    transition:
        margin 0.3s ease,
        padding 0.3s ease;
}


.live-dot {
    flex: 0 0 9px;

    width: 9px;

    height: 9px;

    border-radius: 50%;

    background: #22c55e;

    animation:
        livePulse
        2s
        infinite;
}


@keyframes livePulse {

    0% {
        box-shadow:
            0 0 0 0
            rgba(34, 197, 94, 0.50);
    }

    70% {
        box-shadow:
            0 0 0 8px
            rgba(34, 197, 94, 0);
    }

    100% {
        box-shadow:
            0 0 0 0
            rgba(34, 197, 94, 0);
    }
}


.sidebar-system-status div {
    display: flex;

    flex-direction: column;

    min-width: 0;

    transition:
        opacity 0.2s ease;
}


.sidebar-system-status strong {
    font-size: 12px;

    font-weight: 850;

    white-space: nowrap;
}


.sidebar-system-status small {
    color: #64748b;

    font-size: 10px;

    white-space: nowrap;
}


/* Navigation */

.modern-nav {
    flex: 1;

    overflow-y: auto;

    overflow-x: hidden;

    padding: 14px 13px 20px;

    scrollbar-width: thin;

    scrollbar-color:
        rgba(255, 255, 255, 0.10)
        transparent;
}


.nav-section-label {
    color: #64748b;

    font-size: 10px;

    font-weight: 900;

    text-transform: uppercase;

    letter-spacing: 1.2px;

    padding: 13px 11px 8px;

    white-space: nowrap;

    transition:
        opacity 0.2s ease;
}


.modern-nav-link {
    position: relative;

    min-height: 48px;

    display: flex;

    align-items: center;

    gap: 12px;

    margin-bottom: 5px;

    padding: 7px 9px;

    border-radius: 14px;

    color: #94a3b8;

    text-decoration: none;

    overflow: hidden;

    transition:
        color 0.22s ease,
        background 0.22s ease,
        transform 0.22s ease;
}


.modern-nav-link:hover {
    color: white;

    background:
        rgba(255, 255, 255, 0.065);

    transform: translateX(3px);
}


.modern-nav-link.active {
    color: white;

    background:
        linear-gradient(
            90deg,
            rgba(37, 99, 235, 0.92),
            rgba(37, 99, 235, 0.52)
        );

    box-shadow:
        0 10px 28px
        rgba(37, 99, 235, 0.20);
}


.modern-nav-link.active::before {
    content: "";

    position: absolute;

    left: 0;

    top: 12px;

    bottom: 12px;

    width: 3px;

    border-radius:
        0 3px 3px 0;

    background: #7dd3fc;
}


.nav-icon {
    flex: 0 0 34px;

    width: 34px;

    height: 34px;

    display: grid;

    place-items: center;

    border-radius: 11px;

    background:
        rgba(255, 255, 255, 0.065);

    color: #cbd5e1;

    font-size: 11px;

    font-weight: 950;

    transition:
        background 0.22s ease,
        transform 0.22s ease;
}


.modern-nav-link:hover .nav-icon {
    transform: scale(1.08);
}


.modern-nav-link.active .nav-icon {
    background:
        rgba(255, 255, 255, 0.16);

    color: white;
}


.nav-text {
    white-space: nowrap;

    font-size: 13px;

    font-weight: 750;

    opacity: 1;

    transition:
        opacity 0.2s ease;
}


/* Sidebar profile */

.sidebar-profile {
    margin: 14px;

    min-height: 66px;

    padding: 10px;

    display: flex;

    align-items: center;

    gap: 10px;

    border-radius: 17px;

    background:
        rgba(255, 255, 255, 0.055);

    border:
        1px solid
        rgba(255, 255, 255, 0.07);
}


.profile-avatar {
    flex: 0 0 42px;

    width: 42px;

    height: 42px;

    display: grid;

    place-items: center;

    border-radius: 13px;

    background:
        linear-gradient(
            135deg,
            #2563eb,
            #38bdf8
        );

    color: white;

    font-size: 13px;

    font-weight: 950;
}


.profile-copy {
    min-width: 0;

    flex: 1;

    display: flex;

    flex-direction: column;

    opacity: 1;

    transition:
        opacity 0.2s ease;
}


.profile-copy strong {
    color: white;

    font-size: 12px;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;
}


.profile-copy small {
    color: #94a3b8;

    font-size: 10px;
}


.sidebar-logout {
    flex: 0 0 33px;

    width: 33px;

    height: 33px;

    display: grid;

    place-items: center;

    border-radius: 10px;

    background:
        rgba(239, 68, 68, 0.10);

    color: #fca5a5;

    text-decoration: none;

    transition:
        background 0.2s ease,
        color 0.2s ease,
        transform 0.2s ease;
}


.sidebar-logout:hover {
    background: #ef4444;

    color: white;

    transform: translateX(2px);
}


/* Collapsed sidebar */

.sidebar-collapsed
.brand-copy,

.sidebar-collapsed
.nav-text,

.sidebar-collapsed
.nav-section-label,

.sidebar-collapsed
.profile-copy,

.sidebar-collapsed
.sidebar-system-status div,

.sidebar-collapsed
.sidebar-logout {
    opacity: 0;

    width: 0;

    overflow: hidden;

    pointer-events: none;
}


.sidebar-collapsed
.sidebar-brand {
    padding-left: 22px;

    padding-right: 14px;
}


.sidebar-collapsed
.sidebar-collapse-btn {
    position: absolute;

    right: -14px;

    transform: rotate(180deg);

    background: #2563eb;

    border-color: #60a5fa;

    z-index: 20;
}


.sidebar-collapsed
.sidebar-system-status {
    margin-left: 21px;

    margin-right: 21px;

    justify-content: center;
}


.sidebar-collapsed
.modern-nav-link {
    justify-content: center;

    padding-left: 0;

    padding-right: 0;
}


.sidebar-collapsed
.nav-icon {
    flex-basis: 40px;

    width: 40px;

    height: 40px;
}


.sidebar-collapsed
.sidebar-profile {
    justify-content: center;

    margin-left: 17px;

    margin-right: 17px;
}


/* Main */

.modern-main {
    min-width: 0;

    background: var(--shell-bg);
}


/* Topbar */

.modern-topbar {
    position: sticky;

    top: 0;

    z-index: 900;

    min-height: var(--topbar-height);

    padding: 16px 26px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    background:
        color-mix(
            in srgb,
            var(--surface) 88%,
            transparent
        );

    backdrop-filter: blur(18px);

    border-bottom:
        1px solid var(--border-color);

    transition:
        background 0.3s ease,
        border-color 0.3s ease;
}


.topbar-left {
    display: flex;

    align-items: center;

    gap: 14px;

    min-width: 0;
}


.page-heading {
    min-width: 0;
}


.page-heading h2 {
    margin: 0 0 3px;

    color: var(--text-primary);

    font-size: 21px;

    font-weight: 950;
}


.page-heading p {
    margin: 0;

    color: var(--text-secondary);

    font-size: 12px;
}


.topbar-right {
    display: flex;

    align-items: center;

    gap: 10px;
}


.topbar-clock {
    text-align: right;

    padding-right: 12px;

    margin-right: 2px;

    border-right:
        1px solid var(--border-color);

    display: flex;

    flex-direction: column;
}


.clock-date {
    color: var(--text-muted);

    font-size: 10px;

    text-transform: uppercase;

    letter-spacing: 0.6px;

    font-weight: 800;
}


.clock-time {
    color: var(--text-primary);

    font-size: 13px;

    font-weight: 900;
}


.topbar-action-btn {
    position: relative;

    width: 42px;

    height: 42px;

    border: 1px solid var(--border-color);

    border-radius: 13px;

    display: grid;

    place-items: center;

    background: var(--surface);

    color: var(--text-primary);

    cursor: pointer;

    font-weight: 900;

    transition:
        transform 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        background 0.3s ease;
}


.topbar-action-btn:hover {
    transform: translateY(-2px);

    border-color: #93c5fd;

    box-shadow:
        0 10px 25px
        rgba(37, 99, 235, 0.10);
}


.notification-pulse {
    position: absolute;

    top: 7px;

    right: 7px;

    width: 7px;

    height: 7px;

    border-radius: 50%;

    background: #ef4444;

    box-shadow:
        0 0 0 0
        rgba(239, 68, 68, 0.50);

    animation:
        notificationPulse
        2s
        infinite;
}


@keyframes notificationPulse {

    70% {
        box-shadow:
            0 0 0 7px
            rgba(239, 68, 68, 0);
    }
}


.topbar-user {
    min-width: 180px;

    display: flex;

    align-items: center;

    gap: 10px;

    padding: 7px 10px;

    border-radius: 15px;

    color: var(--text-primary);

    text-decoration: none;

    border:
        1px solid transparent;

    transition:
        background 0.2s ease,
        border-color 0.2s ease;
}


.topbar-user:hover {
    background: var(--surface-soft);

    border-color: var(--border-color);

    color: var(--text-primary);
}


.topbar-avatar {
    flex: 0 0 39px;

    width: 39px;

    height: 39px;

    border-radius: 12px;

    display: grid;

    place-items: center;

    color: white;

    background:
        linear-gradient(
            135deg,
            #2563eb,
            #38bdf8
        );

    font-size: 12px;

    font-weight: 950;
}


.topbar-user-copy {
    min-width: 0;

    display: flex;

    flex-direction: column;
}


.topbar-user-copy strong {
    max-width: 125px;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;

    font-size: 12px;
}


.topbar-user-copy small {
    color: var(--text-secondary);

    font-size: 10px;
}


.mobile-menu-btn {
    display: none;

    width: 42px;

    height: 42px;

    border:
        1px solid var(--border-color);

    border-radius: 12px;

    background: var(--surface);

    color: var(--text-primary);

    font-size: 18px;

    cursor: pointer;
}


/* Page content */

.modern-page-content {
    padding: 24px;

    animation:
        contentReveal
        0.5s ease both;
}


@keyframes contentReveal {

    from {
        opacity: 0;

        transform:
            translateY(8px);
    }

    to {
        opacity: 1;

        transform:
            translateY(0);
    }
}


/* Overlay */

.mobile-overlay {
    display: none;

    position: fixed;

    inset: 0;

    background:
        rgba(2, 8, 23, 0.62);

    backdrop-filter: blur(4px);

    z-index: 990;

    opacity: 0;

    transition:
        opacity 0.25s ease;
}


.mobile-overlay.show {
    opacity: 1;
}


/* Dark mode compatibility */

html[data-theme="dark"]
.panel-card,

html[data-theme="dark"]
.kpi-card,

html[data-theme="dark"]
.profile-card,

html[data-theme="dark"]
.password-card,

html[data-theme="dark"]
.table-card,

html[data-theme="dark"]
.filter-card {

    background: var(--surface) !important;

    border-color:
        var(--border-color) !important;

    color:
        var(--text-primary) !important;
}


html[data-theme="dark"]
.panel-header h2,

html[data-theme="dark"]
.kpi-number,

html[data-theme="dark"]
.page-heading h2 {

    color:
        var(--text-primary) !important;
}


html[data-theme="dark"]
.activity-item,

html[data-theme="dark"]
.quick-action {

    background:
        var(--surface-soft) !important;

    border-color:
        var(--border-color) !important;
}


/* Responsive */

@media (max-width: 900px) {

    .modern-shell,
    .modern-shell.sidebar-collapsed {
        display: block;
    }


    .modern-sidebar {
        position: fixed;

        left: 0;

        top: 0;

        width: min(300px, 86vw);

        transform:
            translateX(-105%);

        box-shadow:
            30px 0 70px
            rgba(0, 0, 0, 0.28);
    }


    .modern-sidebar.mobile-open {
        transform:
            translateX(0);
    }


    .sidebar-collapse-btn {
        display: none;
    }


    .mobile-overlay {
        display: block;

        pointer-events: none;
    }


    .mobile-overlay.show {
        pointer-events: auto;
    }


    .mobile-menu-btn {
        display: grid;

        place-items: center;
    }


    .modern-topbar {
        padding:
            13px 16px;
    }


    .modern-page-content {
        padding:
            16px;
    }


    .topbar-clock {
        display: none;
    }


    .topbar-user-copy {
        display: none;
    }


    .topbar-user {
        min-width: auto;

        padding:
            4px;
    }


    body.menu-open {
        overflow: hidden;
    }
}


@media (max-width: 600px) {

    .page-heading p {
        display: none;
    }


    .page-heading h2 {
        font-size: 17px;
    }


    .topbar-right {
        gap: 6px;
    }


    .topbar-action-btn {
        width: 38px;

        height: 38px;
    }


    .topbar-user {
        display: none;
    }
}
/* =========================================================
   SRMSS ENTERPRISE ICON AND LOGO REFINEMENTS
   ========================================================= */

.brand-mark.brand-mark-logo {
    padding: 4px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.20);
    box-shadow: 0 12px 30px rgba(37, 99, 235, 0.20);
}

.brand-mark.brand-mark-logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 11px;
}

.nav-icon svg,
.sidebar-logout svg,
.mobile-menu-btn svg,
.topbar-action-btn svg {
    width: 19px;
    height: 19px;
    display: block;
}

.sidebar-logout svg {
    width: 17px;
    height: 17px;
}

.mobile-menu-btn svg {
    width: 21px;
    height: 21px;
}

.topbar-action-btn span {
    display: grid;
    place-items: center;
}

.sidebar-collapsed .brand-mark.brand-mark-logo {
    flex-basis: 48px;
}


/* =========================
   Enterprise Fleet, Reports and Communication Modules
========================= */
.module-hero {
    border-radius: 28px;
    padding: 30px;
    margin-bottom: 26px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    background:
        radial-gradient(circle at top right, rgba(37, 99, 235, 0.25), transparent 38%),
        linear-gradient(135deg, #0f172a, #12356d 55%, #07111f);
    color: #ffffff;
    box-shadow: 0 22px 55px rgba(15, 23, 42, 0.18);
    overflow: hidden;
    position: relative;
}

.module-hero::after {
    content: "";
    position: absolute;
    width: 180px;
    height: 180px;
    right: -50px;
    bottom: -70px;
    border-radius: 50%;
    border: 28px solid rgba(255, 255, 255, 0.08);
}

.module-hero h2 {
    margin: 8px 0 8px;
    font-size: 34px;
    font-weight: 900;
    letter-spacing: -0.04em;
}

.module-hero p {
    margin: 0;
    max-width: 680px;
    color: rgba(255, 255, 255, 0.76);
    line-height: 1.65;
}

.module-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.13);
    color: #dbeafe;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

.vehicle-hero {
    background:
        radial-gradient(circle at top right, rgba(34, 197, 94, 0.22), transparent 38%),
        linear-gradient(135deg, #0f172a, #14532d 58%, #07111f);
}

.fuel-hero {
    background:
        radial-gradient(circle at top right, rgba(245, 158, 11, 0.24), transparent 38%),
        linear-gradient(135deg, #0f172a, #7c2d12 58%, #07111f);
}

.maintenance-hero {
    background:
        radial-gradient(circle at top right, rgba(239, 68, 68, 0.2), transparent 38%),
        linear-gradient(135deg, #0f172a, #581c87 58%, #07111f);
}

.feedback-hero {
    background:
        radial-gradient(circle at top right, rgba(20, 184, 166, 0.23), transparent 38%),
        linear-gradient(135deg, #0f172a, #134e4a 58%, #07111f);
}

.announcement-hero {
    background:
        radial-gradient(circle at top right, rgba(59, 130, 246, 0.24), transparent 38%),
        linear-gradient(135deg, #0f172a, #1e3a8a 58%, #07111f);
}

.report-hero {
    background:
        radial-gradient(circle at top right, rgba(168, 85, 247, 0.23), transparent 38%),
        linear-gradient(135deg, #0f172a, #312e81 58%, #07111f);
}

.enterprise-filter-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(150px, 1fr));
    gap: 18px;
    align-items: end;
}

.enterprise-form-card {
    max-width: 1120px;
}

.enterprise-form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(240px, 1fr));
    gap: 18px;
}

.enterprise-form-wide {
    grid-column: 1 / -1;
}

.enterprise-form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 24px;
    flex-wrap: wrap;
}

.enterprise-detail-grid,
.analytics-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
}

.detail-list {
    display: grid;
    gap: 14px;
}

.detail-list div {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
}

.detail-list span {
    color: #64748b;
    font-size: 13px;
    font-weight: 700;
}

.detail-list strong {
    color: #0f172a;
    text-align: right;
}

.table-muted {
    opacity: 0.62;
}

.inline-action-form {
    display: inline;
}

.button-link {
    border: 0;
    background: transparent;
    padding: 0;
    cursor: pointer;
}

.srmss-btn.danger {
    background: #dc2626;
    color: #fff;
}

.danger-panel {
    border-color: rgba(239, 68, 68, 0.25);
}

.danger-panel::before {
    background: #ef4444;
}

.feedback-grid,
.announcement-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
}

.feedback-card-top,
.announcement-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 12px;
}

.feedback-card h3,
.announcement-card h3 {
    margin: 6px 0 10px;
    font-size: 21px;
    font-weight: 850;
}

.feedback-card p,
.announcement-card p,
.announcement-detail-card p {
    color: #475569;
    line-height: 1.7;
}

.feedback-meta,
.announcement-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    color: #64748b;
    font-size: 13px;
    font-weight: 700;
}

.feedback-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid rgba(148, 163, 184, 0.18);
}

.feedback-message-box {
    margin-top: 16px;
    padding: 16px;
    border-radius: 16px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    color: #334155;
    line-height: 1.7;
}

.report-chart-card {
    min-height: 360px;
}

.report-chart-card canvas {
    width: 100% !important;
    height: 280px !important;
}

.report-chart-card.wide canvas {
    height: 320px !important;
}

body.srmss-dark .detail-list strong,
body.dark-mode .detail-list strong {
    color: #e5e7eb;
}

body.srmss-dark .feedback-message-box,
body.dark-mode .feedback-message-box {
    background: rgba(15, 23, 42, 0.65);
    border-color: rgba(148, 163, 184, 0.22);
    color: #cbd5e1;
}

@media (max-width: 1100px) {
    .enterprise-filter-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .enterprise-detail-grid,
    .analytics-grid,
    .feedback-grid,
    .announcement-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 680px) {
    .module-hero {
        align-items: flex-start;
        flex-direction: column;
        padding: 24px;
    }

    .module-hero h2 {
        font-size: 26px;
    }

    .enterprise-filter-grid,
    .enterprise-form-grid {
        grid-template-columns: 1fr;
    }

    .enterprise-form-actions {
        justify-content: stretch;
    }

    .enterprise-form-actions .srmss-btn {
        width: 100%;
        justify-content: center;
    }
}

/* =========================================================
   SRMSS TOPBAR NOTIFICATION DROPDOWN - FINAL FIX
   Checkbox based. No Bootstrap dropdown JS and no custom JS needed.
   ========================================================= */

.srmss-native-notification {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    isolation: isolate;
}

.srmss-notification-switch {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
}

.srmss-notification-toggle {
    margin: 0;
    user-select: none;
    -webkit-user-select: none;
}

.srmss-notification-panel {
    position: fixed;
    top: 82px;
    right: 28px;
    width: 370px;
    max-width: calc(100vw - 32px);
    padding: 14px;
    background: var(--surface, #ffffff);
    border: 1px solid rgba(148, 163, 184, 0.30);
    border-radius: 22px;
    box-shadow: 0 28px 80px rgba(15, 23, 42, 0.24);
    z-index: 999999;
    display: none;
}

.srmss-notification-switch:checked ~ .srmss-notification-panel {
    display: block;
    animation: srmssNotificationDrop 0.18s ease both;
}

@keyframes srmssNotificationDrop {
    from {
        opacity: 0;
        transform: translateY(-8px) scale(0.98);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.srmss-notification-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    text-decoration: none;
    padding: 12px 10px;
    border-radius: 16px;
    transition: all 0.18s ease;
}

.srmss-notification-item:hover {
    background: rgba(37, 99, 235, 0.08);
    transform: translateX(2px);
}

.srmss-notification-item strong {
    display: block;
    color: var(--text-primary, #0f172a);
    font-size: 0.86rem;
    line-height: 1.25;
}

.srmss-notification-item small {
    display: block;
    color: var(--text-secondary, #64748b);
    font-size: 0.75rem;
    margin-top: 3px;
    line-height: 1.35;
}

.notification-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 10px 10px 14px;
    border-bottom: 1px solid rgba(148, 163, 184, 0.22);
    margin-bottom: 8px;
}

.notification-panel-header strong {
    display: block;
    font-size: 0.95rem;
    color: var(--text-primary, #0f172a);
}

.notification-panel-header small {
    display: block;
    font-size: 0.78rem;
    color: var(--text-secondary, #64748b);
    margin-top: 2px;
}

.notification-count {
    min-width: 28px;
    height: 28px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(37, 99, 235, 0.12);
    color: #2563eb;
    font-weight: 800;
    font-size: 0.8rem;
}

.notification-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-top: 5px;
    flex: 0 0 auto;
}

.notification-dot.info {
    background: #2563eb;
    box-shadow: 0 0 0 5px rgba(37, 99, 235, 0.12);
}

.notification-dot.warning {
    background: #f59e0b;
    box-shadow: 0 0 0 5px rgba(245, 158, 11, 0.14);
}

.notification-dot.success {
    background: #10b981;
    box-shadow: 0 0 0 5px rgba(16, 185, 129, 0.14);
}

.notification-panel-footer {
    padding: 10px 10px 4px;
    border-top: 1px solid rgba(148, 163, 184, 0.22);
    margin-top: 8px;
    text-align: center;
}

.notification-panel-footer a {
    color: #2563eb;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
}

.notification-panel-footer a:hover {
    text-decoration: underline;
}

[data-theme="dark"] .srmss-notification-panel {
    background: #111827;
    border-color: rgba(148, 163, 184, 0.22);
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.48);
}

[data-theme="dark"] .notification-panel-header strong,
[data-theme="dark"] .srmss-notification-item strong {
    color: #f8fafc;
}

[data-theme="dark"] .notification-panel-header small,
[data-theme="dark"] .srmss-notification-item small {
    color: #94a3b8;
}

[data-theme="dark"] .srmss-notification-item:hover {
    background: rgba(59, 130, 246, 0.14);
}

@media (max-width: 576px) {
    .srmss-notification-panel {
        top: 72px;
        right: 14px;
        width: 320px;
    }
}


/* =========================
   FINAL TOPBAR SINGLE NOTIFICATION FIX
   Keeps only #topbarNotificationButton visible in the topbar.
========================= */

.modern-topbar {
    position: relative !important;
    z-index: 1000 !important;
    overflow: visible !important;
}

.topbar-right {
    position: relative !important;
    z-index: 1001 !important;
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
    overflow: visible !important;
    pointer-events: auto !important;
}

.topbar-right .topbar-notification-form {
    display: none !important;
}

.topbar-right .notification-btn:not(#topbarNotificationButton) {
    display: none !important;
}

#topbarNotificationButton {
    display: grid !important;
    place-items: center !important;
    position: relative !important;
    z-index: 1002 !important;
    width: 42px !important;
    height: 42px !important;
    pointer-events: auto !important;
    cursor: pointer !important;
    text-decoration: none !important;
}

#topbarNotificationButton span,
#topbarNotificationButton svg,
#topbarNotificationButton .notification-pulse {
    pointer-events: none !important;
}

#topbarNotificationButton:hover {
    color: var(--text-primary) !important;
}

/* =========================
   CUSTOMER TIMETABLE AND LIVE STATUS
========================= */

.customer-page-shell {
    display: grid;
    gap: 24px;
}

.customer-hero.compact {
    min-height: 220px;
    border-radius: 28px;
    padding: 38px;
    background:
        radial-gradient(circle at top right, rgba(96, 165, 250, 0.28), transparent 32%),
        linear-gradient(135deg, #07172d, #1e3a8a);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    overflow: hidden;
    position: relative;
}

.customer-hero.compact.live {
    background:
        radial-gradient(circle at top right, rgba(34, 197, 94, 0.22), transparent 32%),
        linear-gradient(135deg, #07172d, #164e63);
}

.hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.13);
    border-radius: 999px;
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.12em;
    margin-bottom: 16px;
}

.customer-hero h1 {
    font-size: clamp(32px, 4vw, 54px);
    font-weight: 950;
    margin: 0 0 10px;
}

.customer-hero p {
    margin: 0;
    color: rgba(255, 255, 255, 0.78);
    max-width: 760px;
    font-size: 16px;
    line-height: 1.7;
}

.hero-action-btn {
    background: #ffffff;
    color: #1e3a8a;
    border-radius: 18px;
    padding: 14px 22px;
    font-weight: 900;
    white-space: nowrap;
    text-decoration: none;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.2);
}

.hero-action-btn:hover {
    color: #1e3a8a;
    transform: translateY(-2px);
}

.customer-filter-card {
    border-left: 7px solid #2563eb;
}

.customer-filter-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(220px, 0.6fr) minmax(170px, 0.45fr) minmax(150px, 0.4fr);
    gap: 18px;
    align-items: end;
}

.customer-schedule-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
}

.customer-schedule-card {
    background: #ffffff;
    border: 1px solid rgba(148, 163, 184, 0.24);
    border-radius: 24px;
    padding: 26px;
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
    position: relative;
    overflow: hidden;
}

.customer-schedule-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 24px;
    bottom: 24px;
    width: 6px;
    border-radius: 999px;
    background: #2563eb;
}

.schedule-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 16px;
}

.schedule-card-top strong {
    color: #64748b;
    font-size: 13px;
}

.customer-schedule-card h3 {
    font-size: 22px;
    font-weight: 950;
    color: #0f172a;
    margin-bottom: 8px;
}

.customer-schedule-card p {
    color: #64748b;
    font-weight: 700;
    margin-bottom: 20px;
}

.schedule-time-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 20px;
}

.schedule-time-row div {
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    padding: 16px;
}

.schedule-time-row span {
    display: block;
    color: #64748b;
    font-size: 12px;
    font-weight: 800;
    margin-bottom: 4px;
}

.schedule-time-row strong {
    color: #0f172a;
    font-size: 24px;
    font-weight: 950;
}

.schedule-details-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #eaf2ff;
    color: #1e3a8a;
    border-radius: 999px;
    padding: 10px 16px;
    font-weight: 900;
    text-decoration: none;
}

.schedule-details-link:hover {
    background: #1e3a8a;
    color: #ffffff;
}

.customer-status-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.status-filter-link {
    background: #ffffff;
    border: 1px solid rgba(148, 163, 184, 0.28);
    color: #475569;
    border-radius: 999px;
    padding: 10px 16px;
    font-weight: 900;
    text-decoration: none;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
}

.status-filter-link.active,
.status-filter-link:hover {
    background: #1e3a8a;
    color: #ffffff;
}

.empty-customer-state {
    grid-column: 1 / -1;
    background: #ffffff;
    border: 2px dashed #cbd5e1;
    border-radius: 24px;
    padding: 46px 30px;
    text-align: center;
    color: #64748b;
}

.empty-customer-state h3 {
    color: #0f172a;
    font-weight: 950;
}

@media (max-width: 1100px) {
    .customer-filter-grid,
    .customer-schedule-grid {
        grid-template-columns: 1fr;
    }

    .customer-hero.compact {
        align-items: flex-start;
        flex-direction: column;
    }
}

@media (max-width: 576px) {
    .customer-hero.compact {
        padding: 28px;
        border-radius: 22px;
    }

    .schedule-time-row {
        grid-template-columns: 1fr;
    }
}
