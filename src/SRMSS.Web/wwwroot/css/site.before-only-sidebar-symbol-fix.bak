    font-weight: 900;
    margin-bottom: 14px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.route-flow-wrapper {
    display: flex;
    align-items: stretch;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 6px;
}

.route-flow-item {
    min-width: 160px;
    border-radius: 16px;
    padding: 14px;
    border: 1px solid #CBD5E1;
}

.route-flow-item span {
    display: block;
    font-size: 11px;
    font-weight: 900;
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
}

.route-flow-item strong {
    display: block;
    font-size: 13px;
