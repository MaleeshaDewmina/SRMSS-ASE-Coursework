    margin-right: 10px;
    transition: 0.2s ease;
}

.map-route-link:hover {
    background: var(--success-green);
    color: white;
}

@media (max-width: 700px) {
    .route-map-info {
        grid-template-columns: 1fr;
    }

    .route-map-header {
        display: block;
    }

    .route-map-header .status-pill {
        margin-top: 12px;
    }

    .route-map-frame,
    .live-route-map {
        height: 320px;
        min-height: 320px;
    }
}

/* Clear Start, Stop and End Map Markers */

.custom-route-marker {
    background: transparent;
    border: none;
}

.route-marker {
    width: 34px;
