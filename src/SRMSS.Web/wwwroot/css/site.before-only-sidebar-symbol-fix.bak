    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 900;
    border: 3px solid white;
    box-shadow: 0 8px 18px rgba(15, 23, 42, 0.35);
}

.route-marker.start {
    background: #22C55E;
}

.route-marker.stop {
    background: #2563EB;
}

.route-marker.end {
    background: #EF4444;
}

.route-marker-tooltip {
    background: white;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 999px;
    padding: 5px 10px;
    font-size: 11px;
    font-weight: 900;
