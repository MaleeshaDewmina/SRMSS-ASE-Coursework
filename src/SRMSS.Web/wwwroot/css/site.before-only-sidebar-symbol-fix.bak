/* Online Map Route Preview With Stops */

.route-map-preview-wrapper {
    background: #F8FAFC;
    border: 1px solid #DCEEF5;
    border-radius: 20px;
    padding: 18px;
    min-height: 650px;
}

.route-map-card {
    display: grid;
    gap: 18px;
}

.route-map-header {
    background: white;
    border: 1px solid var(--border-soft);
    border-radius: 18px;
    padding: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
}

.route-map-header strong {
    color: var(--text-dark);
    font-weight: 900;
    font-size: 17px;
}

.route-map-header p {
    color: #64748B;
    font-weight: 700;
    margin: 4px 0 0;
}

.route-map-frame {
    height: 390px;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid #CBD5E1;
    background: white;
}

.live-route-map {
    width: 100%;
    height: 100%;
    min-height: 390px;
}

.map-loading-message,
.map-error-message {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #F8FAFC;
    color: #64748B;
    font-weight: 800;
    text-align: center;
    padding: 20px;
}

.route-map-info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
}

.route-map-info div {
    background: white;
    border: 1px solid var(--border-soft);
    border-radius: 16px;
    padding: 15px;
}

.route-map-info span {
    display: block;
    color: #64748B;
    font-weight: 800;
    font-size: 12px;
    margin-bottom: 5px;
}

.route-map-info strong {
    color: var(--text-dark);
    font-weight: 900;
}

.route-map-stops {
    background: white;
    border: 1px solid var(--border-soft);
    border-radius: 16px;
    padding: 15px;
}

.route-map-stops-title {
