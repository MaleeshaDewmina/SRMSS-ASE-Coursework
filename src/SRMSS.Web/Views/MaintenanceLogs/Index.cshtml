@model IEnumerable<SRMSS.Web.Models.MaintenanceLog>

@{
    var vehicleOptions = ViewData["VehicleId"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    string fromDateValue = ViewBag.FromDate is DateTime fd ? fd.ToString("yyyy-MM-dd") : string.Empty;
    string toDateValue = ViewBag.ToDate is DateTime td ? td.ToString("yyyy-MM-dd") : string.Empty;
    ViewData["Title"] = "Maintenance Management";
    ViewData["PageTitle"] = "Maintenance Management";
    ViewData["PageSubtitle"] = "Track services, repair history, maintenance cost and upcoming service deadlines.";

    string currentRole = Context.Session.GetString(SessionKeys.Role) ?? string.Empty;
    bool canDelete = currentRole == "SuperAdmin" || currentRole == "Admin";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success srmss-alert">@TempData["SuccessMessage"]</div>
}

<div class="module-hero maintenance-hero">
    <div>
        <span class="module-kicker">Fleet Health</span>
        <h2>Maintenance Operations Center</h2>
        <p>Control services, repairs, next service dates and cost visibility for every active fleet asset.</p>
    </div>
    <a asp-action="Create" class="srmss-btn primary">+ Add Maintenance</a>
</div>

<div class="metric-grid">
    <div class="metric-card"><div class="metric-icon">M</div><div><p>Total Records</p><h3>@ViewBag.TotalMaintenance</h3></div></div>
    <div class="metric-card"><div class="metric-icon amber">Rs</div><div><p>Monthly Cost</p><h3>@(((decimal)ViewBag.MonthlyMaintenanceCost).ToString("N0"))</h3></div></div>
    <div class="metric-card"><div class="metric-icon blue">30</div><div><p>Upcoming</p><h3>@ViewBag.UpcomingServices</h3></div></div>
    <div class="metric-card"><div class="metric-icon red">!</div><div><p>Overdue</p><h3>@ViewBag.OverdueServices</h3></div></div>
</div>

<div class="srmss-card mb-4">
    <h3 class="card-title">Search and Filter Maintenance Logs</h3>
    <form method="get" class="enterprise-filter-grid">
        <div>
            <label class="form-label">Vehicle</label>
            <select name="vehicleId" class="form-select">
                <option value="">All Vehicles</option>
                @foreach (var option in vehicleOptions)
                {
                    <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">Status</label>
            <select name="status" class="form-select">
                <option value="">All Status</option>
                <option value="Scheduled" selected="@(ViewBag.Status == "Scheduled")">Scheduled</option>
                <option value="In Progress" selected="@(ViewBag.Status == "In Progress")">In Progress</option>
                <option value="Completed" selected="@(ViewBag.Status == "Completed")">Completed</option>
                <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option>
            </select>
        </div>
        <div>
            <label class="form-label">Type</label>
            <input name="type" value="@ViewBag.Type" class="form-control" placeholder="Engine, brake, tyre..." />
        </div>
        <div>
            <label class="form-label">From</label>
            <input name="fromDate" value="@fromDateValue" type="date" class="form-control" />
        </div>
        <div>
            <label class="form-label">To</label>
            <input name="toDate" value="@toDateValue" type="date" class="form-control" />
        </div>
        <div class="filter-button-area"><button type="submit" class="srmss-btn primary w-100">Apply</button></div>
        <div class="filter-button-area"><a asp-action="Index" class="srmss-btn secondary w-100">Clear</a></div>
    </form>
</div>

<div class="srmss-card">
    <h3 class="card-title">Maintenance Records</h3>
    <div class="table-responsive">
        <table class="srmss-table enterprise-table">
            <thead><tr><th>Date</th><th>Vehicle</th><th>Type</th><th>Status</th><th>Cost</th><th>Next Service</th><th>Performed By</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var log in Model)
                    {
                        string statusClass = log.Status == "Completed" ? "green" : log.Status == "In Progress" ? "amber" : log.Status == "Cancelled" ? "red" : "blue";
                        bool overdue = log.NextServiceDate != null && log.NextServiceDate < DateTime.Today;
                        <tr>
                            <td>@log.MaintenanceDate.ToString("dd MMM yyyy")</td>
                            <td><strong>@(log.Vehicle?.RegistrationNumber ?? "Unknown")</strong><small class="d-block text-muted">@(log.Vehicle?.VehicleType ?? "")</small></td>
                            <td>@log.MaintenanceType</td>
                            <td><span class="status-pill @statusClass">@log.Status</span></td>
                            <td>Rs. @log.Cost.ToString("N2")</td>
                            <td class="@(overdue ? "text-danger fw-bold" : "")">@(log.NextServiceDate?.ToString("dd MMM yyyy") ?? "Not set")</td>
                            <td>@(log.PerformedBy ?? "Not recorded")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@log.Id" class="action-link">Details</a>
                                <a asp-action="Edit" asp-route-id="@log.Id" class="action-link">Edit</a>
                                @if (canDelete)
                                {
                                    <a asp-action="Delete" asp-route-id="@log.Id" class="action-link danger">Delete</a>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No maintenance records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

