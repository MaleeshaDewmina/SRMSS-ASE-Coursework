@model SRMSS.Web.Models.MaintenanceLog

@{
    ViewData["Title"] = "Maintenance Details";
    ViewData["PageTitle"] = "Maintenance Details";
    ViewData["PageSubtitle"] = "Detailed maintenance record, cost and follow-up service plan.";
}

<div class="module-hero maintenance-hero mb-4">
    <div>
        <span class="module-kicker">Maintenance Record</span>
        <h2>@Model.MaintenanceType</h2>
        <p>@(Model.Vehicle?.RegistrationNumber ?? "Vehicle") | @Model.MaintenanceDate.ToString("dd MMM yyyy") | @Model.Status</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Index" class="srmss-btn secondary">Back</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="srmss-btn primary">Edit</a>
    </div>
</div>

<div class="enterprise-detail-grid">
    <div class="srmss-card">
        <h3 class="card-title">Service Details</h3>
        <div class="detail-list">
            <div><span>Vehicle</span><strong>@(Model.Vehicle?.RegistrationNumber ?? "Unknown")</strong></div>
            <div><span>Date</span><strong>@Model.MaintenanceDate.ToString("dd MMM yyyy")</strong></div>
            <div><span>Type</span><strong>@Model.MaintenanceType</strong></div>
            <div><span>Status</span><strong>@Model.Status</strong></div>
            <div><span>Performed By</span><strong>@(Model.PerformedBy ?? "Not recorded")</strong></div>
        </div>
    </div>
    <div class="srmss-card amber">
        <h3 class="card-title">Cost and Follow-up</h3>
        <div class="detail-list">
            <div><span>Cost</span><strong>Rs. @Model.Cost.ToString("N2")</strong></div>
            <div><span>Odometer</span><strong>@(Model.OdometerReading?.ToString("N0") ?? "Not recorded")</strong></div>
            <div><span>Next Service</span><strong>@(Model.NextServiceDate?.ToString("dd MMM yyyy") ?? "Not set")</strong></div>
            <div><span>Recorded At</span><strong>@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</strong></div>
        </div>
    </div>
</div>

<div class="srmss-card mt-4">
    <h3 class="card-title">Description</h3>
    <p class="card-subtitle">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description recorded." : Model.Description)</p>
</div>


