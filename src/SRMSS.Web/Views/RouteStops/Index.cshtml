@using System.Text.Json
@model IEnumerable<SRMSS.Web.Models.TransportRoute>

@{
    ViewData["Title"] = "Route Stops";
    ViewData["PageTitle"] = "Route Stops";
    ViewData["PageSubtitle"] = "View each route and manage its ordered stop flow.";

    var totalRoutes = Model.Count();
    var totalStops = Model.Sum(r => r.RouteStops.Count);
    var routesWithStops = Model.Count(r => r.RouteStops.Any());
    var routesWithoutStops = Model.Count(r => !r.RouteStops.Any());

    var routeGroups = Model
        .Select(r => new
        {
            routeId = r.Id,
            routeName = r.RouteName,
            startPoint = r.StartPoint,
            endPoint = r.EndPoint,
            serviceType = r.ServiceType,
            status = r.Status,
            stopCount = r.RouteStops.Count,
            latestStopId = r.RouteStops.Any() ? r.RouteStops.Max(s => s.Id) : 0,
            stops = r.RouteStops
                .OrderBy(s => s.StopOrder)
                .Select(s => new
                {
                    stopId = s.Id,
                    stopOrder = s.StopOrder,
                    stopName = s.StopName,
                    estimatedMinutes = s.EstimatedMinutesFromStart
                })
                .ToList()
        })
        .OrderByDescending(r => r.latestStopId)
        .ThenBy(r => r.routeName)
        .ToList();

    var routeGroupsJson = JsonSerializer.Serialize(
        routeGroups,
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        }
    );
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success srmss-alert">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger srmss-alert">@TempData["ErrorMessage"]</div>
}

<div class="d-flex justify-content-end mb-4">
    <a asp-action="Create" class="srmss-btn primary">
        + Add Route Stop
    </a>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-icon">R</div>
        <div>
            <p>Total Routes</p>
            <h3>@totalRoutes</h3>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon green">St</div>
        <div>
            <p>Total Stops</p>
            <h3>@totalStops</h3>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon amber">A</div>
        <div>
            <p>Routes With Stops</p>
            <h3>@routesWithStops</h3>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon red">N</div>
        <div>
            <p>Without Stops</p>
            <h3>@routesWithoutStops</h3>
        </div>
    </div>
</div>

<div class="srmss-card mb-4">
    <h3 class="card-title">Search Routes</h3>
    <p class="card-subtitle">
        Search by route name, start point, end point, service type or stop name.
    </p>

    <div class="route-stop-filter-grid">
        <div>
            <label class="form-label">Search Route</label>
            <input id="routeSearchInput"
                   class="form-control"
                   placeholder="Example: Colombo, Badulla, Galle, Kalutara..." />
        </div>

        <div>
            <label class="form-label">Filter By Status</label>
            <select id="statusFilterSelect" class="form-select">
                <option value="">All Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
        </div>

        <div class="filter-button-area">
            <button type="button" id="clearRouteFilterBtn" class="srmss-btn secondary w-100">
                Clear Filter
            </button>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="srmss-card">
            <h3 class="card-title">Route List</h3>
            <p class="card-subtitle">
                Recently updated routes appear first. Click View Stops to see the full stop flow.
            </p>

            <div class="table-responsive">
                <table class="srmss-table">
                    <thead>
                        <tr>
                            <th>Route</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Stops</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody id="routeTableBody">
                        @if (routeGroups.Any())
                        {
                            foreach (var route in routeGroups)
                            {
                                var stopNames = string.Join(" ", route.stops.Select(s => s.stopName));
                                var searchText = $"{route.routeName} {route.startPoint} {route.endPoint} {route.serviceType} {route.status} {stopNames}".ToLower();

                                <tr class="route-list-row"
                                    data-route-id="@route.routeId"
                                    data-status="@route.status.ToLower()"
                                    data-search="@searchText">
                                    <td class="fw-bold">@route.routeName</td>
                                    <td>@route.startPoint</td>
                                    <td>@route.endPoint</td>
                                    <td>@route.serviceType</td>
                                    <td>
                                        @if (route.status == "Active")
                                        {
                                            <span class="status-pill green">Active</span>
                                        }
                                        else
                                        {
                                            <span class="status-pill red">@route.status</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="status-pill blue">@route.stopCount</span>
                                    </td>
                                    <td class="text-end">
                                        <button type="button"
                                                class="view-stops-btn"
                                                data-route-id="@route.routeId">
                                            View Stops
                                        </button>

                                        <a asp-action="Create" class="action-link">Add Stop</a>
                                        <a asp-controller="TransportRoutes" asp-action="Edit" asp-route-id="@route.routeId" class="action-link">Edit Route</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    No routes have been added yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="noRouteResults" class="no-stop-results d-none">
                No matching routes found.
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="srmss-card amber h-100" id="routeDetailsPanel">
            <h3 class="card-title">Route Stop Details</h3>
            <p class="card-subtitle" id="selectedRouteSubtitle">
                Select a route to view all stops clearly.
            </p>

            <div id="selectedRouteDetails" class="selected-route-details">
                <div class="empty-stop-panel">
                    <div class="empty-stop-icon">i</div>
                    <h4>No route selected</h4>
                    <p>Click View Stops from the table to preview the full stop flow.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const routes = @Html.Raw(routeGroupsJson);

            const searchInput = document.getElementById("routeSearchInput");
            const statusFilter = document.getElementById("statusFilterSelect");
            const clearBtn = document.getElementById("clearRouteFilterBtn");
            const rows = document.querySelectorAll(".route-list-row");
            const noResults = document.getElementById("noRouteResults");

            const selectedRouteSubtitle = document.getElementById("selectedRouteSubtitle");
            const selectedRouteDetails = document.getElementById("selectedRouteDetails");
            const routeDetailsPanel = document.getElementById("routeDetailsPanel");

            function filterRoutes() {
                const searchValue = searchInput.value.toLowerCase().trim();
                const selectedStatus = statusFilter.value;

                let visibleCount = 0;

                rows.forEach(function (row) {
                    const rowSearch = row.getAttribute("data-search");
                    const rowStatus = row.getAttribute("data-status");

                    const matchesSearch = rowSearch.includes(searchValue);
                    const matchesStatus = selectedStatus === "" || rowStatus === selectedStatus;

                    if (matchesSearch && matchesStatus) {
                        row.style.display = "";
                        visibleCount++;
                    } else {
                        row.style.display = "none";
                    }
                });

                if (visibleCount === 0 && rows.length > 0) {
                    noResults.classList.remove("d-none");
                } else {
                    noResults.classList.add("d-none");
                }
            }

            function showRouteDetails(routeId, shouldScroll) {
                const route = routes.find(r => r.routeId === routeId);

                if (!route) {
                    selectedRouteSubtitle.textContent = "Route details not found.";
                    selectedRouteDetails.innerHTML = `
                        <div class="empty-stop-panel">
                            <div class="empty-stop-icon">!</div>
                            <h4>No details</h4>
                            <p>This route does not have stop details.</p>
                        </div>
                    `;
                    return;
                }

                selectedRouteSubtitle.textContent =
                    `${route.routeName} | ${route.startPoint} → ${route.endPoint}`;

                let html = `
                    <div class="route-detail-mini-summary">
                        <div>
                            <span>Service Type</span>
                            <strong>${route.serviceType}</strong>
                        </div>
                        <div>
                            <span>Total Stops</span>
                            <strong>${route.stopCount}</strong>
                        </div>
                    </div>
                `;

                if (route.stops.length === 0) {
                    html += `
                        <div class="empty-stop-panel mt-4">
                            <div class="empty-stop-icon">+</div>
                            <h4>No stops added</h4>
                            <p>This route has no intermediary stops yet.</p>
                        </div>
                    `;
                } else {
                    html += `<div class="detailed-stop-flow">`;

                    route.stops.forEach(function (stop, index) {
                        const activeClass = index === 0 ? "active" : "";

                        html += `
                            <div class="detailed-stop-item ${activeClass}">
                                <div class="detailed-stop-dot">${stop.stopOrder}</div>
                                <div class="detailed-stop-content">
                                    <strong>${stop.stopName}</strong>
                                    <small>${stop.estimatedMinutes} mins from start</small>

                                    <div class="stop-action-links">
                                        <a href="/RouteStops/Edit/${stop.stopId}">Edit</a>
                                        <a href="/RouteStops/Details/${stop.stopId}">Details</a>
                                        <a class="danger" href="/RouteStops/Delete/${stop.stopId}">Delete</a>
                                    </div>
                                </div>
                            </div>
                        `;
                    });

                    html += `</div>`;
                }

                selectedRouteDetails.innerHTML = html;

                document.querySelectorAll(".view-stops-btn").forEach(btn => {
                    btn.classList.remove("active");
                });

                document.querySelectorAll(`.view-stops-btn[data-route-id="${routeId}"]`).forEach(btn => {
                    btn.classList.add("active");
                });

                document.querySelectorAll(".route-list-row").forEach(row => {
                    row.classList.remove("active");
                });

                document.querySelectorAll(`.route-list-row[data-route-id="${routeId}"]`).forEach(row => {
                    row.classList.add("active");
                });

                if (shouldScroll) {
                    routeDetailsPanel.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });
                }
            }

            searchInput.addEventListener("input", filterRoutes);
            statusFilter.addEventListener("change", filterRoutes);

            clearBtn.addEventListener("click", function () {
                searchInput.value = "";
                statusFilter.value = "";
                filterRoutes();
            });

            document.querySelectorAll(".view-stops-btn").forEach(function (button) {
                button.addEventListener("click", function () {
                    const routeId = parseInt(this.getAttribute("data-route-id"));
                    showRouteDetails(routeId, true);
                });
            });

            if (routes.length > 0) {
                showRouteDetails(routes[0].routeId, false);
            }
        });
    </script>
}