@model SRMSS.Web.Models.RouteStop

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>RouteStop</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="TransportRouteId" class="control-label"></label>
                <select asp-for="TransportRouteId" class="form-control" asp-items="ViewBag.TransportRouteId"></select>
                <span asp-validation-for="TransportRouteId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StopName" class="control-label"></label>
                <input asp-for="StopName" class="form-control" />
                <span asp-validation-for="StopName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StopOrder" class="control-label"></label>
                <input asp-for="StopOrder" class="form-control" />
                <span asp-validation-for="StopOrder" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EstimatedMinutesFromStart" class="control-label"></label>
                <input asp-for="EstimatedMinutesFromStart" class="form-control" />
                <span asp-validation-for="EstimatedMinutesFromStart" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
