@using System.Text.Json
@model IEnumerable<SRMSS.Web.Models.TransportRoute>

@{
    ViewData["Title"] = "Route Management";

    ViewData["PageTitle"] = "Route Management";

    ViewData["PageSubtitle"] =
        "View transport routes, route status, service type, stop flow and live map previews.";


    string currentRole =
        Context.Session.GetString("Role")
        ?? string.Empty;


    bool canManageRoutes =
        currentRole == "SuperAdmin"
        ||
        currentRole == "Admin";


    var totalRoutes =
        Model.Count();


    var activeRoutes =
        Model.Count(
            route =>
                route.Status == "Active"
        );


    var inactiveRoutes =
        Model.Count(
            route =>
                route.Status == "Inactive"
        );


    var expressRoutes =
        Model.Count(
            route =>
                route.ServiceType == "Express"
        );


    var routeData =
        Model
            .Select(
                route => new
                {
                    routeId =
                        route.Id,

                    routeName =
                        route.RouteName,

                    startPoint =
                        route.StartPoint,

                    endPoint =
                        route.EndPoint,

                    distanceKm =
                        route.DistanceKm,

                    estimatedDurationMinutes =
                        route.EstimatedDurationMinutes,

                    serviceType =
                        route.ServiceType,

                    status =
                        route.Status,

                    stops =
                        route.RouteStops
                            .OrderBy(
                                stop =>
                                    stop.StopOrder
                            )
                            .Select(
                                stop => new
                                {
                                    stopOrder =
                                        stop.StopOrder,

                                    stopName =
                                        stop.StopName,

                                    estimatedMinutes =
                                        stop.EstimatedMinutesFromStart
                                }
                            )
                            .ToList()
                }
            )
            .ToList();


    var routeDataJson =
        JsonSerializer.Serialize(
            routeData,
            new JsonSerializerOptions
            {
                PropertyNamingPolicy =
                    JsonNamingPolicy.CamelCase
            }
        );
}


<style>

    .route-map-preview-wrapper {
        width: 100%;
    }


    .route-map-card {
        width: 100%;
    }


    .route-preview-grid {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
        gap: 20px;
        margin-top: 18px;
    }


    .route-map-frame {
        width: 100%;
        min-width: 0;
        border-radius: 18px;
        overflow: hidden;
        background: #e9eef5;
        border: 1px solid rgba(148, 163, 184, 0.25);
    }


    .live-route-map {
        width: 100%;
        height: 500px;
        min-height: 500px;
        position: relative;
        z-index: 1;
        background: #e9eef5;
    }


    .map-loading-message,
    .map-error-message {
        min-height: 500px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px;
        text-align: center;
        color: #64748b;
        font-weight: 600;
    }


    .route-map-warning {
        margin-top: 15px;
        padding: 13px 16px;
        border-radius: 12px;
        background: rgba(245, 158, 11, 0.12);
        border: 1px solid rgba(245, 158, 11, 0.25);
        color: #b45309;
        font-size: 14px;
        font-weight: 600;
    }


    .custom-route-marker {
        background: transparent;
        border: none;
    }


    .route-marker {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 12px;
        font-weight: 800;
        border: 3px solid white;
        box-shadow: 0 6px 16px rgba(15, 23, 42, 0.25);
    }


    .route-marker.start {
        background: #16a34a;
    }


    .route-marker.stop {
        background: #2563eb;
    }


    .route-marker.end {
        background: #dc2626;
    }


    .route-marker-tooltip {
        border: none;
        border-radius: 8px;
        padding: 5px 8px;
        font-size: 11px;
        font-weight: 700;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
    }


    .transport-route-row {
        cursor: pointer;
        transition: background 0.2s ease;
    }


    .transport-route-row.active {
        background: rgba(37, 99, 235, 0.07);
    }


    .view-route-btn.active {
        background: #2563eb;
        color: white;
    }


    @@media (max-width: 992px) {

        .route-preview-grid {
            grid-template-columns: 1fr;
        }


        .live-route-map {
            height: 420px;
            min-height: 420px;
        }


        .map-loading-message,
        .map-error-message {
            min-height: 420px;
        }
    }


    @@media (max-width: 576px) {

        .live-route-map {
            height: 340px;
            min-height: 340px;
        }


        .map-loading-message,
        .map-error-message {
            min-height: 340px;
        }
    }

</style>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}


@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}


@if (canManageRoutes)
{
    <div class="d-flex justify-content-end mb-4">

        <a asp-action="Create"
           class="srmss-btn primary">

            + Add New Route

        </a>

    </div>
}


<div class="metric-grid">

    <div class="metric-card">

        <div class="metric-icon">
            R
        </div>

        <div>

            <p>
                Total Routes
            </p>

            <h3>
                @totalRoutes
            </h3>

        </div>

    </div>


    <div class="metric-card">

        <div class="metric-icon green">
            A
        </div>

        <div>

            <p>
                Active Routes
            </p>

            <h3>
                @activeRoutes
            </h3>

        </div>

    </div>


    <div class="metric-card">

        <div class="metric-icon red">
            I
        </div>

        <div>

            <p>
                Inactive Routes
            </p>

            <h3>
                @inactiveRoutes
            </h3>

        </div>

    </div>


    <div class="metric-card">

        <div class="metric-icon amber">
            E
        </div>

        <div>

            <p>
                Express Routes
            </p>

            <h3>
