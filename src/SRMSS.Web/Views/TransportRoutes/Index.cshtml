@model IEnumerable<SRMSS.Web.Models.TransportRoute>

@{
    ViewData["Title"] = "Route Management";
    ViewData["PageTitle"] = "Route Management";
    ViewData["PageSubtitle"] = "Manage transport routes, stops, distance and service types.";

    var routeCount = Model.Count();
    var activeRoutes = Model.Count(r => r.Status == "Active");
    var longDistanceRoutes = Model.Count(r => r.DistanceKm >= 80);
    var urbanRoutes = Model.Count(r => r.DistanceKm < 80);
}

<div class="d-flex justify-content-end mb-4">
    <a asp-action="Create" class="srmss-btn primary">
        + Add Route
    </a>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="srmss-card">
            <h3 class="card-title">Route Map Preview</h3>
            <p class="card-subtitle">
                Visual location preview area for Google Maps or OpenStreetMap integration.
            </p>

            <div class="route-map-preview">
                <div class="map-grid"></div>

                <svg class="route-line" viewBox="0 0 700 160" preserveAspectRatio="none">
                    <polyline points="50,105 180,60 350,90 540,40 650,20"
                              fill="none"
                              stroke="#1E3A8A"
                              stroke-width="7"
                              stroke-linecap="round"
                              stroke-linejoin="round" />

                    <circle cx="50" cy="105" r="8" fill="#F59E0B" />
                    <circle cx="180" cy="60" r="8" fill="#F59E0B" />
                    <circle cx="350" cy="90" r="8" fill="#F59E0B" />
                    <circle cx="540" cy="40" r="8" fill="#F59E0B" />
                    <circle cx="650" cy="20" r="8" fill="#F59E0B" />
                </svg>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="srmss-card green h-100">
            <h3 class="card-title">Route Summary</h3>
            <p class="card-subtitle">Current route performance</p>

            <div class="summary-row">
                <span>Active routes</span>
                <strong>@activeRoutes</strong>
            </div>

            <div class="summary-row">
                <span>Long-distance</span>
                <strong>@longDistanceRoutes</strong>
            </div>

            <div class="summary-row">
                <span>Urban routes</span>
                <strong>@urbanRoutes</strong>
            </div>

            <div class="summary-row">
                <span>Total routes</span>
                <strong>@routeCount</strong>
            </div>
        </div>
    </div>
</div>

<div class="srmss-card">
    <h3 class="card-title">Route List</h3>
    <p class="card-subtitle">
        Routes are maintained by the route and schedule owner.
    </p>

    <div class="mb-4">
        <input class="top-search" style="width: 300px;" placeholder="Search route..." />
    </div>

    <div class="table-responsive">
        <table class="srmss-table">
            <thead>
                <tr>
                    <th>Route</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Distance</th>
                    <th>Duration</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Stops</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.RouteName</td>
                            <td>@item.StartPoint</td>
                            <td>@item.EndPoint</td>
                            <td>@item.DistanceKm km</td>
                            <td>@item.EstimatedDurationMinutes mins</td>
                            <td>@item.ServiceType</td>
                            <td>
                                @if (item.Status == "Active")
                                {
                                    <span class="status-pill green">Active</span>
                                }
                                else
                                {
                                    <span class="status-pill red">@item.Status</span>
                                }
                            </td>
                            <td>@(item.RouteStops?.Count ?? 0)</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="action-link">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="action-link">Details</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="action-link danger">Delete</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">
                            No routes have been added yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>