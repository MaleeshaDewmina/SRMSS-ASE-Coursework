@using System.Text.Json
@model IEnumerable<SRMSS.Web.Models.TransportRoute>

@{
    ViewData["Title"] = "Route Management";
    ViewData["PageTitle"] = "Route Management";
    ViewData["PageSubtitle"] = "Manage transport routes, route status, service type and stop flow.";

    var totalRoutes = Model.Count();
    var activeRoutes = Model.Count(r => r.Status == "Active");
    var inactiveRoutes = Model.Count(r => r.Status == "Inactive");
    var expressRoutes = Model.Count(r => r.ServiceType == "Express");

    var routeData = Model
        .Select(r => new
        {
            routeId = r.Id,
            routeName = r.RouteName,
            startPoint = r.StartPoint,
            endPoint = r.EndPoint,
            distanceKm = r.DistanceKm,
            estimatedDurationMinutes = r.EstimatedDurationMinutes,
            serviceType = r.ServiceType,
            status = r.Status,
            stops = r.RouteStops
                .OrderBy(s => s.StopOrder)
                .Select(s => new
                {
                    stopOrder = s.StopOrder,
                    stopName = s.StopName,
                    estimatedMinutes = s.EstimatedMinutesFromStart
                })
                .ToList()
        })
        .ToList();

    var routeDataJson = JsonSerializer.Serialize(
        routeData,
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        }
    );
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="d-flex justify-content-end mb-4">
    <a asp-action="Create" class="srmss-btn primary">
        + Add New Route
    </a>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-icon">R</div>
        <div>
            <p>Total Routes</p>
            <h3>@totalRoutes</h3>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon green">A</div>
        <div>
            <p>Active Routes</p>
            <h3>@activeRoutes</h3>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon red">I</div>
        <div>
            <p>Inactive Routes</p>
            <h3>@inactiveRoutes</h3>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-icon amber">E</div>
        <div>
            <p>Express Routes</p>
            <h3>@expressRoutes</h3>
        </div>
    </div>
</div>

<div class="srmss-card route-preview-main-card mb-4" id="routePreviewPanel">
    <div class="route-preview-topbar">
        <div>
            <h3 class="card-title mb-1">Online Map Route Preview</h3>
            <p class="card-subtitle mb-0" id="routePreviewSubtitle">
                Select a route to view online map preview.
            </p>
        </div>

        <div class="route-preview-badge">
            Live Route Mapping
        </div>
    </div>

    <div id="routeDiagramArea" class="route-map-preview-wrapper">
        <div class="empty-route-diagram">
            Select a route from the table.
        </div>
    </div>
</div>

<div class="srmss-card mb-4">
    <h3 class="card-title">Search and Filter Routes</h3>
    <p class="card-subtitle">
        Search routes by name, start point, end point or stop name. Filter by service type and route status.
    </p>

    <div class="transport-route-filter-grid">
        <div>
            <label class="form-label">Search Route</label>
            <input id="routeSearchInput"
                   class="form-control"
                   placeholder="Example: Colombo, Galle, Badulla, Kalutara..." />
        </div>

        <div>
            <label class="form-label">Service Type</label>
            <select id="serviceTypeFilter" class="form-select">
                <option value="">All Types</option>
                <option value="normal">Normal</option>
                <option value="express">Express</option>
                <option value="intercity">Intercity</option>
            </select>
        </div>

        <div>
            <label class="form-label">Status</label>
            <select id="statusFilter" class="form-select">
                <option value="">All Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
        </div>

        <div class="filter-button-area">
            <button type="button" id="clearFilterBtn" class="srmss-btn secondary w-100">
                Clear Filter
            </button>
        </div>
    </div>
</div>

<div class="srmss-card mb-4">
    <h3 class="card-title">Route List</h3>
    <p class="card-subtitle">
        Select a route to preview the map, ordered stop flow and Google Maps direction link.
    </p>

    <div class="table-responsive">
        <table class="srmss-table">
            <thead>
                <tr>
                    <th>Route</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Distance</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody id="routeTableBody">
                @if (Model.Any())
                {
                    foreach (var route in Model)
                    {
                        var orderedStops = route.RouteStops != null
                            ? route.RouteStops.OrderBy(s => s.StopOrder).ToList()
                            : new List<SRMSS.Web.Models.RouteStop>();

                        var stopNames = string.Join(" ", orderedStops.Select(s => s.StopName));
                        var searchText = $"{route.RouteName} {route.StartPoint} {route.EndPoint} {route.ServiceType} {route.Status} {stopNames}".ToLower();

                        var origin = System.Uri.EscapeDataString(route.StartPoint ?? "");
                        var destination = System.Uri.EscapeDataString(route.EndPoint ?? "");
                        var waypoints = string.Join("%7C", orderedStops.Select(s => System.Uri.EscapeDataString(s.StopName ?? "")));

                        var mapUrl = "https://www.google.com/maps/dir/?api=1"
                            + "&origin=" + origin
                            + "&destination=" + destination
                            + (string.IsNullOrWhiteSpace(waypoints) ? "" : "&waypoints=" + waypoints)
                            + "&travelmode=driving";

                        <tr class="transport-route-row"
                            data-route-id="@route.Id"
                            data-search="@searchText"
                            data-service-type="@route.ServiceType.ToLower()"
                            data-status="@route.Status.ToLower()">
                            <td class="fw-bold">@route.RouteName</td>
                            <td>@route.StartPoint</td>
                            <td>@route.EndPoint</td>
                            <td>@route.DistanceKm km</td>
                            <td>
                                @if (route.ServiceType == "Express")
                                {
                                    <span class="status-pill amber">Express</span>
                                }
                                else if (route.ServiceType == "Intercity")
                                {
                                    <span class="status-pill blue">Intercity</span>
                                }
                                else
                                {
                                    <span class="status-pill blue">Normal</span>
                                }
                            </td>
                            <td>
                                @if (route.Status == "Active")
                                {
                                    <span class="status-pill green">Active</span>
                                }
                                else
                                {
                                    <span class="status-pill red">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <button type="button"
                                        class="view-route-btn"
                                        data-route-id="@route.Id">
                                    View Map
                                </button>

                                <a href="@mapUrl"
                                   target="_blank"
                                   class="map-route-link">
                                    Google
                                </a>

                                <a asp-action="Details" asp-route-id="@route.Id" class="action-link">Details</a>
                                <a asp-action="Edit" asp-route-id="@route.Id" class="action-link">Edit</a>
                                <a asp-action="Delete" asp-route-id="@route.Id" class="action-link danger">Delete</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            No routes have been added yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div id="noRouteResults" class="no-stop-results d-none">
        No matching routes found.
    </div>
</div>

@section Scripts {
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const routes = @Html.Raw(routeDataJson);

            const searchInput = document.getElementById("routeSearchInput");
            const serviceTypeFilter = document.getElementById("serviceTypeFilter");
            const statusFilter = document.getElementById("statusFilter");
            const clearFilterBtn = document.getElementById("clearFilterBtn");
            const rows = document.querySelectorAll(".transport-route-row");
            const noRouteResults = document.getElementById("noRouteResults");

            const routePreviewSubtitle = document.getElementById("routePreviewSubtitle");
            const routeDiagramArea = document.getElementById("routeDiagramArea");
            const routePreviewPanel = document.getElementById("routePreviewPanel");

            let activeMap = null;
            const geocodeCache = {};

            function escapeHtml(value) {
                if (value === null || value === undefined) {
                    return "";
                }

                return String(value)
                    .replaceAll("&", "&amp;")
                    .replaceAll("<", "&lt;")
                    .replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;")
                    .replaceAll("'", "&#039;");
            }

            function buildGoogleMapsUrl(startPoint, endPoint, stops) {
                const origin = encodeURIComponent(startPoint);
                const destination = encodeURIComponent(endPoint);

                let waypointText = "";

                if (stops && stops.length > 0) {
                    waypointText = stops
                        .map(stop => encodeURIComponent(stop.stopName))
                        .join("%7C");
                }

                if (waypointText !== "") {
                    return `https://www.google.com/maps/dir/?api=1&origin=${origin}&destination=${destination}&waypoints=${waypointText}&travelmode=driving`;
                }

                return `https://www.google.com/maps/dir/?api=1&origin=${origin}&destination=${destination}&travelmode=driving`;
            }

            function buildRouteFlowHtml(route) {
                let flowHtml = "";

                flowHtml += `
                    <div class="route-flow-item start">
                        <span>Start Point</span>
                        <strong>${escapeHtml(route.startPoint)}</strong>
                    </div>
                `;

                if (route.stops && route.stops.length > 0) {
                    route.stops.forEach(function (stop, index) {
                        flowHtml += `
                            <div class="route-flow-arrow">→</div>

                            <div class="route-flow-item stop">
                                <span>Stop ${index + 1}</span>
                                <strong>${escapeHtml(stop.stopName)}</strong>
                            </div>
                        `;
                    });
                }

                flowHtml += `
                    <div class="route-flow-arrow">→</div>

                    <div class="route-flow-item end">
                        <span>End Point</span>
                        <strong>${escapeHtml(route.endPoint)}</strong>
                    </div>
                `;

                return flowHtml;
            }

            async function geocodePlace(placeName) {
                if (!placeName) {
                    return null;
                }

                const cleanPlaceName = placeName.trim();
                const key = cleanPlaceName.toLowerCase().replace(/\s+/g, " ");

                if (geocodeCache[key]) {
                    return geocodeCache[key];
                }

                const query = encodeURIComponent(cleanPlaceName + ", Sri Lanka");

                const url =
                    `https://nominatim.openstreetmap.org/search?format=json` +
                    `&limit=5` +
                    `&countrycodes=lk` +
                    `&addressdetails=1` +
                    `&q=${query}`;

                try {
                    const response = await fetch(url, {
                        headers: {
                            "Accept": "application/json"
                        }
                    });

                    const data = await response.json();

                    if (!data || data.length === 0) {
                        return null;
                    }

                    const selectedResult = data[0];

                    const point = {
                        lat: parseFloat(selectedResult.lat),
                        lng: parseFloat(selectedResult.lon),
                        label: cleanPlaceName
                    };

                    geocodeCache[key] = point;
                    return point;
                } catch {
                    return null;
                }
            }

            async function buildRouteCoordinates(route) {
                const routePoints = [];

                routePoints.push({
                    placeName: route.startPoint,
                    markerLabel: "S",
                    markerType: "start",
                    tooltipText: "Start Point: " + route.startPoint
                });

                if (route.stops && route.stops.length > 0) {
                    route.stops.forEach(function (stop, index) {
                        routePoints.push({
                            placeName: stop.stopName,
                            markerLabel: (index + 1).toString(),
                            markerType: "stop",
                            tooltipText: "Stop " + (index + 1) + ": " + stop.stopName
                        });
                    });
                }

                routePoints.push({
                    placeName: route.endPoint,
                    markerLabel: "E",
                    markerType: "end",
                    tooltipText: "End Point: " + route.endPoint
                });

                const coordinates = [];
                const missingPoints = [];

                for (const routePoint of routePoints) {
                    const result = await geocodePlace(routePoint.placeName);

                    if (result) {
                        coordinates.push({
                            lat: result.lat,
                            lng: result.lng,
                            label: routePoint.placeName,
                            markerLabel: routePoint.markerLabel,
                            markerType: routePoint.markerType,
                            tooltipText: routePoint.tooltipText
                        });
                    } else {
                        missingPoints.push(routePoint.tooltipText);
                    }
                }

                return {
                    coordinates: coordinates,
                    missingPoints: missingPoints
                };
            }

            async function drawRouteLine(map, coordinates) {
                if (coordinates.length < 2) {
                    return;
                }

                const osrmCoordinates = coordinates
                    .map(point => `${point.lng},${point.lat}`)
                    .join(";");

                const osrmUrl = `https://router.project-osrm.org/route/v1/driving/${osrmCoordinates}?overview=full&geometries=geojson`;

                try {
                    const response = await fetch(osrmUrl);
                    const data = await response.json();

                    if (data.routes && data.routes.length > 0) {
                        const routeGeoJson = data.routes[0].geometry;

                        const routeLine = L.geoJSON(routeGeoJson, {
                            style: {
                                weight: 5,
                                opacity: 0.9
                            }
                        }).addTo(map);

                        map.fitBounds(routeLine.getBounds(), {
                            padding: [40, 40]
                        });

                        return;
                    }
                } catch {
                    // Straight line fallback will run if online routing fails.
                }

                const fallbackLine = L.polyline(
                    coordinates.map(point => [point.lat, point.lng]),
                    {
                        weight: 5,
                        opacity: 0.9
                    }
                ).addTo(map);

                map.fitBounds(fallbackLine.getBounds(), {
                    padding: [40, 40]
                });
            }

            function createRouteMarkerIcon(label, markerType) {
                return L.divIcon({
                    className: "custom-route-marker",
                    html: `<div class="route-marker ${markerType}">${label}</div>`,
                    iconSize: [34, 34],
                    iconAnchor: [17, 17],
                    popupAnchor: [0, -18]
                });
            }

            async function renderLeafletMap(route) {
                const mapElement = document.getElementById("liveRouteMap");
                const missingArea = document.getElementById("missingRoutePoints");

                if (!mapElement) {
                    return;
                }

                if (activeMap) {
                    activeMap.remove();
                    activeMap = null;
                }

                activeMap = L.map("liveRouteMap", {
                    zoomControl: true
                });

                L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                    maxZoom: 19,
                    attribution: "© OpenStreetMap"
                }).addTo(activeMap);

                const routeCoordinateResult = await buildRouteCoordinates(route);
                const coordinates = routeCoordinateResult.coordinates;
                const missingPoints = routeCoordinateResult.missingPoints;

                if (missingArea && missingPoints.length > 0) {
                    missingArea.innerHTML = `
                        <div class="route-map-warning">
                            Map service could not locate ${missingPoints.length} saved route point(s).
                            Use simple real town names for highest accuracy.
                        </div>
                    `;
                } else if (missingArea) {
                    missingArea.innerHTML = "";
                }

                if (coordinates.length === 0) {
                    mapElement.innerHTML = `
                        <div class="map-error-message">
                            Map location could not be found for this route.
                            Please use real searchable place names such as Colombo, Badulla, Ratnapura or Ella.
                        </div>
                    `;
                    return;
                }

                coordinates.forEach(function (point) {
                    L.marker([point.lat, point.lng], {
                        icon: createRouteMarkerIcon(point.markerLabel, point.markerType)
                    })
                        .addTo(activeMap)
                        .bindTooltip(escapeHtml(point.tooltipText), {
                            permanent: true,
                            direction: "top",
                            offset: [0, -22],
                            className: "route-marker-tooltip"
                        })
                        .bindPopup(`<strong>${escapeHtml(point.tooltipText)}</strong>`);
                });

                await drawRouteLine(activeMap, coordinates);

                const markerBounds = L.latLngBounds(
                    coordinates.map(point => [point.lat, point.lng])
                );

                activeMap.fitBounds(markerBounds, {
                    paddingTopLeft: [80, 80],
                    paddingBottomRight: [80, 80],
                    maxZoom: 11
                });

                setTimeout(function () {
                    activeMap.invalidateSize();
                }, 250);
            }

            function filterRoutes() {
                const searchValue = searchInput.value.toLowerCase().trim();
                const selectedServiceType = serviceTypeFilter.value;
                const selectedStatus = statusFilter.value;

                let visibleCount = 0;

                rows.forEach(function (row) {
                    const rowSearch = row.getAttribute("data-search");
                    const rowServiceType = row.getAttribute("data-service-type");
                    const rowStatus = row.getAttribute("data-status");

                    const matchesSearch = rowSearch.includes(searchValue);
                    const matchesServiceType = selectedServiceType === "" || rowServiceType === selectedServiceType;
                    const matchesStatus = selectedStatus === "" || rowStatus === selectedStatus;

                    if (matchesSearch && matchesServiceType && matchesStatus) {
                        row.style.display = "";
                        visibleCount++;
                    } else {
                        row.style.display = "none";
                    }
                });

                if (visibleCount === 0 && rows.length > 0) {
                    noRouteResults.classList.remove("d-none");
                } else {
                    noRouteResults.classList.add("d-none");
                }
            }

            async function showRouteMap(routeId, shouldScroll) {
                const route = routes.find(r => r.routeId === routeId);

                if (!route) {
                    routePreviewSubtitle.textContent = "Route details not found.";
                    routeDiagramArea.innerHTML = `
                        <div class="empty-route-diagram">
                            Route details not found.
                        </div>
                    `;
                    return;
                }

                const mapUrl = buildGoogleMapsUrl(route.startPoint, route.endPoint, route.stops);
                const routeFlowHtml = buildRouteFlowHtml(route);

                routePreviewSubtitle.textContent =
                    `${route.routeName} | ${route.startPoint} → ${route.endPoint}`;

                let stopHtml = "";

                if (route.stops.length > 0) {
                    route.stops.forEach(function (stop) {
                        stopHtml += `
                            <span class="map-stop-chip">
                                Stop ${escapeHtml(stop.stopOrder)}: ${escapeHtml(stop.stopName)}
                            </span>
                        `;
                    });
                } else {
                    stopHtml = `<span class="map-stop-chip">No intermediary stops</span>`;
                }

                routeDiagramArea.innerHTML = `
                    <div class="route-map-card">
                        <div class="route-map-header">
                            <div>
                                <strong>${escapeHtml(route.routeName)}</strong>
                                <p>${escapeHtml(route.distanceKm)} km | ${escapeHtml(route.estimatedDurationMinutes)} mins | ${escapeHtml(route.serviceType)}</p>
                            </div>

                            <span class="status-pill blue">${escapeHtml(route.serviceType)}</span>
                        </div>

                        <div class="route-preview-grid">
                            <div class="route-map-frame">
                                <div id="liveRouteMap" class="live-route-map">
                                    <div class="map-loading-message">Loading online route map...</div>
                                </div>
                            </div>

                            <div class="route-preview-side">
                                <div class="route-map-info">
                                    <div>
                                        <span>Start Point</span>
                                        <strong>${escapeHtml(route.startPoint)}</strong>
                                    </div>

                                    <div>
                                        <span>End Point</span>
                                        <strong>${escapeHtml(route.endPoint)}</strong>
                                    </div>
                                </div>

                                <div class="route-map-stops">
                                    <span class="route-map-stops-title">Stops Used as Waypoints</span>
                                    <div>
                                        ${stopHtml}
                                    </div>
                                </div>

                                <a href="${mapUrl}" target="_blank" class="srmss-btn primary w-100">
                                    Open Full Route in Google Maps
                                </a>
                            </div>
                        </div>

                        <div id="missingRoutePoints"></div>

                        <div class="route-flow-card">
                            <span class="route-flow-title">Complete Route Flow</span>

                            <div class="route-flow-wrapper">
                                ${routeFlowHtml}
                            </div>
                        </div>
                    </div>
                `;

                document.querySelectorAll(".view-route-btn").forEach(btn => {
                    btn.classList.remove("active");
                });

                document.querySelectorAll(`.view-route-btn[data-route-id="${routeId}"]`).forEach(btn => {
                    btn.classList.add("active");
                });

                document.querySelectorAll(".transport-route-row").forEach(row => {
                    row.classList.remove("active");
                });

                document.querySelectorAll(`.transport-route-row[data-route-id="${routeId}"]`).forEach(row => {
                    row.classList.add("active");
                });

                await renderLeafletMap(route);

                if (shouldScroll) {
                    routePreviewPanel.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });
                }
            }

            searchInput.addEventListener("input", filterRoutes);
            serviceTypeFilter.addEventListener("change", filterRoutes);
            statusFilter.addEventListener("change", filterRoutes);

            clearFilterBtn.addEventListener("click", function () {
                searchInput.value = "";
                serviceTypeFilter.value = "";
                statusFilter.value = "";
                filterRoutes();
            });

            document.querySelectorAll(".view-route-btn").forEach(function (button) {
                button.addEventListener("click", function () {
                    const routeId = parseInt(this.getAttribute("data-route-id"));
                    showRouteMap(routeId, true);
                });
            });

            if (routes.length > 0) {
                showRouteMap(routes[0].routeId, false);
            }
        });
    </script>
}