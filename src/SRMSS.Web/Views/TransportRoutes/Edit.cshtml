@model SRMSS.Web.Models.TransportRoute

@{
    ViewData["Title"] = "Edit Route";
    ViewData["PageTitle"] = "Add / Edit Route";
    ViewData["PageSubtitle"] = "Route creation screen with ordered stops and validation.";
}

<div class="route-editor-grid">
    <div class="srmss-card">
        <h3 class="card-title">Route Details</h3>
        <p class="card-subtitle">Update core route details before managing stops</p>

        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="RouteName" class="form-label"></label>
                <input asp-for="RouteName" class="form-control" />
                <span asp-validation-for="RouteName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StartPoint" class="form-label"></label>
                <input asp-for="StartPoint" class="form-control" />
                <span asp-validation-for="StartPoint" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EndPoint" class="form-label"></label>
                <input asp-for="EndPoint" class="form-control" />
                <span asp-validation-for="EndPoint" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DistanceKm" class="form-label"></label>
                <input asp-for="DistanceKm" class="form-control" />
                <span asp-validation-for="DistanceKm" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EstimatedDurationMinutes" class="form-label"></label>
                <input asp-for="EstimatedDurationMinutes" class="form-control" />
                <span asp-validation-for="EstimatedDurationMinutes" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ServiceType" class="form-label"></label>
                <select asp-for="ServiceType" class="form-select">
                    <option value="Normal">Normal</option>
                    <option value="Express">Express</option>
                    <option value="Intercity">Intercity</option>
                </select>
                <span asp-validation-for="ServiceType" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="d-flex gap-3 flex-wrap">
                <button type="submit" class="srmss-btn primary">
                    Save Route
                </button>

                <a asp-action="Index" class="srmss-btn secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>

    <div class="srmss-card amber">
        <h3 class="card-title">Route Stops</h3>
        <p class="card-subtitle">Ordered stops can be added, edited or removed</p>

        <div class="stop-flow">
            @if (Model.RouteStops != null && Model.RouteStops.Any())
            {
                foreach (var stop in Model.RouteStops.OrderBy(s => s.StopOrder))
                {
                    <div class="stop-flow-item">
                        <div class="stop-dot @(stop.StopOrder == 1 ? "filled" : "")"></div>
                        <div>
                            <strong>@stop.StopOrder. @stop.StopName</strong>
                            <small>@stop.EstimatedMinutesFromStart mins from start</small>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-stop-panel">
                    <div class="empty-stop-icon">+</div>
                    <h4>No stops added</h4>
                    <p>Add stops to show the route flow here.</p>
                </div>
            }
        </div>

        <a asp-controller="RouteStops" asp-action="Create" class="srmss-btn light w-100 mt-4">
            + Add Stop
        </a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}