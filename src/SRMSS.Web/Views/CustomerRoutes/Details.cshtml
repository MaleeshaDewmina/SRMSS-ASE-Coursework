@using System.Text.Json
@model SRMSS.Web.Models.TransportRoute

@{
    ViewData["Title"] = "Journey Details";
    ViewData["PageTitle"] = "Journey Details";
    ViewData["PageSubtitle"] =
        "Explore route information, stops, live map preview, timetables and current trip status.";

    bool isFavorite =
        ViewBag.IsFavorite is bool favorite &&
        favorite;

    var orderedStops =
        Model.RouteStops != null
            ? Model.RouteStops
                .OrderBy(stop => stop.StopOrder)
                .ToList()
            : new List<SRMSS.Web.Models.RouteStop>();

    var schedules =
        Model.Schedules != null
            ? Model.Schedules
                .OrderBy(schedule =>
                    schedule.ScheduleDate < DateTime.Today
                        ? 1
                        : 0
                )
                .ThenBy(schedule => schedule.ScheduleDate)
                .ThenBy(schedule => schedule.DepartureTime)
                .ToList()
            : new List<SRMSS.Web.Models.Schedule>();

    var upcomingSchedules =
        schedules
            .Where(schedule =>
                schedule.ScheduleDate.Date >= DateTime.Today &&
                schedule.Status != "Completed" &&
                schedule.Status != "Cancelled"
            )
            .ToList();

    var nextSchedule =
        upcomingSchedules.FirstOrDefault();

    int activeScheduleCount =
        schedules.Count(schedule =>
            schedule.Status == "Scheduled" ||
            schedule.Status == "On Time" ||
            schedule.Status == "Departed"
        );

    int delayedScheduleCount =
        schedules.Count(schedule =>
            schedule.Status == "Delayed"
        );

    var origin =
        System.Uri.EscapeDataString(
            Model.StartPoint ?? ""
        );

    var destination =
        System.Uri.EscapeDataString(
            Model.EndPoint ?? ""
        );

    var waypointStops =
        orderedStops
            .Where(stop =>
                !string.Equals(
                    stop.StopName,
                    Model.StartPoint,
                    StringComparison.OrdinalIgnoreCase
                )
                &&
                !string.Equals(
                    stop.StopName,
                    Model.EndPoint,
                    StringComparison.OrdinalIgnoreCase
                )
            )
            .ToList();

    var waypoints =
        string.Join(
            "%7C",
            waypointStops.Select(
                stop =>
                    System.Uri.EscapeDataString(
                        stop.StopName ?? ""
                    )
            )
        );

    var mapUrl =
        "https://www.google.com/maps/dir/?api=1"
        + "&origin=" + origin
        + "&destination=" + destination
        + (
            string.IsNullOrWhiteSpace(waypoints)
                ? ""
                : "&waypoints=" + waypoints
        )
        + "&travelmode=driving";

    var routeData = new
    {
        routeId = Model.Id,
        routeName = Model.RouteName,
        startPoint = Model.StartPoint,
        endPoint = Model.EndPoint,
        distanceKm = Model.DistanceKm,
        estimatedDurationMinutes =
            Model.EstimatedDurationMinutes,
        serviceType = Model.ServiceType,
        status = Model.Status,

        stops = orderedStops
            .Select(stop => new
            {
                stopOrder = stop.StopOrder,
                stopName = stop.StopName,
                estimatedMinutes =
                    stop.EstimatedMinutesFromStart
            })
            .ToList()
    };

    var routeDataJson =
        JsonSerializer.Serialize(
            routeData,
            new JsonSerializerOptions
            {
                PropertyNamingPolicy =
                    JsonNamingPolicy.CamelCase
            }
        );
}


