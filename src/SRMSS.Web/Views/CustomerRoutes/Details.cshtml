                            " "
                        );
                }


                async function fetchWithTimeout(
                    url,
                    options = {},
                    timeoutMilliseconds = 10000
                ) {

                    const controller =
                        new AbortController();


                    const timeout =
                        setTimeout(
                            function () {

                                controller.abort();

                            },
                            timeoutMilliseconds
                        );


                    try {

                        return await fetch(
                            url,
                            {
                                ...options,

                                signal:
                                    controller.signal
                            }
                        );

                    }
                    finally {

                        clearTimeout(timeout);
                    }
                }


                async function geocodePlace(placeName) {

                    if (!placeName) {
                        return null;
                    }


                    const cleanPlaceName =
                        String(placeName).trim();


                    const key =
                        normalizePlaceName(
                            cleanPlaceName
                        );


                    if (!key) {
                        return null;
                    }


                    if (geocodeCache[key]) {

                        return geocodeCache[key];
                    }


                    if (knownPlaceCoordinates[key]) {

                        const localPoint = {

                            lat:
                                knownPlaceCoordinates[key].lat,

                            lng:
                                knownPlaceCoordinates[key].lng,

                            label:
                                cleanPlaceName
                        };


                        geocodeCache[key] =
                            localPoint;


                        return localPoint;
                    }


                    const query =
                        encodeURIComponent(
                            cleanPlaceName +
                            ", Sri Lanka"
                        );


                    const url =
                        "https://nominatim.openstreetmap.org/search"

                        + "?format=json"

                        + "&limit=1"

                        + "&countrycodes=lk"

                        + "&addressdetails=1"

                        + `&q=${query}`;


                    try {

                        const response =
                            await fetchWithTimeout(
                                url,
                                {
                                    headers: {
                                        "Accept":
                                            "application/json"
                                    }
                                },
                                8000
                            );


                        if (!response.ok) {
                            return null;
                        }


                        const data =
                            await response.json();


                        if (
                            !data ||
                            data.length === 0
                        ) {
                            return null;
                        }


                        const selectedResult =
                            data[0];


                        const point = {

                            lat:
                                parseFloat(
                                    selectedResult.lat
                                ),

                            lng:
                                parseFloat(
                                    selectedResult.lon
                                ),

                            label:
                                cleanPlaceName
                        };


                        geocodeCache[key] =
                            point;


                        return point;

                    }
                    catch (error) {

                        console.warn(
                            "Geocoding failed:",
                            cleanPlaceName,
                            error
                        );


                        return null;
                    }
                }


                async function buildRouteCoordinates(
                    routeData
                ) {

                    const rawRoutePoints =
                        [];


                    rawRoutePoints.push({

                        placeName:
                            routeData.startPoint,

                        markerLabel:
                            "S",

                        markerType:
                            "start",

                        tooltipText:
                            "Start Point: " +
                            routeData.startPoint
                    });


                    if (
                        routeData.stops &&
                        routeData.stops.length > 0
                    ) {

                        routeData.stops.forEach(
                            function (stop, index) {

                                rawRoutePoints.push({

                                    placeName:
                                        stop.stopName,

                                    markerLabel:
                                        (
                                            index + 1
                                        ).toString(),

                                    markerType:
                                        "stop",

                                    tooltipText:
                                        "Stop " +
                                        (
                                            index + 1
                                        ) +
                                        ": " +
                                        stop.stopName
                                });

                            }
                        );
                    }


                    rawRoutePoints.push({

                        placeName:
                            routeData.endPoint,

                        markerLabel:
                            "E",

                        markerType:
                            "end",

                        tooltipText:
                            "End Point: " +
                            routeData.endPoint
                    });


                    const routePoints =
                        [];


                    const usedPlaces =
                        new Set();


                    rawRoutePoints.forEach(
                        function (point) {

                            const key =
                                normalizePlaceName(
                                    point.placeName
                                );


                            if (
                                !key ||
                                usedPlaces.has(key)
                            ) {
                                return;
                            }


                            usedPlaces.add(key);

                            routePoints.push(point);

                        }
                    );


                    const coordinates =
                        [];


                    const missingPoints =
                        [];


                    for (
                        const routePoint
                        of routePoints
                    ) {

                        const result =
                            await geocodePlace(
                                routePoint.placeName
                            );


                        if (result) {

                            coordinates.push({

                                lat:
                                    result.lat,

                                lng:
                                    result.lng,

                                markerLabel:
                                    routePoint.markerLabel,

                                markerType:
                                    routePoint.markerType,

                                tooltipText:
                                    routePoint.tooltipText
                            });

                        }
                        else {

                            missingPoints.push(
                                routePoint.tooltipText
                            );
                        }
                    }


                    return {
                        coordinates,
                        missingPoints
                    };
                }


                async function drawRouteLine(
                    map,
                    coordinates
                ) {

                    if (coordinates.length < 2) {
                        return;
                    }


                    const osrmCoordinates =
                        coordinates

                            .map(
                                point =>
                                    `${point.lng},${point.lat}`
                            )

                            .join(";");


                    const osrmUrl =
                        "https://router.project-osrm.org/route/v1/driving/"

                        + osrmCoordinates

                        + "?overview=full"

                        + "&geometries=geojson";


                    try {

                        const response =
                            await fetchWithTimeout(
                                osrmUrl,
                                {},
                                12000
                            );


                        if (response.ok) {

                            const data =
                                await response.json();


                            if (
                                data.routes &&
                                data.routes.length > 0
                            ) {

                                const routeGeoJson =
                                    data.routes[0]
                                        .geometry;


                                const routeLine =
                                    L.geoJSON(
                                        routeGeoJson,
                                        {
                                            style: {

                                                color:
                                                    "#2563eb",

                                                weight:
                                                    5,

                                                opacity:
                                                    0.9
                                            }
                                        }
                                    )
                                    .addTo(map);


                                map.fitBounds(
                                    routeLine.getBounds(),
                                    {
                                        padding:
                                            [40, 40]
                                    }
                                );


                                return;
                            }
                        }

                    }
                    catch (error) {

                        console.warn(
                            "Online route service failed. Using fallback.",
                            error
                        );
                    }


                    const fallbackLine =
                        L.polyline(
                            coordinates.map(
                                point => [
                                    point.lat,
                                    point.lng
                                ]
                            ),
                            {
                                color:
                                    "#2563eb",

                                weight:
                                    5,

                                opacity:
                                    0.85,

                                dashArray:
                                    "8 8"
                            }
                        )
                        .addTo(map);


                    map.fitBounds(
                        fallbackLine.getBounds(),
                        {
                            padding:
                                [40, 40]
                        }
                    );
                }


                function createRouteMarkerIcon(
                    label,
                    markerType
                ) {

                    return L.divIcon({

                        className:
                            "custom-route-marker",

                        html:
                            `<div class="route-marker ${markerType}">${escapeHtml(label)}</div>`,

                        iconSize:
                            [34, 34],

                        iconAnchor:
                            [17, 17],

                        popupAnchor:
                            [0, -18]
                    });
                }


                async function renderCustomerRouteMap() {

                    const mapElement =
                        document.getElementById(
                            "customerRouteMap"
                        );


                    const missingArea =
                        document.getElementById(
                            "missingCustomerRoutePoints"
                        );


                    if (!mapElement) {
                        return;
                    }


                    if (
                        typeof L === "undefined"
                    ) {

                        mapElement.innerHTML = `
                            <div class="journey-map-error">

                                The map library could not be loaded.
                                Check your internet connection
                                and refresh the page.

                            </div>
                        `;


                        return;
                    }


                    const map =
                        L.map(
                            "customerRouteMap",
                            {
                                zoomControl:
                                    true,

                                preferCanvas:
                                    true
                            }
                        );


                    map.setView(
                        [
                            7.8731,
                            80.7718
                        ],
                        7
                    );


                    L.tileLayer(
                        "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
                        {
                            maxZoom:
                                19,

                            attribution:
                                "&copy; OpenStreetMap contributors"
                        }
                    )
                    .addTo(map);


                    const result =
                        await buildRouteCoordinates(
                            route
                        );


                    const coordinates =
                        result.coordinates;


                    const missingPoints =
                        result.missingPoints;


                    if (
                        missingArea &&
                        missingPoints.length > 0
                    ) {

                        missingArea.innerHTML = `
                            <div class="journey-map-warning">

                                ${missingPoints.length}
                                route point(s) could not be located
                                automatically on the map.

                            </div>
                        `;
                    }


                    if (coordinates.length === 0) {

                        map.remove();


                        mapElement.innerHTML = `
                            <div class="journey-map-error">

                                Map coordinates could not be found
                                for this route.

                            </div>
                        `;


                        return;
                    }


                    coordinates.forEach(
                        function (point) {

                            L.marker(
                                [
                                    point.lat,
                                    point.lng
                                ],
                                {
                                    icon:
                                        createRouteMarkerIcon(
                                            point.markerLabel,
                                            point.markerType
                                        )
                                }
                            )

                            .addTo(map)

                            .bindTooltip(
                                escapeHtml(
                                    point.tooltipText
                                ),
                                {
                                    permanent:
                                        false,

                                    direction:
                                        "top",

                                    offset:
                                        [0, -22],

                                    className:
                                        "route-marker-tooltip"
                                }
                            )

                            .bindPopup(
                                `<strong>${escapeHtml(point.tooltipText)}</strong>`
                            );

                        }
                    );


                    await drawRouteLine(
                        map,
                        coordinates
                    );


                    if (coordinates.length === 1) {

                        map.setView(
                            [
                                coordinates[0].lat,
                                coordinates[0].lng
                            ],
                            12
                        );

                    }
                    else {

                        const markerBounds =
                            L.latLngBounds(
                                coordinates.map(
                                    point => [
                                        point.lat,
                                        point.lng
                                    ]
                                )
                            );


                        map.fitBounds(
                            markerBounds,
                            {
                                paddingTopLeft:
                                    [60, 60],

                                paddingBottomRight:
                                    [60, 60],

                                maxZoom:
                                    11
                            }
                        );
                    }


                    setTimeout(
                        function () {

                            map.invalidateSize();

                        },
                        300
                    );


                    window.addEventListener(
                        "resize",
                        function () {

                            map.invalidateSize();

                        }
                    );
                }


                renderCustomerRouteMap();

            }
        );

    </script>
}
