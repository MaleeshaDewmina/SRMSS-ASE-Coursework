                        )

                        .replaceAll(
                            '"',
                            "&quot;"
                        )

                        .replaceAll(
                            "'",
                            "&#039;"
                        );
                }


                function normalizePlaceName(value) {

                    return String(value ?? "")

                        .trim()

                        .toLowerCase()

                        .replace(
