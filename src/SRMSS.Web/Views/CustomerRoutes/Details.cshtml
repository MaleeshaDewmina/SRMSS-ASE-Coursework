    }


    .journey-timeline-line {
        position: absolute;

        width: 3px;

        top: 36px;
        bottom: -4px;

        border-radius: 99px;

        background:
            linear-gradient(
                to bottom,
                #93c5fd,
                #dbeafe
            );
    }


    .journey-timeline-item:last-child
    .journey-timeline-line {
        display: none;
    }


    .journey-timeline-node {
        position: relative;

        z-index: 2;

        width: 34px;
        height: 34px;

        display: grid;
        place-items: center;

        border-radius: 50%;

        color: #ffffff;

        border:
            4px solid #ffffff;

        box-shadow:
            0 0 0 2px
            rgba(37, 99, 235, 0.14);

        font-size: 9px;
        font-weight: 900;
    }


    .journey-timeline-node.start {
        background: #16a34a;
    }


    .journey-timeline-node.stop {
        background: #2563eb;
    }


    .journey-timeline-node.end {
        background: #dc2626;
    }


    .journey-timeline-content {
        min-width: 0;

        padding-bottom: 22px;
    }


    .journey-timeline-content small {
        display: block;

        color: #94a3b8;

        font-size: 8px;
        font-weight: 850;

        letter-spacing: 0.8px;
    }


    .journey-timeline-content strong {
        display: block;

        margin-top: 4px;

        color: #0f172a;

        font-size: 13px;
        font-weight: 850;
    }


    .journey-timeline-content span {
        display: block;

        margin-top: 4px;

        color: #64748b;

        font-size: 9px;
    }


    /* =========================================================
       SIDE CARDS
    ========================================================= */

    .journey-summary-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }


    .journey-summary-item {
        min-height: 62px;

        display: grid;

        grid-template-columns:
            40px minmax(0, 1fr);

        align-items: center;

        gap: 11px;

        padding: 10px;

        border-radius: 14px;

        background: #f8fafc;

        border:
            1px solid #edf2f7;
    }


    .journey-summary-icon {
        width: 40px;
        height: 40px;

        display: grid;
        place-items: center;

        border-radius: 12px;

        color: #2563eb;

        background:
            rgba(37, 99, 235, 0.09);
    }


    .journey-summary-icon svg {
        width: 19px;
        height: 19px;
    }


    .journey-summary-item span {
        display: block;

        color: #94a3b8;

        font-size: 8px;
        font-weight: 800;

        letter-spacing: 0.5px;

        text-transform: uppercase;
    }


    .journey-summary-item strong {
        display: block;

        margin-top: 3px;

        color: #0f172a;

        font-size: 11px;
        font-weight: 850;
    }


    /* =========================================================
       NEXT DEPARTURE
    ========================================================= */

    .journey-next-departure {
        position: relative;

        overflow: hidden;

        padding: 20px;

        border-radius: 20px;

        color: #ffffff;

        background:
            radial-gradient(
                circle at 90% 10%,
                rgba(56, 189, 248, 0.24),
                transparent 34%
            ),
            linear-gradient(
                135deg,
                #0f2747,
                #164581
            );
    }


    .journey-next-departure::after {
        content: "";

        position: absolute;

        width: 130px;
        height: 130px;

        right: -55px;
        bottom: -70px;

        border-radius: 50%;

        border:
            1px solid
            rgba(255, 255, 255, 0.11);
    }


    .journey-next-departure-eyebrow {
        color: #7dd3fc;

        font-size: 9px;
        font-weight: 850;

        letter-spacing: 1px;
    }


    .journey-next-departure h3 {
        position: relative;
        z-index: 2;

        margin: 8px 0 0;

        color: #ffffff;

        font-size: 18px;
        font-weight: 900;
    }


    .journey-next-departure-date {
        position: relative;
        z-index: 2;

        margin-top: 14px;

        color:
            rgba(226, 232, 240, 0.80);

        font-size: 10px;
    }


    .journey-next-departure-time {
        position: relative;
        z-index: 2;

        display: flex;
        align-items: center;
        flex-wrap: wrap;

        gap: 8px;

        margin-top: 8px;

        font-size: 21px;
        font-weight: 900;
    }


    .journey-next-departure-time span {
        color: #7dd3fc;
    }


    .journey-next-departure-status {
        position: relative;
        z-index: 2;

        display: inline-flex;

        margin-top: 13px;

        padding: 6px 9px;

        border-radius: 999px;

        color: #bbf7d0;

        background:
            rgba(34, 197, 94, 0.13);

        border:
            1px solid
            rgba(34, 197, 94, 0.18);

        font-size: 9px;
        font-weight: 800;
    }


    /* =========================================================
       TIMETABLE
    ========================================================= */

    .journey-timetable-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }


    .journey-timetable-card {
        position: relative;

        overflow: hidden;

        display: grid;

        grid-template-columns:
            160px
            minmax(0, 1fr)
            auto;

        align-items: center;

        gap: 16px;

        padding: 17px;

        border-radius: 18px;

        background: #f8fafc;

        border:
            1px solid #e7edf4;

        transition:
            transform 0.22s ease,
            border-color 0.22s ease,
            box-shadow 0.22s ease;
    }


    .journey-timetable-card:hover {
        transform: translateX(4px);

        border-color:
            rgba(37, 99, 235, 0.24);

        box-shadow:
            0 11px 26px
            rgba(15, 23, 42, 0.06);
    }


    .journey-timetable-date small {
        display: block;

        color: #94a3b8;

        font-size: 8px;
        font-weight: 850;

        letter-spacing: 0.7px;
    }


    .journey-timetable-date strong {
        display: block;

        margin-top: 4px;

        color: #0f172a;

        font-size: 12px;
        font-weight: 850;
    }


    .journey-timetable-times {
        display: flex;
        align-items: center;
        gap: 12px;
    }


    .journey-time-box span {
        display: block;

        color: #94a3b8;

        font-size: 8px;
        font-weight: 800;
    }


    .journey-time-box strong {
        display: block;

        margin-top: 3px;

        color: #0f172a;

        font-size: 15px;
        font-weight: 900;
    }


    .journey-time-arrow {
        color: #93c5fd;

        font-size: 17px;
        font-weight: 900;
    }


    .journey-timetable-extra {
        display: flex;
        flex-wrap: wrap;

        gap: 7px;

        margin-top: 9px;
    }


    .journey-timetable-info-chip {
        padding: 5px 7px;

        border-radius: 8px;

        color: #64748b;

        background: #ffffff;

        border:
            1px solid #e2e8f0;

        font-size: 8px;
        font-weight: 750;
    }


    .journey-schedule-status {
        min-width: 86px;

        padding: 7px 9px;

        text-align: center;

        border-radius: 999px;

        font-size: 9px;
        font-weight: 850;
    }


    .journey-schedule-status.green {
        color: #15803d;

        background:
            rgba(34, 197, 94, 0.10);
    }


    .journey-schedule-status.amber {
        color: #b45309;

        background:
            rgba(245, 158, 11, 0.11);
    }


    .journey-schedule-status.red {
        color: #b91c1c;

        background:
            rgba(239, 68, 68, 0.10);
    }


    .journey-schedule-status.blue {
        color: #1d4ed8;

        background:
            rgba(37, 99, 235, 0.10);
    }


    .journey-schedule-status.purple {
        color: #7c3aed;

        background:
            rgba(124, 58, 237, 0.10);
    }


    /* =========================================================
       EMPTY STATE
    ========================================================= */

    .journey-empty {
        min-height: 220px;

        display: flex;
        flex-direction: column;

        align-items: center;
        justify-content: center;

        padding: 32px;

        text-align: center;

        border-radius: 18px;

        background: #f8fafc;

        border:
            1px dashed #cbd5e1;
    }


    .journey-empty-icon {
        width: 58px;
        height: 58px;

        display: grid;
        place-items: center;

        margin-bottom: 14px;

        border-radius: 18px;

        color: #2563eb;

        background:
            rgba(37, 99, 235, 0.09);
    }


    .journey-empty-icon svg {
        width: 28px;
        height: 28px;
    }


    .journey-empty h3 {
        margin: 0;

        color: #0f172a;

        font-size: 16px;
        font-weight: 900;
    }


    .journey-empty p {
        max-width: 430px;

        margin: 8px 0 0;

        color: #64748b;

        font-size: 10px;

        line-height: 1.7;
    }


    /* =========================================================
       DARK MODE
    ========================================================= */

    [data-theme="dark"]
    .journey-back-btn,

    [data-theme="dark"]
    .journey-stat-card,

    [data-theme="dark"]
    .journey-card {
        background: #0f1c2e;

        border-color:
            rgba(148, 163, 184, 0.14);
    }


    [data-theme="dark"]
    .journey-stat-value,

    [data-theme="dark"]
    .journey-card-header h2,

    [data-theme="dark"]
    .journey-timeline-content strong,

    [data-theme="dark"]
    .journey-summary-item strong,

    [data-theme="dark"]
    .journey-timetable-date strong,

    [data-theme="dark"]
    .journey-time-box strong,

    [data-theme="dark"]
    .journey-empty h3 {
        color: #f8fafc;
    }


    [data-theme="dark"]
    .journey-summary-item,

    [data-theme="dark"]
    .journey-timetable-card,

    [data-theme="dark"]
    .journey-empty {
        background: #132238;

        border-color:
            rgba(148, 163, 184, 0.14);
    }


    [data-theme="dark"]
    .journey-timetable-info-chip {
        color: #cbd5e1;

        background: #0f1c2e;

        border-color:
            rgba(148, 163, 184, 0.14);
    }


    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @@media (max-width: 1180px) {

        .journey-hero {
            grid-template-columns: 1fr;
        }


        .journey-hero-visual {
            display: none;
        }


        .journey-main-grid {
            grid-template-columns: 1fr;
        }


        .journey-side-column {
            position: static;

            display: grid;

            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }
    }


    @@media (max-width: 930px) {

        .journey-stats-grid {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }


        .journey-timetable-card {
            grid-template-columns:
                130px
                minmax(0, 1fr);
        }


        .journey-schedule-status {
            grid-column: 1 / -1;

            justify-self: start;
        }
    }


    @@media (max-width: 650px) {

        .journey-top-actions {
            align-items: stretch;
            flex-direction: column;
        }


        .journey-top-action-group {
            display: grid;
            grid-template-columns: 1fr;
        }


        .journey-back-btn,
        .journey-map-btn,
        .journey-favorite-btn {
            width: 100%;
        }


        .journey-favorite-form {
            width: 100%;
        }


        .journey-hero {
            min-height: auto;

            padding: 32px 24px;
        }


        .journey-hero h1 {
            font-size: 38px;
        }


        .journey-stats-grid {
            grid-template-columns: 1fr;
        }


        .journey-side-column {
            grid-template-columns: 1fr;
        }


        .journey-card {
            padding: 20px;
        }


        .journey-map {
            height: 380px;
            min-height: 380px;
        }


        .journey-map-loading,
        .journey-map-error {
            min-height: 380px;
        }


        .journey-timetable-card {
            grid-template-columns: 1fr;
        }


        .journey-timetable-times {
            justify-content: space-between;
        }
    }


    @@media (prefers-reduced-motion: reduce) {

        .journey-reveal,
        .journey-live-dot,
        .journey-hero::before,
        .journey-hero::after,
        .journey-visual-orbit,
        .journey-moving-bus,
        .journey-visual-info,
        .journey-map-loading-dot {
            animation: none !important;

            opacity: 1 !important;

            transform: none !important;
        }
    }

    /* =========================================================
    CRITICAL SVG ICON SIZE FIX
    Prevent inline UI icons from expanding across the page
    ========================================================= */

    .journey-top-actions svg,
    .journey-hero svg,
    .journey-stats-grid svg,
    .journey-card-header-icon svg,
    .journey-summary-icon svg,
    .journey-empty-icon svg,
    .journey-timetable-card svg,
    .journey-next-departure svg,
    .journey-visual-info-icon svg,
    .journey-moving-bus svg {
        display: block !important;
        width: 20px !important;
        height: 20px !important;
        min-width: 20px !important;
        min-height: 20px !important;
        max-width: 20px !important;
        max-height: 20px !important;
        flex: 0 0 20px !important;
        overflow: hidden !important;
    }


    /* Top action icons */

    .journey-back-btn svg,
    .journey-map-btn svg,
    .journey-favorite-btn svg {
        width: 17px !important;
        height: 17px !important;
        min-width: 17px !important;
        min-height: 17px !important;
        max-width: 17px !important;
        max-height: 17px !important;
    }


    /* Hero direction arrow */

    .journey-hero-direction svg {
        width: 20px !important;
        height: 20px !important;
        min-width: 20px !important;
        min-height: 20px !important;
        max-width: 20px !important;
        max-height: 20px !important;
    }


    /* Hero badge icons */

    .journey-hero-badge svg {
        width: 14px !important;
        height: 14px !important;
        min-width: 14px !important;
        min-height: 14px !important;
        max-width: 14px !important;
        max-height: 14px !important;
    }


    /* Animated bus icon */

    .journey-moving-bus svg {
        width: 29px !important;
        height: 29px !important;
        min-width: 29px !important;
        min-height: 29px !important;
        max-width: 29px !important;
        max-height: 29px !important;
    }


    /* Journey statistic icons */

    .journey-stat-icon {
        width: 43px !important;
        height: 43px !important;
        min-width: 43px !important;
        min-height: 43px !important;
        max-width: 43px !important;
        max-height: 43px !important;

        display: grid !important;
        place-items: center !important;

        overflow: hidden !important;
    }


    .journey-stat-icon svg {
        width: 21px !important;
        height: 21px !important;
        min-width: 21px !important;
        min-height: 21px !important;
        max-width: 21px !important;
        max-height: 21px !important;
    }


    /* Card heading icons */

    .journey-card-header-icon {
        width: 48px !important;
        height: 48px !important;
        min-width: 48px !important;
        min-height: 48px !important;
        max-width: 48px !important;
        max-height: 48px !important;

        display: grid !important;
        place-items: center !important;

        overflow: hidden !important;
    }


    .journey-card-header-icon svg {
        width: 23px !important;
        height: 23px !important;
        min-width: 23px !important;
        min-height: 23px !important;
        max-width: 23px !important;
        max-height: 23px !important;
    }


    /* Journey summary icons */

    .journey-summary-icon {
        width: 40px !important;
        height: 40px !important;
        min-width: 40px !important;
        min-height: 40px !important;
        max-width: 40px !important;
        max-height: 40px !important;

        display: grid !important;
        place-items: center !important;

        overflow: hidden !important;
    }


    .journey-summary-icon svg {
        width: 19px !important;
        height: 19px !important;
        min-width: 19px !important;
        min-height: 19px !important;
        max-width: 19px !important;
        max-height: 19px !important;
    }


    /* Empty state icons */

    .journey-empty-icon {
        width: 58px !important;
        height: 58px !important;
        min-width: 58px !important;
        min-height: 58px !important;
        max-width: 58px !important;
        max-height: 58px !important;

        display: grid !important;
        place-items: center !important;

        overflow: hidden !important;
    }


    .journey-empty-icon svg {
        width: 28px !important;
        height: 28px !important;
        min-width: 28px !important;
        min-height: 28px !important;
        max-width: 28px !important;
        max-height: 28px !important;
    }


    /* Animated hero floating information icon */

    .journey-visual-info-icon {
        width: 42px !important;
        height: 42px !important;
        min-width: 42px !important;
        min-height: 42px !important;
        max-width: 42px !important;
        max-height: 42px !important;

        display: grid !important;
        place-items: center !important;

        overflow: hidden !important;
    }


    .journey-visual-info-icon svg {
        width: 22px !important;
        height: 22px !important;
        min-width: 22px !important;
        min-height: 22px !important;
        max-width: 22px !important;
        max-height: 22px !important;
    }


    /* Protect every UI icon container */

    .journey-stat-icon,
    .journey-card-header-icon,
    .journey-summary-icon,
    .journey-empty-icon,
    .journey-visual-info-icon,
    .journey-moving-bus {
        position: relative !important;
        flex-shrink: 0 !important;
    }


    /* Important:
    Do not apply global SVG sizing to the Leaflet map,
    because Leaflet uses SVG internally for route lines.
    */

    #customerRouteMap svg {
        max-width: none;
        max-height: none;
    }

    .journey-details-page svg:not(.leaflet-zoom-animated) {
    vertical-align: middle;
    }

</style>


<div class="journey-details-page">


    <!-- =====================================================
         TOP ACTIONS
    ====================================================== -->

    <section class="journey-top-actions journey-reveal">

        <a asp-controller="CustomerRoutes"
           asp-action="Index"
           class="journey-back-btn">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true">

                <path d="M19 12H5">
                </path>

                <path d="M11 18l-6-6 6-6">
                </path>

            </svg>

            Back to Explore Routes

        </a>


        <div class="journey-top-action-group">


            @if (isFavorite)
            {
                <form asp-controller="CustomerRoutes"
                      asp-action="RemoveFavorite"
                      method="post"
                      class="journey-favorite-form">

                    @Html.AntiForgeryToken()


                    <input type="hidden"
                           name="routeId"
                           value="@Model.Id" />


                    <input type="hidden"
                           name="returnToDetails"
                           value="true" />


                    <button type="submit"
                            class="journey-favorite-btn saved">

                        <svg viewBox="0 0 24 24"
                             fill="currentColor"
                             stroke="currentColor"
                             stroke-width="1.5"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">

                            <path d="M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10z">
                            </path>

                        </svg>

                        Saved Route

                    </button>

                </form>
            }
            else
            {
                <form asp-controller="CustomerRoutes"
                      asp-action="AddFavorite"
                      method="post"
                      class="journey-favorite-form">

                    @Html.AntiForgeryToken()


                    <input type="hidden"
                           name="routeId"
                           value="@Model.Id" />


                    <input type="hidden"
                           name="returnToDetails"
                           value="true" />


                    <button type="submit"
                            class="journey-favorite-btn">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">

                            <path d="M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10z">
                            </path>

                        </svg>

                        Save Route

                    </button>

                </form>
            }


            <a href="@mapUrl"
               target="_blank"
               rel="noopener noreferrer"
               class="journey-map-btn">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">

                    <path d="M9 18l-6 3V6l6-3 6 3 6-3v15l-6 3-6-3z">
                    </path>

                    <path d="M9 3v15">
                    </path>

                    <path d="M15 6v15">
                    </path>

                </svg>

                Open in Google Maps

            </a>

        </div>

    </section>


    <!-- =====================================================
         ALERTS
    ====================================================== -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="journey-alert success">

            @TempData["SuccessMessage"]

        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="journey-alert warning">

            @TempData["ErrorMessage"]

        </div>
    }


    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="journey-hero journey-reveal"
             style="--delay: 0.05s;">

        <div class="journey-hero-copy">

            <div class="journey-hero-eyebrow">

                <span class="journey-live-dot"></span>

                ACTIVE SRMSS JOURNEY

            </div>


            <h1>

                @Model.RouteName

            </h1>


            <div class="journey-hero-direction">

                <span>
                    @Model.StartPoint
                </span>


                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">

                    <path d="M5 12h14">
                    </path>

                    <path d="M13 6l6 6-6 6">
                    </path>

                </svg>


                <span>
                    @Model.EndPoint
                </span>

            </div>


            <p class="journey-hero-description">

                Explore every stop along this route, review upcoming
                timetables, check assigned drivers and vehicles,
                view current trip status and open the complete journey
                on an interactive map.

            </p>


            <div class="journey-hero-badges">


                <span class="journey-hero-badge">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         aria-hidden="true">

                        <circle cx="12"
                                cy="12"
                                r="9">
                        </circle>

