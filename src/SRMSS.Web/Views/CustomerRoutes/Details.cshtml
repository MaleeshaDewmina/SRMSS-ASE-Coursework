                function escapeHtml(value) {

                    if (
                        value === null ||
                        value === undefined
                    ) {
                        return "";
                    }


                    return String(value)

                        .replaceAll(
                            "&",
                            "&amp;"
                        )

                        .replaceAll(
                            "<",
                            "&lt;"
                        )

                        .replaceAll(
                            ">",
