@model IEnumerable<SRMSS.Web.Models.AppUser>

@{
    ViewData["Title"] = "User Management";

    string currentRole = ViewBag.CurrentRole ?? "";
    string roleFilter = ViewBag.RoleFilter ?? "";
    string search = ViewBag.Search ?? "";
}

<style>
    body {
        background: #f4f8fc;
    }

    .page-shell {
        padding: 28px;
    }

    .page-header {
        background: #06111f;
        color: white;
        border-radius: 26px;
        padding: 28px;
        margin-bottom: 22px;
    }

    .page-header h1 {
        margin: 0 0 8px;
        font-size: 32px;
        font-weight: 900;
    }

    .page-header p {
        margin: 0;
        color: #cbd5e1;
    }

    .toolbar {
        background: white;
        border: 1px solid #d8e6f3;
        border-radius: 22px;
        padding: 18px;
        margin-bottom: 20px;
        display: grid;
        grid-template-columns: 1fr 220px 160px;
        gap: 12px;
    }

    input,
    select {
        width: 100%;
        padding: 13px 14px;
        border-radius: 14px;
        border: 1px solid #cbd5e1;
        outline: none;
        box-sizing: border-box;
    }

    input:focus,
    select:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
    }

    .btn {
        display: inline-block;
        padding: 12px 16px;
        border-radius: 14px;
        text-decoration: none;
        border: none;
        cursor: pointer;
        font-weight: 800;
    }

    .btn-primary {
        background: #2563eb;
        color: white;
    }

    .btn-primary:hover {
        background: #1d4ed8;
        color: white;
    }

    .btn-warning {
        background: #f59e0b;
        color: white;
    }

    .btn-danger {
        background: #ef4444;
        color: white;
    }

    .btn-success {
        background: #16a34a;
        color: white;
    }

    .btn-secondary {
        background: #64748b;
        color: white;
    }

    .action-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .create-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .table-card {
        background: white;
        border-radius: 24px;
        border: 1px solid #d8e6f3;
        overflow: hidden;
        box-shadow: 0 14px 38px rgba(15, 23, 42, 0.06);
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        background: #eaf2fb;
        color: #0f172a;
        text-align: left;
        padding: 15px;
        font-size: 14px;
    }

    td {
        padding: 15px;
        border-top: 1px solid #e2e8f0;
        color: #334155;
        vertical-align: middle;
    }

    .role-badge,
    .status-badge {
        display: inline-block;
        padding: 7px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 900;
    }

    .role-badge {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .status-active {
        background: #dcfce7;
        color: #166534;
    }

    .status-inactive {
        background: #fee2e2;
        color: #991b1b;
    }

    .success-message {
        background: #dcfce7;
        color: #166534;
        border-radius: 16px;
        padding: 14px 16px;
        font-weight: 800;
        margin-bottom: 18px;
    }

    @@media (max-width: 850px) {
        .toolbar {
            grid-template-columns: 1fr;
        }

        table {
            min-width: 850px;
        }

        .table-card {
            overflow-x: auto;
        }
    }
</style>

<div class="page-shell">
    <div class="page-header">
        <h1>User Management</h1>
        <p>Manage SRMSS platform accounts based on your role permissions.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="success-message">@TempData["Success"]</div>
    }

    <div class="create-row">
        <a href="/Dashboard" class="btn btn-secondary">Back to Dashboard</a>
        <a href="/Users/Create" class="btn btn-primary">Create User</a>
    </div>

    <form method="get" class="toolbar">
        <input type="text" name="search" value="@search" placeholder="Search by name, username or email" />

        <select name="roleFilter">
            <option value="">All Roles</option>

            @if (currentRole == "SuperAdmin")
            {
                <option value="SuperAdmin" selected="@(roleFilter == "SuperAdmin")">SuperAdmin</option>
                <option value="Admin" selected="@(roleFilter == "Admin")">Admin</option>
            }

            <option value="User" selected="@(roleFilter == "User")">User</option>
            <option value="Customer" selected="@(roleFilter == "Customer")">Customer</option>
        </select>

        <button type="submit" class="btn btn-primary">Filter</button>
    </form>

    <div class="table-card">
        <table>
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.Username</td>
                        <td>@user.Email</td>
                        <td><span class="role-badge">@user.Role</span></td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="status-badge status-active">Active</span>
                            }
                            else
                            {
                                <span class="status-badge status-inactive">Inactive</span>
                            }
                        </td>
                        <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td>
                            <div class="action-row">
                                <a href="/Users/Edit?id=@user.Id" class="btn btn-warning">Edit</a>

                                <form asp-action="ToggleStatus" asp-controller="Users" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />

                                    @if (user.IsActive)
                                    {
                                        <button type="submit" class="btn btn-danger">Deactivate</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-success">Activate</button>
                                    }
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>