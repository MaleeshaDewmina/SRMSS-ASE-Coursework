@model IEnumerable<SRMSS.Web.Models.Schedule>

@{
    ViewData["Title"] = "Trip Status Board";
    ViewData["PageTitle"] = "Trip Status Board";
    ViewData["PageSubtitle"] = "Monitor scheduled, delayed, departed, completed and cancelled trips.";

    var selectedStatus = ViewBag.SelectedStatus as string ?? "All";
    var searchValue = ViewBag.Search as string;
    var currentRole = Context.Session.GetString(SessionKeys.Role) ?? string.Empty;
    var canUpdateStatus = currentRole == "SuperAdmin" || currentRole == "Admin";
}

<div class="trip-status-hero">
    <div>
        <span class="trip-status-pill">Live Operations</span>
        <h2>Trip Status Board</h2>
        <p>
            @if (canUpdateStatus)
            {
                <text>Monitor route schedules, update current trip status and identify delayed or cancelled trips quickly.</text>
            }
            else
            {
                <text>Monitor route schedules and identify delayed, departed, completed or cancelled trips.</text>
            }
        </p>
    </div>

    <div class="trip-status-hero-card">
        <strong>@ViewBag.TotalTrips</strong>
        <span>Total Trips</span>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success srmss-alert">
        @TempData["SuccessMessage"]
    </div>
}

<div class="trip-status-metrics">
    <div class="trip-status-metric-card">
        <span>Total</span>
        <strong>@ViewBag.TotalTrips</strong>
    </div>

    <div class="trip-status-metric-card">
        <span>Scheduled</span>
        <strong>@ViewBag.ScheduledTrips</strong>
    </div>

    <div class="trip-status-metric-card success">
        <span>On Time</span>
        <strong>@ViewBag.OnTimeTrips</strong>
    </div>

    <div class="trip-status-metric-card">
        <span>Departed</span>
        <strong>@ViewBag.DepartedTrips</strong>
    </div>

    <div class="trip-status-metric-card warning">
        <span>Delayed</span>
        <strong>@ViewBag.DelayedTrips</strong>
    </div>

    <div class="trip-status-metric-card success">
        <span>Completed</span>
        <strong>@ViewBag.CompletedTrips</strong>
    </div>

    <div class="trip-status-metric-card danger">
        <span>Cancelled</span>
        <strong>@ViewBag.CancelledTrips</strong>
    </div>
</div>

<div class="srmss-card mb-4">
    <h3 class="card-title">Filter Trip Status</h3>
    <p class="card-subtitle">
        Search by route, start point, end point, driver or vehicle registration number.
    </p>

    <form asp-controller="TripStatus" asp-action="Index" method="get" class="trip-status-filter-grid">
        <div>
            <label class="form-label">Search</label>
            <input name="search"
                   value="@searchValue"
                   class="form-control"
                   placeholder="Example: Colombo, Badulla, driver name, vehicle number" />
        </div>

        <div>
            <label class="form-label">Status</label>
            <select name="status" class="form-control">
                <option value="All" selected="@(selectedStatus == "All")">All</option>
                <option value="Scheduled" selected="@(selectedStatus == "Scheduled")">Scheduled</option>
                <option value="On Time" selected="@(selectedStatus == "On Time")">On Time</option>
                <option value="Departed" selected="@(selectedStatus == "Departed")">Departed</option>
                <option value="Delayed" selected="@(selectedStatus == "Delayed")">Delayed</option>
                <option value="Completed" selected="@(selectedStatus == "Completed")">Completed</option>
                <option value="Cancelled" selected="@(selectedStatus == "Cancelled")">Cancelled</option>
            </select>
        </div>

        <div class="trip-status-filter-actions">
            <button type="submit" class="srmss-btn primary w-100">
                Apply Filter
            </button>
        </div>

        <div class="trip-status-filter-actions">
            <a asp-controller="TripStatus" asp-action="Index" class="srmss-btn secondary w-100">
                Clear
            </a>
        </div>
    </form>
</div>

<div class="srmss-card">
    <h3 class="card-title">Trip Status List</h3>
    <p class="card-subtitle">
        @(canUpdateStatus ? "Update trip status directly from the operation board." : "View current operational trip status in real time.")
    </p>

    <div class="table-responsive">
        <table class="srmss-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Route</th>
                    <th>Time</th>
                    <th>Driver</th>
                    <th>Vehicle</th>
                    <th>Current Status</th>
                    @if (canUpdateStatus)
                    {
                        <th>Update Status</th>
                    }
                </tr>
            </thead>

            <tbody>
                @if (Model.Any())
                {
                    foreach (var schedule in Model)
                    {
                        <tr>
                            <td>@schedule.ScheduleDate.ToString("dd MMM yyyy")</td>

                            <td>
                                <strong>@schedule.TransportRoute?.RouteName</strong>
                                <small class="d-block text-muted">
                                    @schedule.TransportRoute?.StartPoint → @schedule.TransportRoute?.EndPoint
                                </small>
                            </td>

                            <td>
                                @schedule.DepartureTime.ToString(@"hh\:mm")
                                -
                                @schedule.ArrivalTime.ToString(@"hh\:mm")
                            </td>

                            <td>@schedule.Driver?.FullName</td>

                            <td>@schedule.Vehicle?.RegistrationNumber</td>

                            <td>
                                @if (schedule.Status == "Delayed")
                                {
                                    <span class="status-pill amber">Delayed</span>
                                }
                                else if (schedule.Status == "Cancelled")
                                {
                                    <span class="status-pill red">Cancelled</span>
                                }
                                else if (schedule.Status == "Completed")
                                {
                                    <span class="status-pill blue">Completed</span>
                                }
                                else if (schedule.Status == "Departed")
                                {
                                    <span class="status-pill purple">Departed</span>
                                }
                                else
                                {
                                    <span class="status-pill green">@schedule.Status</span>
                                }
                            </td>

                            @if (canUpdateStatus)
                            {
                                <td>
                                    <form asp-controller="TripStatus"
                                          asp-action="UpdateStatus"
                                          method="post"
                                          class="trip-status-update-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="id" value="@schedule.Id" />

                                        <select name="status" class="form-control form-control-sm">
                                            <option value="Scheduled" selected="@(schedule.Status == "Scheduled")">Scheduled</option>
                                            <option value="On Time" selected="@(schedule.Status == "On Time")">On Time</option>
                                            <option value="Departed" selected="@(schedule.Status == "Departed")">Departed</option>
                                            <option value="Delayed" selected="@(schedule.Status == "Delayed")">Delayed</option>
                                            <option value="Completed" selected="@(schedule.Status == "Completed")">Completed</option>
                                            <option value="Cancelled" selected="@(schedule.Status == "Cancelled")">Cancelled</option>
                                        </select>

                                        <button type="submit" class="srmss-btn primary small-btn">
                                            Update
                                        </button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(canUpdateStatus ? 7 : 6)" class="text-center text-muted py-4">
                            No trips found for the selected filter.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>