@model SRMSS.Web.Models.Driver

@{
    ViewData["Title"] = "Deactivate Driver";
    ViewData["PageTitle"] = "Deactivate Driver";
    ViewData["PageSubtitle"] = "Deactivate a driver profile without deleting historical schedules.";
}

<div class="srmss-card danger-panel">
    <h3 class="card-title">Deactivate Driver Profile</h3>
    <p class="card-subtitle">This action keeps schedule history but removes the driver from active operational allocation.</p>

    <div class="detail-list mb-4">
        <div><span>Driver</span><strong>@Model.FullName</strong></div>
        <div><span>License</span><strong>@Model.LicenseNumber</strong></div>
        <div><span>Status</span><strong>@Model.Status</strong></div>
        <div><span>Schedule Records</span><strong>@(Model.Schedules?.Count ?? 0)</strong></div>
    </div>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="enterprise-form-actions">
            <a asp-action="Index" class="srmss-btn secondary">Cancel</a>
            <button type="submit" class="srmss-btn danger">Deactivate Driver</button>
        </div>
    </form>
</div>


