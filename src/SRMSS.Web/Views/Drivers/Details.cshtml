@model SRMSS.Web.Models.Driver

@{
    ViewData["Title"] = "Driver Details";
    ViewData["PageTitle"] = "Driver Details";
    ViewData["PageSubtitle"] = "Complete driver profile, compliance and route schedule activity.";
    string role = Context.Session.GetString(SessionKeys.Role) ?? string.Empty;
    bool canManage = role == "SuperAdmin" || role == "Admin";
    bool licenseExpired = Model.LicenseExpiryDate < DateTime.Today;
    bool licenseExpiring = Model.LicenseExpiryDate >= DateTime.Today && Model.LicenseExpiryDate <= DateTime.Today.AddDays(30);
}

<div class="module-hero fleet-hero mb-4">
    <div>
        <span class="module-kicker">Driver Profile</span>
        <h2>@Model.FullName</h2>
        <p>@Model.AssignedDepot | @Model.ShiftType shift | @Model.Status</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Index" class="srmss-btn secondary">Back</a>
        @if (canManage)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="srmss-btn primary">Edit Driver</a>
        }
    </div>
</div>

<div class="enterprise-detail-grid">
    <div class="srmss-card">
        <h3 class="card-title">Identity and Contact</h3>
        <div class="detail-list">
            <div><span>NIC</span><strong>@Model.NIC</strong></div>
            <div><span>Employee Number</span><strong>@(Model.EmployeeNumber ?? "Not assigned")</strong></div>
            <div><span>Phone</span><strong>@Model.Phone</strong></div>
            <div><span>Email</span><strong>@(Model.Email ?? "Not provided")</strong></div>
            <div><span>Address</span><strong>@(Model.Address ?? "Not provided")</strong></div>
            <div><span>Emergency Contact</span><strong>@(Model.EmergencyContactName ?? "Not provided") @(Model.EmergencyContactPhone ?? "")</strong></div>
        </div>
    </div>

    <div class="srmss-card amber">
        <h3 class="card-title">License and Compliance</h3>
        <div class="detail-list">
            <div><span>License Number</span><strong>@Model.LicenseNumber</strong></div>
            <div><span>Expiry Date</span><strong class="@(licenseExpired ? "text-danger" : licenseExpiring ? "text-warning" : "")">@Model.LicenseExpiryDate.ToString("dd MMM yyyy")</strong></div>
            <div><span>Compliance Status</span><strong>@(licenseExpired ? "Expired" : licenseExpiring ? "Expiring Soon" : "Valid")</strong></div>
            <div><span>Hire Date</span><strong>@Model.HireDate.ToString("dd MMM yyyy")</strong></div>
            <div><span>System Status</span><strong>@(Model.IsActive ? "Active" : "Inactive")</strong></div>
        </div>
    </div>
</div>

<div class="srmss-card mt-4">
    <h3 class="card-title">Upcoming and Recent Schedule Assignments</h3>
    <div class="table-responsive">
        <table class="srmss-table">
            <thead><tr><th>Date</th><th>Route</th><th>Vehicle</th><th>Time</th><th>Status</th></tr></thead>
            <tbody>
                @if (Model.Schedules != null && Model.Schedules.Any())
                {
                    foreach (var schedule in Model.Schedules.OrderByDescending(s => s.ScheduleDate).Take(10))
                    {
                        <tr>
                            <td>@schedule.ScheduleDate.ToString("dd MMM yyyy")</td>
                            <td>@(schedule.TransportRoute?.RouteName ?? "Unknown Route")</td>
                            <td>@(schedule.Vehicle?.RegistrationNumber ?? "Unknown Vehicle")</td>
                            <td>@(schedule.DepartureTime.ToString(@"hh\:mm")) - @(schedule.ArrivalTime.ToString(@"hh\:mm"))</td>
                            <td><span class="status-pill blue">@schedule.Status</span></td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No schedule assignments found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

