@model IEnumerable<SRMSS.Web.Models.Driver>

@{
    ViewData["Title"] = "Driver Management";
    ViewData["PageTitle"] = "Driver Management";
    ViewData["PageSubtitle"] = "Enterprise driver profiles, license monitoring and availability control.";

    string currentRole = Context.Session.GetString(SessionKeys.Role) ?? string.Empty;
    bool canManage = currentRole == "SuperAdmin" || currentRole == "Admin";
    var depots = ViewBag.Depots as List<string> ?? new List<string>();
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success srmss-alert">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger srmss-alert">@TempData["ErrorMessage"]</div>
}

<div class="module-hero fleet-hero">
    <div>
        <span class="module-kicker">Fleet Workforce</span>
        <h2>Driver Operations Center</h2>
        <p>Manage professional driver records, license validity, depot allocation and schedule readiness from one control board.</p>
    </div>
    @if (canManage)
    {
        <a asp-action="Create" class="srmss-btn primary">+ Add Driver</a>
    }
</div>

<div class="metric-grid">
    <div class="metric-card"><div class="metric-icon">D</div><div><p>Total Drivers</p><h3>@ViewBag.TotalDrivers</h3></div></div>
    <div class="metric-card"><div class="metric-icon green">A</div><div><p>Available</p><h3>@ViewBag.AvailableDrivers</h3></div></div>
    <div class="metric-card"><div class="metric-icon amber">S</div><div><p>Assigned</p><h3>@ViewBag.AssignedDrivers</h3></div></div>
    <div class="metric-card"><div class="metric-icon red">!</div><div><p>Expiring / Expired</p><h3>@((ViewBag.ExpiringSoon ?? 0) + (ViewBag.ExpiredLicenses ?? 0))</h3></div></div>
</div>

<div class="srmss-card mb-4">
    <h3 class="card-title">Search and Filter Drivers</h3>
    <p class="card-subtitle">Search by name, NIC, license number, phone, email or employee number.</p>
    <form method="get" class="enterprise-filter-grid">
        <div>
            <label class="form-label">Search</label>
            <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Example: Kamal, B1234567, 077..." />
        </div>
        <div>
            <label class="form-label">Status</label>
            <select name="status" class="form-select">
                <option value="">All Status</option>
                <option value="Available" selected="@(ViewBag.Status == "Available")">Available</option>
                <option value="Assigned" selected="@(ViewBag.Status == "Assigned")">Assigned</option>
                <option value="On Leave" selected="@(ViewBag.Status == "On Leave")">On Leave</option>
                <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive</option>
            </select>
        </div>
        <div>
            <label class="form-label">Depot</label>
            <select name="depot" class="form-select">
                <option value="">All Depots</option>
                @foreach (var depot in depots)
                {
                    <option value="@depot" selected="@(ViewBag.Depot == depot)">@depot</option>
                }
            </select>
        </div>
        <div class="filter-button-area">
            <button type="submit" class="srmss-btn primary w-100">Apply</button>
        </div>
        <div class="filter-button-area">
            <a asp-action="Index" class="srmss-btn secondary w-100">Clear</a>
        </div>
    </form>
</div>

<div class="srmss-card">
    <h3 class="card-title">Driver List</h3>
    <p class="card-subtitle">License alerts are highlighted automatically for operational safety.</p>

    <div class="table-responsive">
        <table class="srmss-table enterprise-table">
            <thead>
                <tr>
                    <th>Driver</th>
                    <th>License</th>
                    <th>Contact</th>
                    <th>Depot</th>
                    <th>Shift</th>
                    <th>Status</th>
                    <th>Schedules</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var driver in Model)
                    {
                        bool expired = driver.LicenseExpiryDate < DateTime.Today;
                        bool expiring = driver.LicenseExpiryDate >= DateTime.Today && driver.LicenseExpiryDate <= DateTime.Today.AddDays(30);
                        string statusClass = driver.Status == "Available" ? "green" : driver.Status == "Assigned" ? "blue" : driver.Status == "Inactive" ? "red" : "amber";

                        <tr class="@(driver.IsActive ? "" : "table-muted")">
                            <td>
                                <strong>@driver.FullName</strong>
                                <small class="d-block text-muted">NIC: @driver.NIC</small>
                                @if (!string.IsNullOrWhiteSpace(driver.EmployeeNumber))
                                {
                                    <small class="d-block text-muted">Emp: @driver.EmployeeNumber</small>
                                }
                            </td>
                            <td>
                                <strong>@driver.LicenseNumber</strong>
                                <small class="d-block @(expired ? "text-danger" : expiring ? "text-warning" : "text-muted")">
                                    Exp: @driver.LicenseExpiryDate.ToString("dd MMM yyyy")
                                </small>
                            </td>
                            <td>
                                @driver.Phone
                                @if (!string.IsNullOrWhiteSpace(driver.Email))
                                {
                                    <small class="d-block text-muted">@driver.Email</small>
                                }
                            </td>
                            <td>@driver.AssignedDepot</td>
                            <td>@driver.ShiftType</td>
                            <td><span class="status-pill @statusClass">@driver.Status</span></td>
                            <td><span class="status-pill blue">@(driver.Schedules?.Count ?? 0)</span></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@driver.Id" class="action-link">Details</a>
                                @if (canManage)
                                {
                                    <a asp-action="Edit" asp-route-id="@driver.Id" class="action-link">Edit</a>
                                    @if (driver.IsActive)
                                    {
                                        <a asp-action="Delete" asp-route-id="@driver.Id" class="action-link danger">Deactivate</a>
                                    }
                                    else
                                    {
                                        <form asp-action="Reactivate" asp-route-id="@driver.Id" method="post" class="inline-action-form">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="action-link button-link">Reactivate</button>
                                        </form>
                                    }
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No drivers found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>


