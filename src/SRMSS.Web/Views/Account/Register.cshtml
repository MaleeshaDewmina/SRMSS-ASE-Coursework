@model SRMSS.Web.ViewModels.RegisterCustomerViewModel

@{
    Layout = null;
    bool googleEnabled = ViewBag.GoogleEnabled as bool? ?? false;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/srmss-logo-square.png" />
    <meta name="theme-color" content="#071525" />
    <title>Create customer account - SRMSS</title>

    <style>
        * { box-sizing: border-box; }
        html, body { margin: 0; min-height: 100%; }

        body {
            min-height: 100vh;
            font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            color: #0f172a;
            background:
                radial-gradient(circle at 10% 12%, rgba(56,189,248,.18), transparent 32%),
                radial-gradient(circle at 92% 88%, rgba(37,99,235,.22), transparent 34%),
                linear-gradient(135deg, #04101d 0%, #071a2f 45%, #0b2b50 100%);
        }

        .register-page {
            min-height: 100vh;
            display: grid;
            grid-template-columns: minmax(420px, .92fr) minmax(520px, 1.08fr);
            gap: 22px;
            padding: 26px;
        }

        .form-panel {
            min-height: calc(100vh - 52px);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 30px;
            background: rgba(255,255,255,.95);
            border: 1px solid rgba(255,255,255,.55);
            box-shadow: 0 30px 80px rgba(2,12,27,.28);
            animation: revealLeft .7s cubic-bezier(.2,.8,.2,1) both;
        }

        .form-wrap {
            width: min(470px, calc(100% - 52px));
            padding: 28px 0;
        }

        .brand-logo {
            width: 190px;
            display: block;
            margin-bottom: 14px;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 10px;
            border-radius: 999px;
            background: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #dbeafe;
            font-size: 10px;
            font-weight: 900;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        h1 {
            margin: 12px 0 0;
            color: #071525;
            font-size: clamp(32px, 4vw, 43px);
            letter-spacing: -1.5px;
            line-height: 1.05;
            font-weight: 900;
        }

        .subtitle {
            margin: 11px 0 21px;
            color: #64748b;
            font-size: 13px;
            line-height: 1.65;
        }

        .alert {
            padding: 12px 14px;
            margin-bottom: 15px;
            border-radius: 14px;
            background: #fff1f2;
            color: #9f1239;
            border: 1px solid #fecdd3;
            font-size: 12px;
            font-weight: 750;
        }

        .grid-two {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .field { margin-bottom: 13px; }
        .field label { display: block; margin-bottom: 6px; color: #334155; font-size: 11px; font-weight: 850; }

        .input-shell { position: relative; display: flex; align-items: center; }
        .input-icon { position: absolute; left: 13px; width: 18px; height: 18px; color: #64748b; pointer-events: none; }

        .input-shell input {
            width: 100%;
            height: 49px;
            padding: 0 42px;
            border: 1px solid #dce7f3;
            border-radius: 14px;
            background: #f8fbff;
            outline: none;
            font: inherit;
            font-size: 13px;
            transition: border-color .2s ease, box-shadow .2s ease, background .2s ease, transform .2s ease;
        }

        .input-shell input:focus {
            border-color: #60a5fa;
            background: white;
            box-shadow: 0 0 0 4px rgba(37,99,235,.10);
            transform: translateY(-1px);
        }

        .input-shell:focus-within .input-icon { color: #2563eb; }
        .validation { display: block; margin-top: 4px; color: #be123c; font-size: 10px; font-weight: 700; }

        .btn-primary {
            width: 100%;
            height: 50px;
            margin-top: 3px;
            border: 0;
            border-radius: 14px;
            background: linear-gradient(135deg, #2563eb, #0ea5e9);
            color: white;
            box-shadow: 0 14px 30px rgba(37,99,235,.24);
            font: inherit;
            font-size: 13px;
            font-weight: 900;
            cursor: pointer;
            transition: transform .2s ease, box-shadow .2s ease;
        }

        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 18px 36px rgba(37,99,235,.31); }

        .divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 17px 0;
            color: #94a3b8;
            font-size: 10px;
            font-weight: 850;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .divider::before, .divider::after { content: ""; flex: 1; height: 1px; background: #e2e8f0; }

        .google-btn {
            width: 100%;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            border: 1px solid #d8e3ef;
            border-radius: 14px;
            background: white;
            color: #0f172a;
            text-decoration: none;
            font-size: 12px;
            font-weight: 850;
            transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
        }

        .google-btn:hover { transform: translateY(-2px); border-color: #93c5fd; box-shadow: 0 12px 26px rgba(15,23,42,.09); }
        .google-btn svg { width: 20px; height: 20px; }

        .oauth-note { margin-top: 8px; color: #94a3b8; font-size: 10px; text-align: center; line-height: 1.5; }
        .login-link { margin-top: 17px; color: #64748b; text-align: center; font-size: 12px; }
        .login-link a { color: #1d4ed8; font-weight: 900; text-decoration: none; }

        .hero-panel {
            position: relative;
            min-height: calc(100vh - 52px);
            overflow: hidden;
            border-radius: 30px;
            background:
                linear-gradient(145deg, rgba(4,16,29,.10), rgba(2,12,27,.48)),
                url('/images/srmss-login-hero.png') center/cover no-repeat;
            border: 1px solid rgba(255,255,255,.12);
            box-shadow: 0 30px 80px rgba(2,12,27,.28);
            animation: revealRight .85s .08s cubic-bezier(.2,.8,.2,1) both;
        }

        .feature-card {
            position: absolute;
            left: 30px;
            right: 30px;
            bottom: 30px;
            padding: 24px;
            border-radius: 22px;
            background: rgba(4,18,34,.72);
            border: 1px solid rgba(255,255,255,.16);
            backdrop-filter: blur(16px);
            color: white;
            box-shadow: 0 18px 50px rgba(2,8,23,.25);
        }

        .feature-card h2 { margin: 0 0 8px; font-size: 23px; letter-spacing: -.5px; }
        .feature-card p { margin: 0; color: #cbd5e1; font-size: 13px; line-height: 1.65; }

        .feature-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9px; margin-top: 16px; }
        .feature-item { padding: 10px; border-radius: 13px; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.10); color: #e0f2fe; font-size: 10px; font-weight: 800; text-align: center; }

        @@keyframes revealLeft { from { opacity: 0; transform: translateX(-18px) scale(.985); } to { opacity: 1; transform: translateX(0) scale(1); } }
        @@keyframes revealRight { from { opacity: 0; transform: translateX(18px) scale(.985); } to { opacity: 1; transform: translateX(0) scale(1); } }

        @@media (max-width: 1020px) {
            .register-page { grid-template-columns: 1fr; padding: 16px; }
            .form-panel { min-height: calc(100vh - 32px); }
            .hero-panel { display: none; }
        }

        @@media (max-width: 560px) {
            .register-page { padding: 0; }
            .form-panel { min-height: 100vh; border-radius: 0; border: 0; }
            .form-wrap { width: min(100% - 34px, 470px); }
            .grid-two { grid-template-columns: 1fr; gap: 0; }
            .brand-logo { width: 170px; }
            h1 { font-size: 34px; }
        }
    </style>
</head>
<body>
    <main class="register-page">
        <section class="form-panel" aria-label="Create SRMSS customer account">
            <div class="form-wrap">
                <img src="~/images/srmss-logo.png" alt="SRMSS logo" class="brand-logo" />
                <div class="eyebrow">Customer self-service portal</div>
                <h1>Create your account.</h1>
                <p class="subtitle">Register to search routes, explore schedules and save your favourite transport connections.</p>

                @if (TempData["Error"] != null)
                {
                    <div class="alert">@TempData["Error"]</div>
                }

                <form asp-action="Register" asp-controller="Account" method="post" autocomplete="on">
                    @Html.AntiForgeryToken()

                    <div class="field">
                        <label asp-for="FullName">Full name</label>
                        <div class="input-shell">
                            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4.5 21a7.5 7.5 0 0 1 15 0"/></svg>
                            <input asp-for="FullName" placeholder="Your full name" autocomplete="name" />
                        </div>
                        <span asp-validation-for="FullName" class="validation"></span>
                    </div>

                    <div class="grid-two">
                        <div class="field">
                            <label asp-for="Username">Username</label>
                            <div class="input-shell">
                                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M7 12h10M9 17h6"/></svg>
                                <input asp-for="Username" placeholder="Choose username" autocomplete="username" />
                            </div>
                            <span asp-validation-for="Username" class="validation"></span>
                        </div>

                        <div class="field">
                            <label asp-for="Email">Email address</label>
                            <div class="input-shell">
                                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                                <input asp-for="Email" placeholder="name@example.com" autocomplete="email" />
                            </div>
                            <span asp-validation-for="Email" class="validation"></span>
                        </div>
                    </div>

                    <div class="grid-two">
                        <div class="field">
                            <label asp-for="Password">Password</label>
                            <div class="input-shell">
                                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                                <input asp-for="Password" placeholder="Create password" autocomplete="new-password" />
                            </div>
                            <span asp-validation-for="Password" class="validation"></span>
                        </div>

                        <div class="field">
                            <label asp-for="ConfirmPassword">Confirm password</label>
                            <div class="input-shell">
                                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><path d="M12 3 4 7v5c0 5 3.5 8 8 9 4.5-1 8-4 8-9V7l-8-4Z"/></svg>
                                <input asp-for="ConfirmPassword" placeholder="Repeat password" autocomplete="new-password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="validation"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn-primary">Create customer account</button>
                </form>

                <div class="divider">or register instantly</div>

                <a class="google-btn" href="/Account/GoogleLogin?mode=register">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M21.6 12.23c0-.71-.06-1.24-.2-1.79H12v3.4h5.52a4.7 4.7 0 0 1-2.05 3.08l-.02.11 2.98 2.31.21.02c1.92-1.77 2.96-4.38 2.96-7.13Z"/><path fill="#34A853" d="M12 22c2.7 0 4.96-.89 6.62-2.42l-3.15-2.44c-.84.57-1.98.97-3.47.97-2.6 0-4.81-1.76-5.6-4.2l-.11.01-3.1 2.39-.04.1A10 10 0 0 0 12 22Z"/><path fill="#FBBC05" d="M6.4 13.9A6.07 6.07 0 0 1 6.07 12c0-.66.12-1.3.31-1.9l-.01-.13-3.14-2.43-.1.05A10 10 0 0 0 2 12c0 1.6.38 3.11 1.06 4.42L6.4 13.9Z"/><path fill="#EA4335" d="M12 5.89c1.88 0 3.15.81 3.88 1.49l2.8-2.74C16.96 3.04 14.7 2 12 2a10 10 0 0 0-8.88 5.58l3.26 2.53C7.18 7.66 9.4 5.89 12 5.89Z"/></svg>
                    Sign up with Google
                </a>

                @if (!googleEnabled)
                {
                    <div class="oauth-note">Google OAuth activates after the included setup steps are completed.</div>
                }

                <div class="login-link">Already registered? <a href="/Account/Login">Sign in to your account</a></div>
            </div>
        </section>

        <section class="hero-panel" aria-label="SRMSS route management illustration">
            <div class="feature-card">
                <h2>Your routes, schedules and favourites in one place.</h2>
                <p>Get faster access to public transport information with a secure customer account built into SRMSS.</p>
                <div class="feature-list">
                    <div class="feature-item">Route search</div>
                    <div class="feature-item">Live schedules</div>
                    <div class="feature-item">Saved favourites</div>
                </div>
            </div>
        </section>
    </main>
</body>
</html>
