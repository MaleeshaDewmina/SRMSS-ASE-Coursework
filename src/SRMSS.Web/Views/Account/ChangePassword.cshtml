@model SRMSS.Web.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<style>
    body {
        background: #f4f8fc;
    }

    .password-shell {
        max-width: 720px;
        margin: 28px auto;
        padding: 0 18px;
    }

    .password-card {
        background: white;
        border: 1px solid #d8e6f3;
        border-radius: 28px;
        padding: 30px;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.06);
    }

    .header {
        background: #06111f;
        color: white;
        border-radius: 24px;
        padding: 26px;
        margin-bottom: 24px;
    }

    .header h1 {
        margin: 0 0 8px;
        font-size: 32px;
        font-weight: 900;
    }

    .header p {
        margin: 0;
        color: #cbd5e1;
    }

    label {
        display: block;
        margin-bottom: 8px;
        color: #334155;
        font-weight: 800;
    }

    input {
        width: 100%;
        padding: 14px 16px;
        border-radius: 14px;
        border: 1px solid #cbd5e1;
        margin-bottom: 16px;
        box-sizing: border-box;
        outline: none;
    }

    input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
    }

    .validation {
        color: #991b1b;
        display: block;
        margin-top: -10px;
        margin-bottom: 12px;
        font-size: 13px;
    }

    .hint {
        background: #e0f2fe;
        color: #075985;
        padding: 12px 14px;
        border-radius: 14px;
        margin-bottom: 16px;
        font-size: 13px;
        font-weight: 700;
    }

    .btn-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 12px;
    }

    .btn {
        display: inline-block;
        padding: 13px 18px;
        border-radius: 14px;
        text-decoration: none;
        border: none;
        cursor: pointer;
        font-weight: 900;
    }

    .btn-primary {
        background: #2563eb;
        color: white;
    }

    .btn-secondary {
        background: #64748b;
        color: white;
    }
</style>

<div class="password-shell">
    <div class="header">
        <h1>Change Password</h1>
        <p>Update your account password securely.</p>
    </div>

    <div class="password-card">
        <form asp-action="ChangePassword" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()

            <label asp-for="CurrentPassword">Current Password</label>
            <input asp-for="CurrentPassword" placeholder="Enter current password" />
            <span asp-validation-for="CurrentPassword" class="validation"></span>

            <label asp-for="NewPassword">New Password</label>
            <input asp-for="NewPassword" placeholder="Enter new password" />
            <span asp-validation-for="NewPassword" class="validation"></span>

            <label asp-for="ConfirmPassword">Confirm New Password</label>
            <input asp-for="ConfirmPassword" placeholder="Confirm new password" />
            <span asp-validation-for="ConfirmPassword" class="validation"></span>

            <div class="hint">
                New password must be at least 6 characters and different from your current password.
            </div>

            <div class="btn-row">
                <button type="submit" class="btn btn-primary">Change Password</button>
                <a href="/Account/Profile" class="btn btn-secondary">Back to Profile</a>
            </div>
        </form>
    </div>
</div>
