@model SRMSS.Web.ViewModels.LoginViewModel

@{
    Layout = null;
    bool googleEnabled = ViewBag.GoogleEnabled as bool? ?? false;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/srmss-logo-square.png" />
    <meta name="theme-color" content="#071525" />
    <title>Sign in - SRMSS</title>

    <style>
        * { box-sizing: border-box; }

        :root {
            --navy: #071525;
            --navy-soft: #0b2340;
            --blue: #2563eb;
            --cyan: #38bdf8;
            --text: #0f172a;
            --muted: #64748b;
            --border: #dce7f3;
            --surface: rgba(255, 255, 255, 0.94);
        }

        html, body { margin: 0; min-height: 100%; }

        body {
            min-height: 100vh;
            font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            color: var(--text);
            background:
                radial-gradient(circle at 12% 10%, rgba(56, 189, 248, 0.17), transparent 32%),
                radial-gradient(circle at 88% 85%, rgba(37, 99, 235, 0.20), transparent 34%),
                linear-gradient(135deg, #04101d 0%, #071a2f 45%, #0b2b50 100%);
            overflow-x: hidden;
        }

        .auth-page {
            min-height: 100vh;
            display: grid;
            grid-template-columns: minmax(430px, 0.88fr) minmax(520px, 1.12fr);
            padding: 26px;
            gap: 22px;
        }

        .auth-panel {
            position: relative;
            z-index: 2;
            min-height: calc(100vh - 52px);
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--surface);
            backdrop-filter: blur(18px);
            border: 1px solid rgba(255,255,255,0.55);
            border-radius: 30px;
            box-shadow: 0 30px 80px rgba(2, 12, 27, 0.28);
            animation: authReveal .7s cubic-bezier(.2,.8,.2,1) both;
        }

        .form-wrap {
            width: min(440px, calc(100% - 54px));
            padding: 30px 0;
        }

        .brand-logo {
            width: 210px;
            height: auto;
            display: block;
            margin: 0 0 18px;
            filter: drop-shadow(0 8px 20px rgba(15, 23, 42, 0.08));
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 10px;
            margin-bottom: 14px;
            border-radius: 999px;
            color: #1d4ed8;
            background: #eff6ff;
            border: 1px solid #dbeafe;
            font-size: 11px;
            font-weight: 900;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .eyebrow-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #22c55e;
            box-shadow: 0 0 0 5px rgba(34,197,94,.10);
        }

        h1 {
            margin: 0;
            font-size: clamp(34px, 4vw, 46px);
            line-height: 1.05;
            letter-spacing: -1.7px;
            color: #071525;
            font-weight: 900;
        }

        .subtitle {
            margin: 12px 0 24px;
            color: var(--muted);
            line-height: 1.65;
            font-size: 14px;
        }

        .alert {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 12px 14px;
            margin-bottom: 15px;
            border-radius: 14px;
            font-size: 13px;
            font-weight: 700;
            animation: alertReveal .35s ease both;
        }

        .alert-success { background: #ecfdf5; color: #166534; border: 1px solid #bbf7d0; }
        .alert-error { background: #fff1f2; color: #9f1239; border: 1px solid #fecdd3; }

        .field { margin-bottom: 15px; }

        .field label {
            display: block;
            margin-bottom: 7px;
            color: #334155;
            font-size: 12px;
            font-weight: 850;
        }

        .input-shell {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-icon {
            position: absolute;
            left: 14px;
            width: 19px;
            height: 19px;
            color: #64748b;
            pointer-events: none;
            transition: color .2s ease;
        }

        .input-shell input {
            width: 100%;
            height: 52px;
            padding: 0 48px 0 44px;
            border: 1px solid var(--border);
            border-radius: 15px;
            outline: none;
            background: #f8fbff;
            color: #0f172a;
            font: inherit;
            font-size: 14px;
            transition: border-color .2s ease, box-shadow .2s ease, background .2s ease, transform .2s ease;
        }

        .input-shell input:focus {
            border-color: #60a5fa;
            background: #fff;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, .10);
            transform: translateY(-1px);
        }

        .input-shell:focus-within .input-icon { color: var(--blue); }

        .password-toggle {
            position: absolute;
            right: 10px;
            width: 34px;
            height: 34px;
            display: grid;
            place-items: center;
            border: 0;
            border-radius: 10px;
            background: transparent;
            color: #64748b;
            cursor: pointer;
        }

        .password-toggle:hover { color: var(--blue); background: #eff6ff; }
        .password-toggle svg { width: 18px; height: 18px; }

        .validation {
            display: block;
            margin-top: 5px;
            color: #be123c;
            font-size: 11px;
            font-weight: 700;
        }

        .btn-primary {
            position: relative;
            overflow: hidden;
            width: 100%;
            height: 52px;
            margin-top: 4px;
            border: 0;
            border-radius: 15px;
            color: white;
            background: linear-gradient(135deg, #2563eb, #0ea5e9);
            box-shadow: 0 14px 30px rgba(37, 99, 235, .24);
            font: inherit;
            font-size: 14px;
            font-weight: 900;
            cursor: pointer;
            transition: transform .2s ease, box-shadow .2s ease;
        }

        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 18px 36px rgba(37, 99, 235, .31); }
        .btn-primary:active { transform: translateY(0); }

        .divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 19px 0;
            color: #94a3b8;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .08em;
        }

        .divider::before, .divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background: #e2e8f0;
        }

        .google-btn {
            width: 100%;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 11px;
            border: 1px solid #d8e3ef;
            border-radius: 15px;
            color: #0f172a;
            background: white;
            text-decoration: none;
            font-size: 13px;
            font-weight: 850;
            transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease, background .2s ease;
        }

        .google-btn:hover {
            transform: translateY(-2px);
            border-color: #93c5fd;
            box-shadow: 0 12px 26px rgba(15, 23, 42, .09);
            background: #fbfdff;
        }

        .google-btn svg { width: 20px; height: 20px; }

        .register-row {
            margin-top: 19px;
            text-align: center;
            color: #64748b;
            font-size: 13px;
        }

        .register-row a { color: #1d4ed8; font-weight: 900; text-decoration: none; }
        .register-row a:hover { color: #0ea5e9; }

        .oauth-note {
            margin-top: 10px;
            color: #94a3b8;
            text-align: center;
            font-size: 10px;
            line-height: 1.5;
        }

        .demo-details {
            margin-top: 20px;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            background: #f8fafc;
            color: #475569;
            font-size: 11px;
        }

        .demo-details summary {
            cursor: pointer;
            padding: 11px 13px;
            font-weight: 850;
            color: #334155;
        }

        .demo-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            padding: 0 13px 13px;
        }

        .demo-account {
            padding: 9px 10px;
            border-radius: 10px;
            background: white;
            border: 1px solid #e5edf6;
        }

        .hero-panel {
            position: relative;
            min-height: calc(100vh - 52px);
            overflow: hidden;
            border-radius: 30px;
            background:
                linear-gradient(145deg, rgba(4,16,29,.12), rgba(2,12,27,.46)),
                url('/images/srmss-login-hero.png') center/cover no-repeat;
            border: 1px solid rgba(255,255,255,.12);
            box-shadow: 0 30px 80px rgba(2, 12, 27, 0.28);
            animation: heroReveal .85s .08s cubic-bezier(.2,.8,.2,1) both;
        }

        .hero-glow {
            position: absolute;
            width: 520px;
            height: 520px;
            border-radius: 50%;
            right: -180px;
            top: -160px;
            background: radial-gradient(circle, rgba(125,211,252,.35), transparent 66%);
            animation: floatGlow 7s ease-in-out infinite;
        }

        .hero-overlay-card {
            position: absolute;
            left: 30px;
            right: 30px;
            bottom: 30px;
            padding: 24px;
            border-radius: 22px;
            background: rgba(4, 18, 34, .70);
            border: 1px solid rgba(255,255,255,.16);
            backdrop-filter: blur(16px);
            color: white;
            box-shadow: 0 18px 50px rgba(2,8,23,.25);
        }

        .hero-overlay-card h2 { margin: 0 0 8px; font-size: 24px; letter-spacing: -.5px; }
        .hero-overlay-card p { margin: 0; color: #cbd5e1; font-size: 13px; line-height: 1.65; max-width: 600px; }

        .hero-stats {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 16px;
        }

        .hero-chip {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 8px 10px;
            border-radius: 999px;
            background: rgba(255,255,255,.09);
            border: 1px solid rgba(255,255,255,.11);
            color: #e0f2fe;
            font-size: 11px;
            font-weight: 800;
        }

        .hero-chip i { width: 7px; height: 7px; border-radius: 50%; background: #22c55e; }

        @@keyframes authReveal {
            from { opacity: 0; transform: translateX(-18px) scale(.985); }
            to { opacity: 1; transform: translateX(0) scale(1); }
        }

        @@keyframes heroReveal {
            from { opacity: 0; transform: translateX(18px) scale(.985); }
            to { opacity: 1; transform: translateX(0) scale(1); }
        }

        @@keyframes alertReveal {
            from { opacity: 0; transform: translateY(-6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@keyframes floatGlow {
            0%, 100% { transform: translate(0,0) scale(1); }
            50% { transform: translate(-20px,18px) scale(1.05); }
        }

        @@media (max-width: 980px) {
            .auth-page { grid-template-columns: 1fr; padding: 16px; }
            .auth-panel { min-height: calc(100vh - 32px); }
            .hero-panel { display: none; }
        }

        @@media (max-width: 520px) {
            .auth-page { padding: 0; }
            .auth-panel { min-height: 100vh; border-radius: 0; border: 0; }
            .form-wrap { width: min(100% - 36px, 440px); }
            .brand-logo { width: 175px; }
            h1 { font-size: 35px; }
            .demo-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <main class="auth-page">
        <section class="auth-panel" aria-label="Sign in to SRMSS">
            <div class="form-wrap">
                <img src="~/images/srmss-logo.png" alt="SRMSS logo" class="brand-logo" />

                <div class="eyebrow">
                    <span class="eyebrow-dot"></span>
                    Secure transport operations portal
                </div>

                <h1>Welcome back.</h1>
                <p class="subtitle">Sign in to access your role-based command center and live transport operations.</p>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-error">@TempData["Error"]</div>
                }

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-error">@ViewBag.Error</div>
                }

                <form asp-action="Login" asp-controller="Account" method="post" autocomplete="on">
                    @Html.AntiForgeryToken()

                    <div class="field">
                        <label asp-for="Username">Username</label>
                        <div class="input-shell">
                            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4.5 21a7.5 7.5 0 0 1 15 0"/></svg>
                            <input asp-for="Username" placeholder="Enter your username" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Username" class="validation"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Password">Password</label>
                        <div class="input-shell">
                            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                            <input asp-for="Password" id="passwordInput" placeholder="Enter your password" autocomplete="current-password" />
                            <button class="password-toggle" type="button" id="passwordToggle" aria-label="Show or hide password">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="validation"></span>
                    </div>

                    <button type="submit" class="btn-primary">Sign in securely</button>
                </form>

                <div class="divider">or continue with</div>

                <a class="google-btn" href="/Account/GoogleLogin?mode=login">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M21.6 12.23c0-.71-.06-1.24-.2-1.79H12v3.4h5.52a4.7 4.7 0 0 1-2.05 3.08l-.02.11 2.98 2.31.21.02c1.92-1.77 2.96-4.38 2.96-7.13Z"/><path fill="#34A853" d="M12 22c2.7 0 4.96-.89 6.62-2.42l-3.15-2.44c-.84.57-1.98.97-3.47.97-2.6 0-4.81-1.76-5.6-4.2l-.11.01-3.1 2.39-.04.1A10 10 0 0 0 12 22Z"/><path fill="#FBBC05" d="M6.4 13.9A6.07 6.07 0 0 1 6.07 12c0-.66.12-1.3.31-1.9l-.01-.13-3.14-2.43-.1.05A10 10 0 0 0 2 12c0 1.6.38 3.11 1.06 4.42L6.4 13.9Z"/><path fill="#EA4335" d="M12 5.89c1.88 0 3.15.81 3.88 1.49l2.8-2.74C16.96 3.04 14.7 2 12 2a10 10 0 0 0-8.88 5.58l3.26 2.53C7.18 7.66 9.4 5.89 12 5.89Z"/></svg>
                    Continue with Google
                </a>

                @if (!googleEnabled)
                {
                    <div class="oauth-note">Google OAuth is built in and will activate after Client ID and Client Secret are configured.</div>
                }

                <div class="register-row">
                    New to SRMSS? <a href="/Account/Register">Create a customer account</a>
                </div>

                <details class="demo-details">
                    <summary>Demo access credentials</summary>
                    <div class="demo-grid">
                        <div class="demo-account"><strong>SuperAdmin</strong><br />superadmin / admin123</div>
                        <div class="demo-account"><strong>Admin</strong><br />admin / admin123</div>
                        <div class="demo-account"><strong>User</strong><br />user / admin123</div>
                        <div class="demo-account"><strong>Customer</strong><br />customer / admin123</div>
                    </div>
                </details>
            </div>
        </section>

        <section class="hero-panel" aria-label="SRMSS transport network illustration">
            <div class="hero-glow"></div>
            <div class="hero-overlay-card">
                <h2>One command center for smarter transport operations.</h2>
                <p>Securely manage routes, schedules, live trip status, customer discovery and system activity from a single enterprise workspace.</p>
                <div class="hero-stats">
                    <span class="hero-chip"><i></i> Live operations</span>
                    <span class="hero-chip"><i></i> Role-based access</span>
                    <span class="hero-chip"><i></i> Audit ready</span>
                </div>
            </div>
        </section>
    </main>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggle = document.getElementById("passwordToggle");
            const input = document.getElementById("passwordInput");

            toggle?.addEventListener("click", function () {
                const showing = input.type === "text";
                input.type = showing ? "password" : "text";
                toggle.setAttribute("aria-label", showing ? "Show password" : "Hide password");
            });
        });
    </script>
</body>
</html>

