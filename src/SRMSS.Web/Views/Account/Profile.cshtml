@model SRMSS.Web.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<style>
    body {
        background: #f4f8fc;
    }

    .profile-shell {
        max-width: 820px;
        margin: 28px auto;
        padding: 0 18px;
    }

    .profile-card {
        background: white;
        border: 1px solid #d8e6f3;
        border-radius: 28px;
        padding: 30px;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.06);
    }

    .header {
        background: #06111f;
        color: white;
        border-radius: 24px;
        padding: 26px;
        margin-bottom: 24px;
    }

    .header h1 {
        margin: 0 0 8px;
        font-size: 32px;
        font-weight: 900;
    }

    .header p {
        margin: 0;
        color: #cbd5e1;
    }

    label {
        display: block;
        margin-bottom: 8px;
        color: #334155;
        font-weight: 800;
    }

    input {
        width: 100%;
        padding: 14px 16px;
        border-radius: 14px;
        border: 1px solid #cbd5e1;
        margin-bottom: 16px;
        box-sizing: border-box;
        outline: none;
    }

    input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
    }

    .readonly-box {
        padding: 14px 16px;
        border-radius: 14px;
        background: #e0f2fe;
        color: #075985;
        font-weight: 800;
        margin-bottom: 16px;
    }

    .validation {
        color: #991b1b;
        display: block;
        margin-top: -10px;
        margin-bottom: 12px;
        font-size: 13px;
    }

    .success-message {
        background: #dcfce7;
        color: #166534;
        border-radius: 16px;
        padding: 14px 16px;
        font-weight: 800;
        margin-bottom: 18px;
    }

    .btn-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 12px;
    }

    .btn {
        display: inline-block;
        padding: 13px 18px;
        border-radius: 14px;
        text-decoration: none;
        border: none;
        cursor: pointer;
        font-weight: 900;
    }

    .btn-primary {
        background: #2563eb;
        color: white;
    }

    .btn-secondary {
        background: #64748b;
        color: white;
    }

    .btn-warning {
        background: #f59e0b;
        color: white;
    }
</style>

<div class="profile-shell">
    <div class="header">
        <h1>My Profile</h1>
        <p>View and update your SRMSS account details.</p>
    </div>

    <div class="profile-card">
        @if (TempData["Success"] != null)
        {
            <div class="success-message">@TempData["Success"]</div>
        }

        <form asp-action="Profile" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()

            <input asp-for="Id" type="hidden" />

            <label asp-for="FullName">Full Name</label>
            <input asp-for="FullName" placeholder="Enter full name" />
            <span asp-validation-for="FullName" class="validation"></span>

            <label asp-for="Username">Username</label>
            <input asp-for="Username" placeholder="Enter username" />
            <span asp-validation-for="Username" class="validation"></span>

            <label asp-for="Email">Email</label>
            <input asp-for="Email" placeholder="Enter email" />
            <span asp-validation-for="Email" class="validation"></span>

            <label>Role</label>
            <div class="readonly-box">@Model.Role</div>

            <div class="btn-row">
                <button type="submit" class="btn btn-primary">Save Profile</button>
                <a href="/Account/ChangePassword" class="btn btn-warning">Change Password</a>
                <a href="/Dashboard" class="btn btn-secondary">Back to Dashboard</a>
            </div>
        </form>
    </div>
</div>
