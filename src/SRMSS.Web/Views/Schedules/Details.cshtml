@model SRMSS.Web.Models.Schedule

@{
    ViewData["Title"] = "Schedule Details";
    ViewData["PageTitle"] = "Schedule Details";
    ViewData["PageSubtitle"] = "View route schedule, driver, vehicle and trip status information.";
}

<div class="schedule-create-grid">
    <div class="srmss-card">
        <h3 class="card-title">Schedule Information</h3>
        <p class="card-subtitle">
            Detailed information about the selected schedule.
        </p>

        <div class="details-list">
            <div class="details-row">
                <span>Route</span>
                <strong>@(Model.TransportRoute?.RouteName ?? "Unknown Route")</strong>
            </div>

            <div class="details-row">
                <span>Vehicle</span>
                <strong>@(Model.Vehicle?.RegistrationNumber ?? "Unknown Vehicle")</strong>
            </div>

            <div class="details-row">
                <span>Driver</span>
                <strong>@(Model.Driver?.FullName ?? "Unknown Driver")</strong>
            </div>

            <div class="details-row">
                <span>Schedule Date</span>
                <strong>@Model.ScheduleDate.ToString("dd MMM yyyy")</strong>
            </div>

            <div class="details-row">
                <span>Departure Time</span>
                <strong>@Model.DepartureTime.ToString(@"hh\:mm")</strong>
            </div>

            <div class="details-row">
                <span>Arrival Time</span>
                <strong>@Model.ArrivalTime.ToString(@"hh\:mm")</strong>
            </div>

            <div class="details-row">
                <span>Status</span>
                <strong>
                    @if (Model.Status == "Scheduled")
                    {
                        <span class="status-pill blue">Scheduled</span>
                    }
                    else if (Model.Status == "On Time")
                    {
                        <span class="status-pill green">On Time</span>
                    }
                    else if (Model.Status == "Departed")
                    {
                        <span class="status-pill purple">Departed</span>
                    }
                    else if (Model.Status == "Delayed")
                    {
                        <span class="status-pill amber">Delayed</span>
                    }
                    else if (Model.Status == "Completed")
                    {
                        <span class="status-pill green">Completed</span>
                    }
                    else if (Model.Status == "Cancelled")
                    {
                        <span class="status-pill red">Cancelled</span>
                    }
                    else
                    {
                        <span class="status-pill blue">@Model.Status</span>
                    }
                </strong>
            </div>

            <div class="details-row">
                <span>Notes</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes" : Model.Notes)</strong>
            </div>
        </div>

        <div class="d-flex gap-3 flex-wrap mt-4">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="srmss-btn primary">
                Edit Schedule
            </a>

            <a asp-action="Index" class="srmss-btn secondary">
                Back to List
            </a>
        </div>
    </div>

    <div class="srmss-card amber">
        <h3 class="card-title">Trip Timeline</h3>
        <p class="card-subtitle">
            Operational trip view for this schedule.
        </p>

        <div class="schedule-preview-card">
            <div class="schedule-preview-top">
                <span class="status-pill blue">@Model.Status</span>
                <strong>@Model.ScheduleDate.ToString("dd MMM")</strong>
            </div>

            <h4>@(Model.TransportRoute?.RouteName ?? "Route")</h4>

            <div class="schedule-preview-time">
                <span>@Model.DepartureTime.ToString(@"hh\:mm")</span>
                <div></div>
                <span>@Model.ArrivalTime.ToString(@"hh\:mm")</span>
            </div>
        </div>

        <div class="route-detail-mini-summary mt-4">
            <div>
                <span>Vehicle</span>
                <strong>@(Model.Vehicle?.RegistrationNumber ?? "N/A")</strong>
            </div>

            <div>
                <span>Driver</span>
                <strong>@(Model.Driver?.FullName ?? "N/A")</strong>
            </div>
        </div>

        <div class="empty-stop-panel mt-4">
            <div class="empty-stop-icon">✓</div>
            <h4>Schedule Recorded</h4>
            <p>
                This trip is available for depot scheduling and operational monitoring.
            </p>
        </div>
    </div>
</div>
