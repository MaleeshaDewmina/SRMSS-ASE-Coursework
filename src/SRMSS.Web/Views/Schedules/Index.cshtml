@model IEnumerable<SRMSS.Web.Models.Schedule>

@{
    ViewData["Title"] = "Schedule Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Schedule Management</h2>
            <p class="text-muted mb-0">
                Manage route schedules, assigned drivers, assigned vehicles, and trip status.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add Schedule
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <strong>Depot Schedule List</strong>
        </div>

        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Route</th>
                        <th>Vehicle</th>
                        <th>Driver</th>
                        <th>Departure</th>
                        <th>Arrival</th>
                        <th>Status</th>
                        <th>Update Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ScheduleDate.ToString("yyyy-MM-dd")</td>
                                <td class="fw-semibold">@item.TransportRoute?.RouteName</td>
                                <td>@item.Vehicle?.RegistrationNumber</td>
                                <td>@item.Driver?.FullName</td>
                                <td>@item.DepartureTime.ToString(@"hh\:mm")</td>
                                <td>@item.ArrivalTime.ToString(@"hh\:mm")</td>
                                <td>
                                    @if (item.Status == "Scheduled")
                                    {
                                        <span class="badge bg-primary">Scheduled</span>
                                    }
                                    else if (item.Status == "On Time")
                                    {
                                        <span class="badge bg-success">On Time</span>
                                    }
                                    else if (item.Status == "Delayed")
                                    {
                                        <span class="badge bg-warning text-dark">Delayed</span>
                                    }
                                    else if (item.Status == "Completed")
                                    {
                                        <span class="badge bg-dark">Completed</span>
                                    }
                                    else if (item.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Status</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="UpdateStatus" method="post" class="d-flex gap-1">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <select name="status" class="form-select form-select-sm">
                                            <option value="Scheduled">Scheduled</option>
                                            <option value="On Time">On Time</option>
                                            <option value="Delayed">Delayed</option>
                                            <option value="Completed">Completed</option>
                                            <option value="Cancelled">Cancelled</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                                    </form>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                No schedules have been created yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>