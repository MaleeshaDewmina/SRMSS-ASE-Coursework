@model SRMSS.Web.Models.Schedule

@{
    ViewData["Title"] = "Edit Schedule";
    ViewData["PageTitle"] = "Edit Schedule";
    ViewData["PageSubtitle"] = "Update route, vehicle, driver and trip timing details.";

    var routeName = Model.TransportRoute?.RouteName ?? "Selected Route";
    var driverName = Model.Driver?.FullName ?? "Selected Driver";
    var vehicleName = Model.Vehicle?.RegistrationNumber ?? "Selected Vehicle";
}

<div class="schedule-create-grid">
    <div class="srmss-card">
        <h3 class="card-title">Schedule Form</h3>
        <p class="card-subtitle">
            Update schedule assignment and timing information.
        </p>

        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="TransportRouteId" class="form-label">Route</label>
                <select asp-for="TransportRouteId" class="form-select" asp-items="ViewBag.TransportRouteId">
                    <option value="">-- Select Route --</option>
                </select>
                <span asp-validation-for="TransportRouteId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="VehicleId" class="form-label">Vehicle</label>
                <select asp-for="VehicleId" class="form-select" asp-items="ViewBag.VehicleId">
                    <option value="">-- Select Vehicle --</option>
                </select>
                <span asp-validation-for="VehicleId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DriverId" class="form-label">Driver</label>
                <select asp-for="DriverId" class="form-select" asp-items="ViewBag.DriverId">
                    <option value="">-- Select Driver --</option>
                </select>
                <span asp-validation-for="DriverId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ScheduleDate" class="form-label">Schedule Date</label>
                <input asp-for="ScheduleDate" type="date" class="form-control" />
                <span asp-validation-for="ScheduleDate" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DepartureTime" class="form-label">Departure Time</label>
                    <input asp-for="DepartureTime" type="time" class="form-control" />
                    <span asp-validation-for="DepartureTime" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="ArrivalTime" class="form-label">Arrival Time</label>
                    <input asp-for="ArrivalTime" type="time" class="form-control" />
                    <span asp-validation-for="ArrivalTime" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label">Trip Status</label>
                <select asp-for="Status" class="form-select">
                    <option value="Scheduled">Scheduled</option>
                    <option value="On Time">On Time</option>
                    <option value="Departed">Departed</option>
                    <option value="Delayed">Delayed</option>
                    <option value="Completed">Completed</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Notes" class="form-label">Notes</label>
                <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Optional schedule notes"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div class="d-flex gap-3 flex-wrap">
                <button type="submit" class="srmss-btn primary">
                    Save Changes
                </button>

                <a asp-action="Index" class="srmss-btn secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>

    <div class="srmss-card amber">
        <h3 class="card-title">Schedule Preview</h3>
        <p class="card-subtitle">
            Current trip assignment summary.
        </p>

        <div class="schedule-preview-card">
            <div class="schedule-preview-top">
                <span class="status-pill blue">@Model.Status</span>
                <strong>@Model.ScheduleDate.ToString("dd MMM yyyy")</strong>
            </div>

            <h4>@routeName</h4>

            <div class="schedule-preview-time">
                <span>@Model.DepartureTime.ToString(@"hh\:mm")</span>
                <div></div>
                <span>@Model.ArrivalTime.ToString(@"hh\:mm")</span>
            </div>

            <div class="route-detail-mini-summary mt-4">
                <div>
                    <span>Vehicle</span>
                    <strong>@vehicleName</strong>
                </div>

                <div>
                    <span>Driver</span>
                    <strong>@driverName</strong>
                </div>
            </div>
        </div>

        <div class="empty-stop-panel mt-4">
            <div class="empty-stop-icon">i</div>
            <h4>Conflict Rule</h4>
            <p>
                The system checks driver, vehicle and route timing conflicts before saving.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
