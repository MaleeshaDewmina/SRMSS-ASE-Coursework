@model SRMSS.Web.Models.Schedule

@{
    ViewData["Title"] = "Create Schedule";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <strong>Create New Schedule</strong>
        </div>

        <div class="card-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="ScheduleDate" class="form-label"></label>
                        <input asp-for="ScheduleDate" type="date" class="form-control" />
                        <span asp-validation-for="ScheduleDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="DepartureTime" class="form-label"></label>
                        <input asp-for="DepartureTime" type="time" class="form-control" />
                        <span asp-validation-for="DepartureTime" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="ArrivalTime" class="form-label"></label>
                        <input asp-for="ArrivalTime" type="time" class="form-control" />
                        <span asp-validation-for="ArrivalTime" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="TransportRouteId" class="form-label"></label>
                    <select asp-for="TransportRouteId" class="form-select" asp-items="ViewBag.TransportRouteId">
                        <option value="">-- Select Route --</option>
                    </select>
                    <span asp-validation-for="TransportRouteId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="VehicleId" class="form-label"></label>
                    <select asp-for="VehicleId" class="form-select" asp-items="ViewBag.VehicleId">
                        <option value="">-- Select Vehicle --</option>
                    </select>
                    <span asp-validation-for="VehicleId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DriverId" class="form-label"></label>
                    <select asp-for="DriverId" class="form-select" asp-items="ViewBag.DriverId">
                        <option value="">-- Select Driver --</option>
                    </select>
                    <span asp-validation-for="DriverId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select">
                        <option value="Scheduled">Scheduled</option>
                        <option value="On Time">On Time</option>
                        <option value="Delayed">Delayed</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Optional notes about the schedule"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save Schedule</button>
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}