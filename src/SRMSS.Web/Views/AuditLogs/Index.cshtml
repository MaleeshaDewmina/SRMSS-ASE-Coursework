@model IEnumerable<SRMSS.Web.Models.AuditLog>

@{
    ViewData["Title"] = "Audit Logs";

    string actionFilter = ViewBag.ActionFilter ?? "";
    string search = ViewBag.Search ?? "";
    string fromDate = ViewBag.FromDate ?? "";
    string toDate = ViewBag.ToDate ?? "";

    var actions = ViewBag.Actions as List<string> ?? new List<string>();
}

<style>
    body {
        background: #f4f8fc;
    }

    .page-shell {
        padding: 28px;
    }

    .page-header {
        background: #06111f;
        color: white;
        border-radius: 26px;
        padding: 28px;
        margin-bottom: 22px;
    }

    .page-header h1 {
        margin: 0 0 8px;
        font-size: 32px;
        font-weight: 900;
    }

    .page-header p {
        margin: 0;
        color: #cbd5e1;
    }

    .filter-card {
        background: white;
        border: 1px solid #d8e6f3;
        border-radius: 22px;
        padding: 18px;
        margin-bottom: 20px;
        display: grid;
        grid-template-columns: 1fr 220px 180px 180px 140px;
        gap: 12px;
    }

    input,
    select {
        width: 100%;
        padding: 13px 14px;
        border-radius: 14px;
        border: 1px solid #cbd5e1;
        outline: none;
        box-sizing: border-box;
    }

    input:focus,
    select:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
    }

    .btn {
        display: inline-block;
        padding: 12px 16px;
        border-radius: 14px;
        text-decoration: none;
        border: none;
        cursor: pointer;
        font-weight: 800;
        text-align: center;
    }

    .btn-primary {
        background: #2563eb;
        color: white;
    }

    .btn-secondary {
        background: #64748b;
        color: white;
    }

    .top-actions {
        display: flex;
        justify-content: space-between;
        margin-bottom: 18px;
        gap: 10px;
        flex-wrap: wrap;
    }

    .table-card {
        background: white;
        border-radius: 24px;
        border: 1px solid #d8e6f3;
        overflow: hidden;
        box-shadow: 0 14px 38px rgba(15, 23, 42, 0.06);
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        background: #eaf2fb;
        color: #0f172a;
        text-align: left;
        padding: 15px;
        font-size: 14px;
    }

    td {
        padding: 15px;
        border-top: 1px solid #e2e8f0;
        color: #334155;
        vertical-align: top;
    }

    .badge {
        display: inline-block;
        padding: 7px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 900;
        background: #dbeafe;
        color: #1d4ed8;
    }

    .muted {
        color: #64748b;
        font-size: 13px;
    }

    .description {
        max-width: 420px;
        line-height: 1.5;
    }

    @@media (max-width: 950px) {
        .filter-card {
            grid-template-columns: 1fr;
        }

        table {
            min-width: 1000px;
        }

        .table-card {
            overflow-x: auto;
        }
    }
</style>

<div class="page-shell">
    <div class="page-header">
        <h1>Audit Logs</h1>
        <p>Track authentication, user management, registration and access control events.</p>
    </div>

    <div class="top-actions">
        <a href="/Dashboard" class="btn btn-secondary">Back to Dashboard</a>
        <a href="/AuditLogs" class="btn btn-primary">Reset Filters</a>
    </div>

    <form method="get" class="filter-card">
        <input type="text" name="search" value="@search" placeholder="Search user, action, table or description" />

        <select name="actionFilter">
            <option value="">All Actions</option>

            @foreach (var action in actions)
            {
                if (actionFilter == action)
                {
                    <option value="@action" selected>@action</option>
                }
                else
                {
                    <option value="@action">@action</option>
                }
            }
        </select>

        <input type="date" name="fromDate" value="@fromDate" />
        <input type="date" name="toDate" value="@toDate" />

        <button type="submit" class="btn btn-primary">Filter</button>
    </form>

    <div class="table-card">
        <table>
            <thead>
                <tr>
                    <th>Date and Time</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Table</th>
                    <th>Record</th>
                    <th>Description</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td>
                            @log.CreatedAt.ToString("yyyy-MM-dd")
                            <div class="muted">@log.CreatedAt.ToString("hh:mm tt")</div>
                        </td>

                        <td>
                            @if (log.AppUser != null)
                            {
                                <strong>@log.AppUser.FullName</strong>
                                <div class="muted">@log.AppUser.Username</div>
                            }
                            else
                            {
                                <span class="muted">System or unknown</span>
                            }
                        </td>

                        <td><span class="badge">@log.Action</span></td>
                        <td>@log.TableName</td>
                        <td>@(log.RecordId.HasValue ? log.RecordId.ToString() : "-")</td>
                        <td class="description">@log.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>