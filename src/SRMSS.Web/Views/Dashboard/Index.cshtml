@model SRMSS.Web.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Dashboard";
    ViewData["PageSubtitle"] = $"Live SRMSS overview for {Model.Role}";
}

<style>
    .dashboard-content {
        width: 100%;
    }

    .dashboard-welcome {
        background: linear-gradient(135deg, #06111f, #0f2f5f);
        color: white;
        border-radius: 26px;
        padding: 28px;
        margin-bottom: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.12);
    }

    .dashboard-welcome h1 {
        margin: 0 0 8px;
        font-size: 32px;
        font-weight: 900;
    }

    .dashboard-welcome p {
        margin: 0;
        color: #cbd5e1;
    }

    .role-badge {
        display: inline-block;
        padding: 10px 14px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.12);
        color: #dbeafe;
        border: 1px solid rgba(147, 197, 253, 0.35);
        font-weight: 900;
        white-space: nowrap;
    }

    .dashboard-kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 24px;
    }

    .dashboard-kpi-card {
        background: white;
        border-radius: 22px;
        padding: 22px;
        border: 1px solid #d8e6f3;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.05);
        position: relative;
        overflow: hidden;
    }

    .dashboard-kpi-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 5px;
        height: 100%;
        background: #1e3a8a;
    }

    .dashboard-kpi-title {
        color: #64748b;
        font-weight: 800;
        font-size: 14px;
    }

    .dashboard-kpi-value {
        color: #06111f;
        font-size: 36px;
        font-weight: 900;
        margin-top: 8px;
    }

    .dashboard-section {
        background: white;
        border-radius: 24px;
        padding: 24px;
        border: 1px solid #d8e6f3;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.05);
        margin-bottom: 24px;
    }

    .dashboard-section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 18px;
    }

    .dashboard-section-header h2 {
        margin: 0;
        color: #06111f;
        font-size: 22px;
        font-weight: 900;
    }

    .dashboard-section-header a {
        color: #1d4ed8;
        text-decoration: none;
        font-weight: 800;
    }

    .dashboard-module-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    .dashboard-module-link {
        display: block;
        background: #f8fafc;
        border-radius: 20px;
        padding: 22px;
        border: 1px solid #d8e6f3;
        min-height: 150px;
        color: inherit;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .dashboard-module-link:hover {
        transform: translateY(-3px);
        border-color: #93c5fd;
        box-shadow: 0 14px 28px rgba(37, 99, 235, 0.09);
        color: inherit;
    }

    .dashboard-module-link h3 {
        margin: 0 0 10px;
        color: #06111f;
        font-size: 18px;
        font-weight: 900;
    }

    .dashboard-module-link p {
        color: #64748b;
        line-height: 1.6;
        margin: 0;
    }

    .dashboard-activity-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .dashboard-activity-item {
        display: grid;
        grid-template-columns: 170px 150px 1fr;
        gap: 15px;
        align-items: center;
        padding: 14px 16px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
    }

    .dashboard-activity-action {
        font-weight: 900;
        color: #1d4ed8;
    }

    .dashboard-activity-user {
        color: #334155;
        font-weight: 700;
    }

    .dashboard-activity-description {
        color: #64748b;
    }

    .dashboard-activity-time {
        color: #94a3b8;
        font-size: 12px;
        margin-top: 4px;
    }

    .dashboard-empty-state {
        padding: 24px;
        text-align: center;
        color: #64748b;
        background: #f8fafc;
        border-radius: 16px;
    }

    @@media (max-width: 1100px) {
        .dashboard-kpi-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .dashboard-module-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 700px) {
        .dashboard-welcome {
            flex-direction: column;
            align-items: flex-start;
        }

        .dashboard-activity-item {
            grid-template-columns: 1fr;
            gap: 6px;
        }
    }

    @@media (max-width: 520px) {
        .dashboard-kpi-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="dashboard-content">
    <section class="dashboard-welcome">
        <div>
            <h1>Welcome, @Model.FullName</h1>
            <p>
                Signed in as <strong>@Model.Username</strong>. Your dashboard shows live information from the SRMSS database.
            </p>
        </div>
        <span class="role-badge">@Model.Role Dashboard</span>
    </section>

    @if (Model.Role == "SuperAdmin")
    {
        <section class="dashboard-kpi-grid">
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Total Admins</div><div class="dashboard-kpi-value">@Model.TotalAdmins</div></div>
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Total Users</div><div class="dashboard-kpi-value">@Model.TotalUsers</div></div>
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Total Customers</div><div class="dashboard-kpi-value">@Model.TotalCustomers</div></div>
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Audit Logs</div><div class="dashboard-kpi-value">@Model.TotalAuditLogs</div></div>
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Active Accounts</div><div class="dashboard-kpi-value">@Model.ActiveAccounts</div></div>
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Inactive Accounts</div><div class="dashboard-kpi-value">@Model.InactiveAccounts</div></div>
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Routes</div><div class="dashboard-kpi-value">@Model.TotalRoutes</div></div>
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Schedules</div><div class="dashboard-kpi-value">@Model.TotalSchedules</div></div>
        </section>

        <section class="dashboard-section">
            <div class="dashboard-section-header">
                <h2>Operations Quick Access</h2>
            </div>
            <div class="dashboard-module-grid">
                <a asp-controller="TransportRoutes" asp-action="Index" class="dashboard-module-link">
                    <h3>Route Management</h3>
                    <p>Manage transport routes, route details and service information.</p>
                </a>
                <a asp-controller="Schedules" asp-action="Index" class="dashboard-module-link">
                    <h3>Schedule Management</h3>
                    <p>Manage schedules, assignments, repeated services and conflict detection.</p>
                </a>
                <a asp-controller="TripStatus" asp-action="Index" class="dashboard-module-link">
                    <h3>Trip Status Board</h3>
                    <p>Monitor scheduled, departed, delayed, completed and cancelled trips.</p>
                </a>
            </div>
        </section>

        <section class="dashboard-section">
            <div class="dashboard-section-header">
                <h2>Recent System Activity</h2>
                <a asp-controller="AuditLogs" asp-action="Index">View All Logs</a>
            </div>

            @if (Model.RecentAuditLogs.Any())
            {
                <div class="dashboard-activity-list">
                    @foreach (var log in Model.RecentAuditLogs)
                    {
                        <div class="dashboard-activity-item">
                            <div>
                                <div class="dashboard-activity-action">@log.Action</div>
                                <div class="dashboard-activity-time">@log.CreatedAt.ToString("yyyy-MM-dd hh:mm tt")</div>
                            </div>
                            <div class="dashboard-activity-user">@(log.AppUser?.Username ?? "System")</div>
                            <div class="dashboard-activity-description">@log.Description</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="dashboard-empty-state">No recent system activity available.</div>
            }
        </section>
    }
    else if (Model.Role == "Admin")
    {
        <section class="dashboard-kpi-grid">
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Routes</div><div class="dashboard-kpi-value">@Model.TotalRoutes</div></div>
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Schedules</div><div class="dashboard-kpi-value">@Model.TotalSchedules</div></div>
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Drivers</div><div class="dashboard-kpi-value">@Model.TotalDrivers</div></div>
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Vehicles</div><div class="dashboard-kpi-value">@Model.TotalVehicles</div></div>
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Active Trips</div><div class="dashboard-kpi-value">@Model.ActiveTrips</div></div>
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Delayed Trips</div><div class="dashboard-kpi-value">@Model.DelayedTrips</div></div>
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Completed Trips</div><div class="dashboard-kpi-value">@Model.CompletedTrips</div></div>
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Customers</div><div class="dashboard-kpi-value">@Model.TotalCustomers</div></div>
        </section>

        <section class="dashboard-section">
            <div class="dashboard-section-header"><h2>Depot Management</h2></div>
            <div class="dashboard-module-grid">
                <a asp-controller="TransportRoutes" asp-action="Index" class="dashboard-module-link">
                    <h3>Route Management</h3>
                    <p>Manage public transport routes, route stops and service information.</p>
                </a>
                <a asp-controller="Schedules" asp-action="Index" class="dashboard-module-link">
                    <h3>Schedule Management</h3>
                    <p>Manage route schedules, assignments, conflict detection and repeated services.</p>
                </a>
                <a asp-controller="TripStatus" asp-action="Index" class="dashboard-module-link">
                    <h3>Trip Status Board</h3>
                    <p>Monitor live trip progress and update operational status.</p>
                </a>
            </div>
        </section>
    }
    else if (Model.Role == "User")
    {
        <section class="dashboard-kpi-grid">
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Total Schedules</div><div class="dashboard-kpi-value">@Model.TotalSchedules</div></div>
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Active Trips</div><div class="dashboard-kpi-value">@Model.ActiveTrips</div></div>
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Delayed Trips</div><div class="dashboard-kpi-value">@Model.DelayedTrips</div></div>
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Completed Trips</div><div class="dashboard-kpi-value">@Model.CompletedTrips</div></div>
        </section>

        <section class="dashboard-section">
            <div class="dashboard-section-header"><h2>Operations</h2></div>
            <div class="dashboard-module-grid">
                <a asp-controller="TripStatus" asp-action="Index" class="dashboard-module-link">
                    <h3>View Trip Status</h3>
                    <p>Monitor scheduled, departed, delayed, completed and cancelled trips.</p>
                </a>
                <a asp-controller="Account" asp-action="Profile" class="dashboard-module-link">
                    <h3>My Profile</h3>
                    <p>View and update your SRMSS account details securely.</p>
                </a>
            </div>
        </section>
    }
    else if (Model.Role == "Customer")
    {
        <section class="dashboard-kpi-grid">
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Available Routes</div><div class="dashboard-kpi-value">@Model.AvailableRoutes</div></div>
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Available Schedules</div><div class="dashboard-kpi-value">@Model.AvailableSchedules</div></div>
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Active Trips</div><div class="dashboard-kpi-value">@Model.ActiveTrips</div></div>
            <div class="dashboard-kpi-card"><div class="dashboard-kpi-title">Favorite Routes</div><div class="dashboard-kpi-value">@Model.FavoriteRoutes</div></div>
        </section>

        <section class="dashboard-section">
            <div class="dashboard-section-header"><h2>Customer Portal</h2></div>
            <div class="dashboard-module-grid">
                <a asp-controller="CustomerRoutes" asp-action="Index" class="dashboard-module-link">
                    <h3>Search Routes</h3>
                    <p>Search public transport routes by starting point and destination.</p>
                </a>
                <a asp-controller="CustomerRoutes" asp-action="Index" class="dashboard-module-link">
                    <h3>View Timetables</h3>
                    <p>Check route schedules, departure times and current trip status.</p>
                </a>
                <a href="/CustomerRoutes#favorites" class="dashboard-module-link">
                    <h3>Favorite Routes</h3>
                    <p>Open your saved routes for faster future access.</p>
                </a>
            </div>
        </section>
    }
</div>
