@section Scripts {

    @if (!isCustomer)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    }


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                // =================================================
                // STAFF COUNT-UP ANIMATION
                // =================================================

                const staffCounters =
                    document.querySelectorAll(
                        ".count-up"
                    );


                staffCounters.forEach(
                    function (counter) {

                        const target =
                            parseInt(
                                counter.dataset.target
                                || "0"
                            );


                        const duration =
                            900;


                        let startTime =
                            null;


                        function animateCounter(
                            timestamp
                        ) {

                            if (!startTime) {

                                startTime =
                                    timestamp;
                            }


                            const progress =
                                Math.min(
                                    (
                                        timestamp -
                                        startTime
                                    )
                                    /
                                    duration,
                                    1
                                );


                            const easedProgress =
                                1 -
                                Math.pow(
                                    1 - progress,
                                    3
                                );


                            const currentValue =
                                Math.floor(
                                    easedProgress *
                                    target
                                );


                            counter.textContent =
                                currentValue;


                            if (progress < 1) {

                                requestAnimationFrame(
                                    animateCounter
                                );

                            }
                            else {

                                counter.textContent =
                                    target;
                            }
                        }


                        requestAnimationFrame(
                            animateCounter
                        );

                    }
                );


                // =================================================
                // CUSTOMER COUNT-UP ANIMATION
                // =================================================

                const customerCounters =
                    document.querySelectorAll(
                        ".customer-count"
                    );


                customerCounters.forEach(
                    function (counter) {

                        const target =
                            parseInt(
                                counter.getAttribute(
                                    "data-count"
                                )
                            )
                            || 0;


                        const duration =
                            1000;


                        const startTime =
                            performance.now();


                        function updateCustomerCounter(
                            currentTime
                        ) {

                            const elapsed =
                                currentTime -
                                startTime;


                            const progress =
                                Math.min(
                                    elapsed / duration,
                                    1
                                );


                            const easedProgress =
                                1 -
                                Math.pow(
                                    1 - progress,
                                    3
                                );


                            const currentValue =
                                Math.floor(
                                    target *
                                    easedProgress
                                );


                            counter.textContent =
                                currentValue;


                            if (progress < 1) {

                                requestAnimationFrame(
                                    updateCustomerCounter
                                );

                            }
                            else {

                                counter.textContent =
                                    target;
                            }
                        }


                        requestAnimationFrame(
                            updateCustomerCounter
                        );

                    }
                );


                // =================================================
                // STAFF CHARTS ONLY
                // =================================================

                @if (!isCustomer)
                {
                    <text>

                        if (
                            typeof Chart !== "undefined"
                        ) {

                            Chart.defaults.font.family =
                                "Inter, Segoe UI, Arial, sans-serif";


                            Chart.defaults.color =
                                "#64748b";


                            // =====================================
                            // SUPER ADMIN ACCOUNT DISTRIBUTION
                            // =====================================

                            @if (isSuperAdmin)
                            {
                                <text>

                                    const accountCanvas =
                                        document.getElementById(
                                            "accountDistributionChart"
                                        );


                                    if (accountCanvas) {

                                        new Chart(
                                            accountCanvas,
                                            {

                                                type:
                                                    "doughnut",


                                                data: {

                                                    labels: [
                                                        "Admins",
                                                        "Users",
                                                        "Customers"
                                                    ],


                                                    datasets: [
                                                        {

                                                            data: [
                                                                @Model.TotalAdmins,
                                                                @Model.TotalUsers,
                                                                @Model.TotalCustomers
                                                            ],


                                                            backgroundColor: [
                                                                "#2563eb",
                                                                "#38bdf8",
                                                                "#8b5cf6"
                                                            ],


                                                            borderWidth:
                                                                0,


                                                            hoverOffset:
                                                                8
                                                        }
                                                    ]
                                                },


                                                options: {

                                                    responsive:
                                                        true,


                                                    maintainAspectRatio:
                                                        false,


                                                    cutout:
                                                        "72%",


                                                    animation: {

                                                        duration:
                                                            1200,

                                                        easing:
                                                            "easeOutQuart"
                                                    },


                                                    plugins: {

                                                        legend: {

                                                            position:
                                                                "bottom",

                                                            labels: {

                                                                usePointStyle:
                                                                    true,

                                                                pointStyle:
                                                                    "circle",

                                                                padding:
                                                                    18
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        );
                                    }

                                </text>
                            }


                            // =====================================
                            // TRIP STATUS
                            // =====================================

                            const tripCanvas =
                                document.getElementById(
                                    "tripStatusChart"
                                );


                            if (tripCanvas) {

                                new Chart(
                                    tripCanvas,
                                    {

                                        type:
                                            "bar",


                                        data: {

                                            labels: [
                                                "Active",
                                                "Delayed",
                                                "Completed"
                                            ],


                                            datasets: [
                                                {

                                                    label:
                                                        "Trips",


                                                    data: [
                                                        @Model.ActiveTrips,
                                                        @Model.DelayedTrips,
                                                        @Model.CompletedTrips
                                                    ],


                                                    backgroundColor: [
                                                        "#2563eb",
                                                        "#f59e0b",
                                                        "#22c55e"
                                                    ],


                                                    borderRadius:
                                                        10,


                                                    borderSkipped:
                                                        false
                                                }
                                            ]
                                        },


                                        options: {

                                            responsive:
                                                true,


                                            maintainAspectRatio:
                                                false,


                                            animation: {

                                                duration:
                                                    1200,

                                                easing:
                                                    "easeOutQuart"
                                            },


                                            scales: {

                                                y: {

                                                    beginAtZero:
                                                        true,

                                                    ticks: {

                                                        precision:
                                                            0
                                                    },

                                                    grid: {

                                                        color:
                                                            "rgba(148, 163, 184, 0.15)"
                                                    },

                                                    border: {

                                                        display:
                                                            false
                                                    }
                                                },


                                                x: {

                                                    grid: {

                                                        display:
                                                            false
                                                    },

                                                    border: {

                                                        display:
                                                            false
                                                    }
                                                }
                                            },


                                            plugins: {

                                                legend: {

                                                    display:
                                                        false
                                                }
                                            }
                                        }
                                    }
                                );
                            }


                            // =====================================
                            // ACTIVITY CHART
                            // SuperAdmin and Admin only
                            // =====================================

                            @if (canViewSystemActivity)
                            {
                                <text>

                                    const activityLabels =
                                        @Html.Raw(activityLabelsJson);


                                    const activityCounts =
                                        @Html.Raw(activityCountsJson);


                                    const activityCanvas =
                                        document.getElementById(
                                            "activityChart"
                                        );


                                    if (activityCanvas) {

                                        new Chart(
                                            activityCanvas,
                                            {

                                                type:
                                                    "line",


                                                data: {

                                                    labels:
                                                        activityLabels,


                                                    datasets: [
                                                        {

                                                            label:
                                                                "System Events",


                                                            data:
                                                                activityCounts,


                                                            borderColor:
                                                                "#2563eb",


                                                            backgroundColor:
                                                                "rgba(37, 99, 235, 0.10)",


                                                            fill:
                                                                true,


                                                            tension:
                                                                0.42,


                                                            borderWidth:
                                                                3,


                                                            pointRadius:
                                                                5,


                                                            pointHoverRadius:
                                                                7,


                                                            pointBackgroundColor:
                                                                "#2563eb",


                                                            pointBorderColor:
                                                                "#ffffff",


                                                            pointBorderWidth:
                                                                2
                                                        }
                                                    ]
                                                },


                                                options: {

                                                    responsive:
                                                        true,


                                                    maintainAspectRatio:
                                                        false,


                                                    animation: {

                                                        duration:
                                                            1300,

                                                        easing:
                                                            "easeOutQuart"
                                                    },


                                                    interaction: {

                                                        intersect:
                                                            false,

                                                        mode:
                                                            "index"
                                                    },


                                                    scales: {

                                                        y: {

                                                            beginAtZero:
                                                                true,

                                                            ticks: {

                                                                precision:
                                                                    0
                                                            },

                                                            grid: {

                                                                color:
                                                                    "rgba(148, 163, 184, 0.15)"
                                                            },

                                                            border: {

                                                                display:
                                                                    false
                                                            }
                                                        },


                                                        x: {

                                                            grid: {

                                                                display:
                                                                    false
                                                            },

                                                            border: {

                                                                display:
                                                                    false
                                                            }
                                                        }
                                                    },


                                                    plugins: {

                                                        legend: {

                                                            display:
                                                                false
                                                        }
                                                    }
                                                }
                                            }
                                        );
                                    }

                                </text>
                            }
                        }

                    </text>
                }

            }
        );

    </script>
}


