    [data-theme="dark"] .customer-stat-card h3,
    [data-theme="dark"] .customer-section-heading h2,
    [data-theme="dark"] .customer-how-header h2,
    [data-theme="dark"] .journey-point strong,
    [data-theme="dark"] .customer-quick-card strong,
    [data-theme="dark"] .customer-how-card h3 {
        color: #f8fafc;
    }


    [data-theme="dark"] .activity-item,
    [data-theme="dark"] .quick-action,
    [data-theme="dark"] .customer-quick-card,
    [data-theme="dark"] .customer-how-card {
        background: #132238;

        border-color:
            rgba(148, 163, 184, 0.14);
    }


    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @@media (max-width: 1200px) {

        .kpi-grid,
        .user-operations-grid {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }


        .customer-hero {
            grid-template-columns: 1fr;
        }


        .customer-travel-visual {
            display: none;
        }


        .customer-discovery-grid {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 950px) {

        .chart-grid,
        .bottom-grid {
            grid-template-columns: 1fr;
        }


        .activity-item {
            grid-template-columns:
                12px
                1fr;
        }


        .activity-user,
        .activity-description {
            grid-column: 2;
        }
    }


    @@media (max-width: 800px) {

        .customer-stats-grid,
        .customer-how-grid {
            grid-template-columns: 1fr;
        }


        .customer-hero {
            min-height: auto;

            padding:
                30px 24px;
        }


        .customer-hero h1 {
            font-size: 38px;
        }


        .customer-how-header {
            align-items:
                flex-start;

            flex-direction:
                column;
        }
    }


    @@media (max-width: 650px) {

        .welcome-panel {
            flex-direction: column;

            align-items: flex-start;

            padding: 24px;
        }


        .system-status {
            width: 100%;
        }


        .kpi-grid,
        .user-operations-grid {
            grid-template-columns: 1fr;
        }


        .welcome-panel h1 {
            font-size: 28px;
        }
    }


    @@media (max-width: 520px) {

        .customer-hero-actions {
            flex-direction: column;
        }


        .customer-primary-btn,
        .customer-secondary-btn {
            width: 100%;
        }


        .customer-journey-panel,
        .customer-quick-panel,
        .customer-how-section {
            padding: 20px;
        }
    }

