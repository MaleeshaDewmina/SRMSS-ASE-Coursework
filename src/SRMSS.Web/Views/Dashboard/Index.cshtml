@model SRMSS.Web.ViewModels.DashboardViewModel

@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = Model.Role == "Customer"
        ? "My Travel Dashboard"
        : "Dashboard";

    ViewData["PageSubtitle"] = Model.Role == "Customer"
        ? "Discover routes, schedules and smarter ways to travel with SRMSS"
        : "Live overview of the SRMSS transport management system";

    bool isSuperAdmin = string.Equals(
        Model.Role,
        "SuperAdmin",
        StringComparison.OrdinalIgnoreCase
    );

    bool isAdmin = string.Equals(
        Model.Role,
        "Admin",
        StringComparison.OrdinalIgnoreCase
    );

    bool isUser = string.Equals(
        Model.Role,
        "User",
        StringComparison.OrdinalIgnoreCase
    );

    bool isCustomer = string.Equals(
        Model.Role,
        "Customer",
        StringComparison.OrdinalIgnoreCase
    );

    bool canViewSystemActivity =
        isSuperAdmin ||
        isAdmin;

    string activityLabelsJson =
        JsonSerializer.Serialize(Model.ActivityLabels);

    string activityCountsJson =
        JsonSerializer.Serialize(Model.ActivityCounts);
}


<style>

    /* =========================================================
       COMMON DASHBOARD
    ========================================================= */

    .dashboard-page {
        opacity: 0;
        transform: translateY(16px);
        animation: pageReveal 0.65s ease forwards;
    }


    @@keyframes pageReveal {

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    .welcome-panel {
        position: relative;
        overflow: hidden;

        background:
            radial-gradient(
                circle at 90% 20%,
                rgba(37, 99, 235, 0.28),
                transparent 30%
            ),
            linear-gradient(
                135deg,
                #06111f 0%,
                #0b1f38 65%,
                #123763 100%
            );

        border-radius: 28px;
        padding: 32px;
        color: white;
        margin-bottom: 24px;
        min-height: 180px;

        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;

        box-shadow:
            0 20px 55px rgba(6, 17, 31, 0.18);
    }


    .welcome-panel::after {
        content: "";

        position: absolute;

        width: 220px;
        height: 220px;

        border:
            1px solid rgba(255, 255, 255, 0.08);

        border-radius: 50%;

        right: -60px;
        bottom: -100px;

        animation:
            floatingCircle 7s ease-in-out infinite;
    }


    @@keyframes floatingCircle {

        0%,
        100% {
            transform:
                translateY(0)
                scale(1);
        }

        50% {
            transform:
                translateY(-18px)
                scale(1.05);
        }
    }


    .welcome-content {
        position: relative;
        z-index: 2;
    }


    .welcome-eyebrow {
        color: #7dd3fc;

        font-size: 13px;
        font-weight: 800;

        letter-spacing: 1.2px;

        text-transform: uppercase;

        margin-bottom: 10px;
    }


    .welcome-panel h1 {
        margin: 0 0 10px;

        font-size: 34px;
        font-weight: 900;

        letter-spacing: -0.8px;
    }


    .welcome-panel p {
        color: #cbd5e1;

        margin: 0;

        max-width: 620px;

        line-height: 1.65;
    }


    .system-status {
        position: relative;

        z-index: 2;

        min-width: 190px;

        background:
            rgba(255, 255, 255, 0.08);

        border:
            1px solid rgba(255, 255, 255, 0.13);

        backdrop-filter:
            blur(12px);

        border-radius: 20px;

        padding: 18px;
    }


    .status-label {
        color: #94a3b8;

        font-size: 12px;
        font-weight: 800;

        text-transform: uppercase;

        letter-spacing: 0.8px;

        margin-bottom: 8px;
    }


    .status-value {
        display: flex;
        align-items: center;

        gap: 9px;

        font-size: 16px;
        font-weight: 900;
    }


    .status-dot {
        width: 10px;
        height: 10px;

        border-radius: 50%;

        background: #22c55e;

        box-shadow:
            0 0 0 rgba(34, 197, 94, 0.5);

        animation:
            statusPulse 2s infinite;
    }


    @@keyframes statusPulse {

        0% {
            box-shadow:
                0 0 0 0 rgba(34, 197, 94, 0.5);
        }

        70% {
            box-shadow:
                0 0 0 9px rgba(34, 197, 94, 0);
        }

        100% {
            box-shadow:
                0 0 0 0 rgba(34, 197, 94, 0);
        }
    }


    /* =========================================================
       STAFF KPI CARDS
    ========================================================= */

    .kpi-grid {
        display: grid;

        grid-template-columns:
            repeat(4, minmax(0, 1fr));

        gap: 18px;

        margin-bottom: 24px;
    }


    .kpi-card {
        position: relative;

        overflow: hidden;

        background: white;

        border:
            1px solid #d8e6f3;

        border-radius: 22px;

        padding: 22px;

        min-height: 145px;

        box-shadow:
            0 10px 35px rgba(15, 23, 42, 0.055);

        transition:
            transform 0.28s ease,
            box-shadow 0.28s ease,
            border-color 0.28s ease;

        opacity: 0;

        transform:
            translateY(20px);

        animation:
            cardReveal 0.55s ease forwards;
    }


    .kpi-card:nth-child(1) {
        animation-delay: 0.05s;
    }

    .kpi-card:nth-child(2) {
        animation-delay: 0.10s;
    }

    .kpi-card:nth-child(3) {
        animation-delay: 0.15s;
    }

    .kpi-card:nth-child(4) {
        animation-delay: 0.20s;
    }

    .kpi-card:nth-child(5) {
        animation-delay: 0.25s;
    }

    .kpi-card:nth-child(6) {
        animation-delay: 0.30s;
    }

    .kpi-card:nth-child(7) {
        animation-delay: 0.35s;
    }

    .kpi-card:nth-child(8) {
        animation-delay: 0.40s;
    }


    @@keyframes cardReveal {

        to {
            opacity: 1;

            transform:
                translateY(0);
        }
    }


    .kpi-card:hover {
        transform:
            translateY(-6px);

        border-color:
            #93c5fd;

        box-shadow:
            0 18px 45px rgba(37, 99, 235, 0.12);
    }


    .kpi-card::before {
        content: "";

        position: absolute;

        top: 0;
        left: 0;

        height: 5px;
        width: 100%;

        background:
            linear-gradient(
                90deg,
                #2563eb,
                #38bdf8
            );
    }


    .kpi-top {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 12px;
    }


    .kpi-label {
        color: #64748b;

        font-size: 13px;
        font-weight: 800;

        text-transform: uppercase;

        letter-spacing: 0.5px;
    }


    .kpi-icon {
        width: 40px;
        height: 40px;

        border-radius: 13px;

        background: #eff6ff;

        color: #2563eb;

        display: grid;
        place-items: center;

        font-weight: 900;
    }


    .kpi-icon svg {
        width: 21px;
        height: 21px;
    }


    .kpi-number {
        color: #06111f;

        font-size: 38px;
        font-weight: 950;

        margin-top: 15px;

        line-height: 1;

        letter-spacing: -1px;
    }


    .kpi-footer {
        margin-top: 12px;

        color: #94a3b8;

        font-size: 12px;
        font-weight: 700;
    }


    /* =========================================================
       STAFF CHARTS AND PANELS
    ========================================================= */

    .chart-grid {
        display: grid;

        grid-template-columns:
            minmax(0, 1fr)
            minmax(0, 1fr);

        gap: 20px;

        margin-bottom: 24px;
    }


    .panel-card {
        background: white;

        border:
            1px solid #d8e6f3;

        border-radius: 24px;

        padding: 24px;

        box-shadow:
            0 12px 38px rgba(15, 23, 42, 0.055);

        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease;
    }


    .panel-card:hover {
        transform:
            translateY(-3px);

        box-shadow:
            0 18px 42px rgba(15, 23, 42, 0.08);
    }


    .panel-header {
        display: flex;

        justify-content: space-between;

        align-items: flex-start;

        gap: 12px;

        margin-bottom: 20px;
    }


    .panel-header h2 {
        margin:
            0 0 5px;

        color: #06111f;

        font-size: 19px;
        font-weight: 900;
    }


    .panel-header p {
        margin: 0;

        color: #94a3b8;

        font-size: 13px;
    }


    .chart-holder {
        position: relative;

        height: 290px;
    }


    .wide-chart {
        margin-bottom: 24px;
    }


    .wide-chart .chart-holder {
        height: 300px;
    }


    .bottom-grid {
        display: grid;

        grid-template-columns:
            minmax(0, 1.65fr)
            minmax(280px, 0.7fr);

        gap: 20px;

        margin-bottom: 24px;
    }


    .activity-list {
        display: flex;

        flex-direction: column;

        gap: 11px;
    }


    .activity-item {
        position: relative;

        display: grid;

        grid-template-columns:
            12px
            160px
            130px
            minmax(0, 1fr);

        align-items: center;

        gap: 12px;

        padding: 14px 15px;

        border:
            1px solid #e2e8f0;

        border-radius: 16px;

        background: #f8fafc;

        opacity: 0;

        transform:
            translateX(-12px);

        animation:
            activityReveal 0.45s ease forwards;
    }


    .activity-item:nth-child(1) {
        animation-delay: 0.05s;
    }

    .activity-item:nth-child(2) {
        animation-delay: 0.10s;
    }

    .activity-item:nth-child(3) {
        animation-delay: 0.15s;
    }

    .activity-item:nth-child(4) {
        animation-delay: 0.20s;
    }

    .activity-item:nth-child(5) {
        animation-delay: 0.25s;
    }

    .activity-item:nth-child(6) {
        animation-delay: 0.30s;
    }


    @@keyframes activityReveal {

        to {
            opacity: 1;

            transform:
                translateX(0);
        }
    }


    .activity-dot {
        width: 9px;
        height: 9px;

        border-radius: 50%;

        background: #2563eb;

        box-shadow:
            0 0 0 5px rgba(37, 99, 235, 0.10);
    }


    .activity-action {
        color: #0f172a;

        font-size: 13px;
        font-weight: 900;
    }


    .activity-user {
        color: #475569;

        font-size: 13px;
        font-weight: 700;
    }


    .activity-description {
        color: #64748b;

        font-size: 13px;

        line-height: 1.5;
    }


    .activity-time {
        color: #94a3b8;

        font-size: 11px;

        margin-top: 3px;
    }


    .quick-actions {
        display: flex;

        flex-direction: column;

        gap: 11px;
    }


    .quick-action {
        position: relative;

        overflow: hidden;

        display: flex;

        align-items: center;

        gap: 12px;

        text-decoration: none;

        color: #0f172a;

        background: #f8fafc;

        border:
            1px solid #e2e8f0;

        border-radius: 16px;

        padding: 14px;

        font-weight: 800;

        transition:
            transform 0.22s ease,
            border-color 0.22s ease,
            background 0.22s ease;
    }


    .quick-action:hover {
        transform:
            translateX(5px);

        border-color:
            #93c5fd;

        background:
            #eff6ff;

        color:
            #1d4ed8;
    }


    .quick-icon {
        width: 38px;
        height: 38px;

        border-radius: 12px;

        background: #dbeafe;

        color: #2563eb;

        display: grid;

        place-items: center;

        font-weight: 950;
    }


    .quick-icon svg {
        width: 20px;
        height: 20px;
    }


    .empty-state {
        padding: 30px;

        text-align: center;

        color: #64748b;

        border-radius: 16px;

        background: #f8fafc;

        border:
            1px dashed #cbd5e1;
    }


    /* =========================================================
       USER OPERATIONS PANEL
    ========================================================= */

    .user-operations-grid {
        display: grid;

        grid-template-columns:
            repeat(4, minmax(0, 1fr));

        gap: 16px;

        margin-bottom: 24px;
    }


    .user-operation-card {
        min-height: 150px;

        padding: 21px;

        display: flex;

        flex-direction: column;

        justify-content: space-between;

        text-decoration: none;

        color: #0f172a;

        background: #ffffff;

        border:
            1px solid #d8e6f3;

        border-radius: 20px;

        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease,
            border-color 0.25s ease;
    }


    .user-operation-card:hover {
        color: #0f172a;

        transform:
            translateY(-5px);

        border-color:
            #93c5fd;

        box-shadow:
            0 17px 38px rgba(37, 99, 235, 0.10);
    }


    .user-operation-icon {
        width: 44px;
        height: 44px;

        display: grid;
        place-items: center;

        border-radius: 14px;

        color: #2563eb;

        background:
            rgba(37, 99, 235, 0.09);
    }


    .user-operation-icon svg {
        width: 22px;
        height: 22px;
    }


    .user-operation-card strong {
        display: block;

        margin-top: 20px;

        font-size: 15px;
        font-weight: 850;
    }


    .user-operation-card small {
        display: block;

        margin-top: 5px;

        color: #64748b;

        font-size: 11px;

        line-height: 1.6;
    }


    /* =========================================================
       CUSTOMER DASHBOARD
    ========================================================= */

    .customer-dashboard {
        display: flex;

        flex-direction: column;

        gap: 24px;

        padding-bottom: 40px;
    }


    /* =========================================================
       CUSTOMER HERO
    ========================================================= */

    .customer-hero {
        position: relative;

        min-height: 350px;

        overflow: hidden;

        display: grid;

        grid-template-columns:
            minmax(0, 1.15fr)
            minmax(360px, 0.85fr);

        align-items: center;

        gap: 30px;

        padding: 44px 48px;

        border-radius: 30px;

        color: #ffffff;

        background:
            radial-gradient(
                circle at 84% 15%,
                rgba(14, 165, 233, 0.28),
                transparent 32%
            ),
            radial-gradient(
                circle at 68% 95%,
                rgba(37, 99, 235, 0.20),
                transparent 34%
            ),
            linear-gradient(
                125deg,
                #041426 0%,
                #082447 48%,
                #123d7a 100%
            );

        box-shadow:
            0 24px 60px rgba(15, 23, 42, 0.18);
    }


    .customer-hero::before {
        content: "";

        position: absolute;

        width: 420px;
        height: 420px;

        right: -140px;
        bottom: -220px;

        border:
            1px solid rgba(255, 255, 255, 0.12);

        border-radius: 50%;

        animation:
            heroCircleFloat 8s ease-in-out infinite;
    }


    .customer-hero::after {
        content: "";

        position: absolute;

        width: 280px;
        height: 280px;

        right: -50px;
        bottom: -150px;

        border:
            1px solid rgba(255, 255, 255, 0.08);

        border-radius: 50%;

        animation:
            heroCircleFloat 10s ease-in-out infinite reverse;
    }


    @@keyframes heroCircleFloat {

        0%,
        100% {
            transform:
                translateY(0)
                scale(1);
        }

        50% {
            transform:
                translateY(-18px)
                scale(1.04);
        }
    }


    .customer-hero-content {
        position: relative;

        z-index: 4;

        max-width: 760px;
    }


    .customer-eyebrow {
        display: inline-flex;

        align-items: center;

        gap: 9px;

        margin-bottom: 16px;

        color: #7dd3fc;

        font-size: 12px;
        font-weight: 800;

        letter-spacing: 1.6px;
    }


    .customer-live-dot {
        width: 8px;
        height: 8px;

        border-radius: 50%;

        background: #22c55e;

        box-shadow:
            0 0 0 rgba(34, 197, 94, 0.5);

        animation:
            customerPulse 1.8s infinite;
    }


    @@keyframes customerPulse {

        0% {
            box-shadow:
                0 0 0 0 rgba(34, 197, 94, 0.5);
        }

        70% {
            box-shadow:
                0 0 0 9px rgba(34, 197, 94, 0);
        }

        100% {
            box-shadow:
                0 0 0 0 rgba(34, 197, 94, 0);
        }
    }


    .customer-hero h1 {
        margin: 0;

        max-width: 720px;

        font-size:
            clamp(34px, 4vw, 58px);

        font-weight: 900;

        line-height: 1.03;

        letter-spacing: -2px;
    }


    .customer-hero h1 span {
        color: #7dd3fc;
    }


    .customer-hero p {
        max-width: 670px;

        margin:
            20px 0 0;

        color:
            rgba(226, 232, 240, 0.84);

        font-size: 16px;

        line-height: 1.8;
    }


    .customer-hero-actions {
        display: flex;

        flex-wrap: wrap;

        gap: 12px;

        margin-top: 28px;
    }


    .customer-primary-btn,
    .customer-secondary-btn {
        min-height: 50px;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        gap: 10px;

        padding:
            0 20px;

        border-radius: 14px;

        text-decoration: none;

        font-size: 14px;
        font-weight: 750;

        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease,
            background 0.25s ease;
    }


    .customer-primary-btn {
        color: #ffffff;

        background:
            linear-gradient(
                135deg,
                #2563eb,
                #38bdf8
            );

        box-shadow:
            0 14px 30px rgba(37, 99, 235, 0.32);
    }


    .customer-secondary-btn {
        color: #ffffff;

        background:
            rgba(255, 255, 255, 0.09);

        border:
            1px solid rgba(255, 255, 255, 0.16);

        backdrop-filter:
            blur(10px);
    }


    .customer-primary-btn:hover,
    .customer-secondary-btn:hover {
        color: #ffffff;

        transform:
            translateY(-3px);
    }


    .customer-primary-btn svg,
    .customer-secondary-btn svg {
        width: 19px;
        height: 19px;
    }


    /* =========================================================
       CUSTOMER TRAVEL VISUAL
    ========================================================= */

    .customer-travel-visual {
        position: relative;

        z-index: 3;

        min-height: 260px;
    }


    .customer-orbit {
        position: absolute;

        border:
            1px solid rgba(125, 211, 252, 0.18);

        border-radius: 50%;

        animation:
            customerOrbit 15s linear infinite;
    }


    .orbit-one {
        width: 220px;
        height: 220px;

        right: 20px;
        top: 10px;
    }


    .orbit-two {
        width: 155px;
        height: 155px;

        right: 54px;
        top: 43px;

        animation-direction:
            reverse;

        animation-duration:
            10s;
    }


    @@keyframes customerOrbit {

        from {
            transform:
                rotate(0deg);
        }

        to {
            transform:
                rotate(360deg);
        }
    }


    .customer-route-line {
        position: absolute;

        width: 84%;
        height: 90px;

        left: 5%;
        top: 92px;

        transform:
            rotate(-8deg);
    }


    .route-track {
        position: absolute;

        left: 0;
        right: 0;

        top: 42px;

        height: 4px;

        border-radius: 99px;

        background:
            repeating-linear-gradient(
                90deg,
                rgba(125, 211, 252, 0.9) 0 10px,
                transparent 10px 18px
            );
    }


    .moving-bus {
        position: absolute;

        top: 20px;
        left: 0;

        width: 48px;
        height: 48px;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 15px;

        color: #ffffff;

        background:
            linear-gradient(
                135deg,
                #2563eb,
                #0ea5e9
            );

        box-shadow:
            0 14px 30px rgba(14, 165, 233, 0.35);

        animation:
            customerBusMove 6s ease-in-out infinite alternate;
    }


    @@keyframes customerBusMove {

        from {
            left: 0;
        }

        to {
            left:
                calc(100% - 48px);
        }
    }


    .moving-bus svg {
        width: 27px;
        height: 27px;
    }


    .customer-map-pin {
        position: absolute;

        width: 32px;
        height: 32px;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius:
            50% 50% 50% 0;

        transform:
            rotate(-45deg);

        background: #ffffff;

        box-shadow:
            0 12px 30px rgba(15, 23, 42, 0.25);
    }


    .customer-map-pin span {
        width: 9px;
        height: 9px;

        border-radius: 50%;

        background: #2563eb;
    }


    .pin-one {
        left: 0;
        top: 121px;
    }


    .pin-two {
        right: 0;
        top: 53px;
    }


    .customer-visual-card {
        position: absolute;

        right: 28px;
        bottom: 0;

        min-width: 220px;

        display: flex;

        align-items: center;

        gap: 12px;

        padding: 14px;

        border-radius: 17px;

        background:
            rgba(255, 255, 255, 0.1);

        border:
            1px solid rgba(255, 255, 255, 0.14);

        backdrop-filter:
            blur(16px);

        animation:
            customerFloat 4s ease-in-out infinite;
    }


    @@keyframes customerFloat {

        0%,
        100% {
            transform:
                translateY(0);
        }

        50% {
            transform:
                translateY(-8px);
        }
    }


    .visual-card-icon {
        width: 42px;
        height: 42px;

        flex-shrink: 0;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 13px;

        color: #7dd3fc;

        background:
            rgba(56, 189, 248, 0.14);
    }


    .visual-card-icon svg {
        width: 22px;
        height: 22px;
    }


    .customer-visual-card small {
        display: block;

        margin-bottom: 3px;

        color: #7dd3fc;

        font-size: 9px;
        font-weight: 800;

        letter-spacing: 1px;
    }


    .customer-visual-card strong {
        font-size: 13px;
    }


    /* =========================================================
       CUSTOMER STATS
    ========================================================= */

    .customer-stats-grid {
        display: grid;

        grid-template-columns:
            repeat(3, minmax(0, 1fr));

        gap: 18px;
    }


    .customer-stat-card {
        position: relative;

        overflow: hidden;

