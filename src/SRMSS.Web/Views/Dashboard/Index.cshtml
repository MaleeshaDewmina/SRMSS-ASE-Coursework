@model SRMSS.Web.ViewModels.DashboardViewModel

@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Dashboard";
    ViewData["PageSubtitle"] = "Live overview of the SRMSS transport management system";

    string activityLabelsJson = JsonSerializer.Serialize(Model.ActivityLabels);
    string activityCountsJson = JsonSerializer.Serialize(Model.ActivityCounts);
}

<style>
    .dashboard-page {
        opacity: 0;
        transform: translateY(16px);
        animation: pageReveal 0.65s ease forwards;
    }

    @@keyframes pageReveal {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .welcome-panel {
        position: relative;
        overflow: hidden;
        background:
            radial-gradient(circle at 90% 20%, rgba(37, 99, 235, 0.28), transparent 30%),
            linear-gradient(135deg, #06111f 0%, #0b1f38 65%, #123763 100%);
        border-radius: 28px;
        padding: 32px;
        color: white;
        margin-bottom: 24px;
        min-height: 180px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        box-shadow: 0 20px 55px rgba(6, 17, 31, 0.18);
    }

    .welcome-panel::after {
        content: "";
        position: absolute;
        width: 220px;
        height: 220px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 50%;
        right: -60px;
        bottom: -100px;
        animation: floatingCircle 7s ease-in-out infinite;
    }

    @@keyframes floatingCircle {
        0%, 100% {
            transform: translateY(0) scale(1);
        }

        50% {
            transform: translateY(-18px) scale(1.05);
        }
    }

    .welcome-content {
        position: relative;
        z-index: 2;
    }

    .welcome-eyebrow {
        color: #7dd3fc;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .welcome-panel h1 {
        margin: 0 0 10px;
        font-size: 34px;
        font-weight: 900;
        letter-spacing: -0.8px;
    }

    .welcome-panel p {
        color: #cbd5e1;
        margin: 0;
        max-width: 620px;
        line-height: 1.65;
    }

    .system-status {
        position: relative;
        z-index: 2;
        min-width: 190px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.13);
        backdrop-filter: blur(12px);
        border-radius: 20px;
        padding: 18px;
    }

    .status-label {
        color: #94a3b8;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 8px;
    }

    .status-value {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 16px;
        font-weight: 900;
    }

    .status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 0 rgba(34, 197, 94, 0.5);
        animation: statusPulse 2s infinite;
    }

    @@keyframes statusPulse {
        0% {
            box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5);
        }

        70% {
            box-shadow: 0 0 0 9px rgba(34, 197, 94, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
        }
    }

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 24px;
    }

    .kpi-card {
        position: relative;
        overflow: hidden;
        background: white;
        border: 1px solid #d8e6f3;
        border-radius: 22px;
        padding: 22px;
        min-height: 145px;
        box-shadow: 0 10px 35px rgba(15, 23, 42, 0.055);
        transition:
            transform 0.28s ease,
            box-shadow 0.28s ease,
            border-color 0.28s ease;
        opacity: 0;
        transform: translateY(20px);
        animation: cardReveal 0.55s ease forwards;
    }

    .kpi-card:nth-child(1) { animation-delay: 0.05s; }
    .kpi-card:nth-child(2) { animation-delay: 0.10s; }
    .kpi-card:nth-child(3) { animation-delay: 0.15s; }
    .kpi-card:nth-child(4) { animation-delay: 0.20s; }
    .kpi-card:nth-child(5) { animation-delay: 0.25s; }
    .kpi-card:nth-child(6) { animation-delay: 0.30s; }
    .kpi-card:nth-child(7) { animation-delay: 0.35s; }
    .kpi-card:nth-child(8) { animation-delay: 0.40s; }

    @@keyframes cardReveal {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .kpi-card:hover {
        transform: translateY(-6px);
        border-color: #93c5fd;
        box-shadow: 0 18px 45px rgba(37, 99, 235, 0.12);
    }

    .kpi-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        height: 5px;
        width: 100%;
        background: linear-gradient(90deg, #2563eb, #38bdf8);
    }

    .kpi-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .kpi-label {
        color: #64748b;
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .kpi-icon {
        width: 40px;
        height: 40px;
        border-radius: 13px;
        background: #eff6ff;
        color: #2563eb;
        display: grid;
        place-items: center;
        font-weight: 900;
    }

    .kpi-icon svg {
        width: 21px;
        height: 21px;
    }

    .kpi-number {
        color: #06111f;
        font-size: 38px;
        font-weight: 950;
        margin-top: 15px;
        line-height: 1;
        letter-spacing: -1px;
    }

    .kpi-footer {
        margin-top: 12px;
        color: #94a3b8;
        font-size: 12px;
        font-weight: 700;
    }

    .chart-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 20px;
        margin-bottom: 24px;
    }

    .panel-card {
        background: white;
        border: 1px solid #d8e6f3;
        border-radius: 24px;
        padding: 24px;
        box-shadow: 0 12px 38px rgba(15, 23, 42, 0.055);
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease;
    }

    .panel-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 42px rgba(15, 23, 42, 0.08);
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 20px;
    }

    .panel-header h2 {
        margin: 0 0 5px;
        color: #06111f;
        font-size: 19px;
        font-weight: 900;
    }

    .panel-header p {
        margin: 0;
        color: #94a3b8;
        font-size: 13px;
    }

    .chart-holder {
        position: relative;
        height: 290px;
    }

    .wide-chart {
        margin-bottom: 24px;
    }

    .wide-chart .chart-holder {
        height: 300px;
    }

    .bottom-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.65fr) minmax(280px, 0.7fr);
        gap: 20px;
        margin-bottom: 24px;
    }

    .activity-list {
        display: flex;
        flex-direction: column;
        gap: 11px;
    }

    .activity-item {
        position: relative;
        display: grid;
        grid-template-columns: 12px 160px 130px minmax(0, 1fr);
        align-items: center;
        gap: 12px;
        padding: 14px 15px;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        background: #f8fafc;
        opacity: 0;
        transform: translateX(-12px);
        animation: activityReveal 0.45s ease forwards;
    }

    .activity-item:nth-child(1) { animation-delay: 0.05s; }
    .activity-item:nth-child(2) { animation-delay: 0.10s; }
    .activity-item:nth-child(3) { animation-delay: 0.15s; }
    .activity-item:nth-child(4) { animation-delay: 0.20s; }
    .activity-item:nth-child(5) { animation-delay: 0.25s; }
    .activity-item:nth-child(6) { animation-delay: 0.30s; }

    @@keyframes activityReveal {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .activity-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #2563eb;
        box-shadow: 0 0 0 5px rgba(37, 99, 235, 0.10);
    }

    .activity-action {
        font-weight: 900;
        color: #0f172a;
        font-size: 13px;
    }

    .activity-user {
        color: #475569;
        font-size: 13px;
        font-weight: 700;
    }

    .activity-description {
        color: #64748b;
        font-size: 13px;
        line-height: 1.5;
    }

    .activity-time {
        color: #94a3b8;
        font-size: 11px;
        margin-top: 3px;
    }

    .quick-actions {
        display: flex;
        flex-direction: column;
        gap: 11px;
    }

    .quick-action {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: #0f172a;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 14px;
        font-weight: 800;
        transition:
            transform 0.22s ease,
            border-color 0.22s ease,
            background 0.22s ease;
    }

    .quick-action:hover {
        transform: translateX(5px);
        border-color: #93c5fd;
        background: #eff6ff;
        color: #1d4ed8;
    }

    .quick-icon {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: #dbeafe;
        color: #2563eb;
        display: grid;
        place-items: center;
        font-weight: 950;
    }

    .quick-icon svg {
        width: 20px;
        height: 20px;
    }

    .empty-state {
        padding: 30px;
        text-align: center;
        color: #64748b;
        border-radius: 16px;
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
    }

    @@media (max-width: 1200px) {
        .kpi-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 950px) {
        .chart-grid,
        .bottom-grid {
            grid-template-columns: 1fr;
        }

        .activity-item {
            grid-template-columns: 12px 1fr;
        }

        .activity-user,
        .activity-description {
            grid-column: 2;
        }
    }

    @@media (max-width: 650px) {
        .welcome-panel {
            flex-direction: column;
            align-items: flex-start;
            padding: 24px;
        }

        .system-status {
            width: 100%;
        }

        .kpi-grid {
            grid-template-columns: 1fr;
        }

        .welcome-panel h1 {
            font-size: 28px;
        }
    }
</style>

<div class="dashboard-page">

    <section class="welcome-panel">

        <div class="welcome-content">

            <div class="welcome-eyebrow">
                SRMSS Command Center
            </div>

            <h1>
                Welcome back, @Model.FullName
            </h1>

            <p>
                Monitor transport operations, system activity, accounts,
                routes, schedules and current trip performance from one place.
            </p>

        </div>

        <div class="system-status">

            <div class="status-label">
                System Status
            </div>

            <div class="status-value">

                <span class="status-dot"></span>

                Operational

            </div>

        </div>

    </section>


    @if (Model.Role == "SuperAdmin")
    {
        <section class="kpi-grid">

            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-label">Admins</span>
                    <span class="kpi-icon"><partial name="_AppIcon" model='"users"' /></span>
                </div>

                <div class="kpi-number count-up"
                     data-target="@Model.TotalAdmins">
                    0
                </div>

                <div class="kpi-footer">
                    Administrative accounts
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-label">Users</span>
                    <span class="kpi-icon"><partial name="_AppIcon" model='"users"' /></span>
                </div>

                <div class="kpi-number count-up"
                     data-target="@Model.TotalUsers">
                    0
                </div>

                <div class="kpi-footer">
                    Operational users
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-label">Customers</span>
                    <span class="kpi-icon"><partial name="_AppIcon" model='"customer"' /></span>
                </div>

                <div class="kpi-number count-up"
                     data-target="@Model.TotalCustomers">
                    0
                </div>

                <div class="kpi-footer">
                    Registered customers
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-label">Audit Logs</span>
                    <span class="kpi-icon"><partial name="_AppIcon" model='"audit"' /></span>
                </div>

                <div class="kpi-number count-up"
                     data-target="@Model.TotalAuditLogs">
                    0
                </div>

                <div class="kpi-footer">
                    Recorded system events
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-label">Active Accounts</span>
                    <span class="kpi-icon"><partial name="_AppIcon" model='"active"' /></span>
                </div>

                <div class="kpi-number count-up"
                     data-target="@Model.ActiveAccounts">
                    0
                </div>

                <div class="kpi-footer">
                    Currently active accounts
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-label">Inactive Accounts</span>
                    <span class="kpi-icon"><partial name="_AppIcon" model='"inactive"' /></span>
                </div>

                <div class="kpi-number count-up"
                     data-target="@Model.InactiveAccounts">
                    0
                </div>

                <div class="kpi-footer">
                    Disabled accounts
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-label">Routes</span>
                    <span class="kpi-icon"><partial name="_AppIcon" model='"route"' /></span>
                </div>

                <div class="kpi-number count-up"
                     data-target="@Model.TotalRoutes">
                    0
                </div>

                <div class="kpi-footer">
                    Transport routes
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-label">Schedules</span>
                    <span class="kpi-icon"><partial name="_AppIcon" model='"schedule"' /></span>
                </div>

                <div class="kpi-number count-up"
                     data-target="@Model.TotalSchedules">
                    0
                </div>

                <div class="kpi-footer">
                    Current schedules
                </div>
            </div>

        </section>

        <section class="chart-grid">

            <div class="panel-card">

                <div class="panel-header">
                    <div>
                        <h2>Account Distribution</h2>
                        <p>Current account structure by system role</p>
                    </div>
                </div>

                <div class="chart-holder">
                    <canvas id="accountDistributionChart"></canvas>
                </div>

            </div>

            <div class="panel-card">

                <div class="panel-header">
                    <div>
                        <h2>Trip Status Overview</h2>
                        <p>Live operational status across current schedules</p>
                    </div>
                </div>

                <div class="chart-holder">
                    <canvas id="tripStatusChart"></canvas>
                </div>

            </div>

        </section>
    }
    else
    {
        <section class="kpi-grid">

            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-label">Routes</span>
                    <span class="kpi-icon"><partial name="_AppIcon" model='"route"' /></span>
                </div>

                <div class="kpi-number count-up"
                     data-target="@Model.TotalRoutes">
                    0
                </div>

                <div class="kpi-footer">
                    Available routes
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-label">Schedules</span>
                    <span class="kpi-icon"><partial name="_AppIcon" model='"schedule"' /></span>
                </div>

                <div class="kpi-number count-up"
                     data-target="@Model.TotalSchedules">
                    0
                </div>

                <div class="kpi-footer">
                    Current schedules
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-label">Active Trips</span>
                    <span class="kpi-icon"><partial name="_AppIcon" model='"active"' /></span>
                </div>

                <div class="kpi-number count-up"
                     data-target="@Model.ActiveTrips">
                    0
                </div>

                <div class="kpi-footer">
                    Trips currently active
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="kpi-label">Delayed Trips</span>
                    <span class="kpi-icon"><partial name="_AppIcon" model='"trip"' /></span>
                </div>

                <div class="kpi-number count-up"
                     data-target="@Model.DelayedTrips">
                    0
                </div>

                <div class="kpi-footer">
                    Trips requiring attention
                </div>
            </div>

        </section>

        <section class="panel-card wide-chart">

            <div class="panel-header">
                <div>
                    <h2>Trip Status Overview</h2>
                    <p>Current transport operation performance</p>
                </div>
            </div>

            <div class="chart-holder">
                <canvas id="tripStatusChart"></canvas>
            </div>

        </section>
    }


    <section class="panel-card wide-chart">

        <div class="panel-header">
            <div>
                <h2>System Activity</h2>
                <p>Audit events recorded during the last seven days</p>
            </div>
        </div>

        <div class="chart-holder">
            <canvas id="activityChart"></canvas>
        </div>

    </section>


    <section class="bottom-grid">

        <div class="panel-card">

            <div class="panel-header">

                <div>
                    <h2>Recent System Activity</h2>
                    <p>Latest important actions recorded by SRMSS</p>
                </div>

                @if (Model.Role == "SuperAdmin")
                {
                    <a href="/AuditLogs"
                       style="text-decoration:none; font-weight:800; color:#2563eb;">
                        View all
                    </a>
                }

            </div>

            @if (Model.RecentAuditLogs.Any())
            {
                <div class="activity-list">

                    @foreach (var log in Model.RecentAuditLogs)
                    {
                        <div class="activity-item">

                            <div class="activity-dot"></div>

                            <div>
                                <div class="activity-action">
                                    @log.Action
                                </div>

                                <div class="activity-time">
                                    @log.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                                </div>
                            </div>

                            <div class="activity-user">
                                @(log.AppUser != null
                                    ? log.AppUser.Username
                                    : "System")
                            </div>

                            <div class="activity-description">
                                @log.Description
                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="empty-state">
                    No recent system activity available.
                </div>
            }

        </div>


        <div class="panel-card">

            <div class="panel-header">
                <div>
                    <h2>Quick Actions</h2>
                    <p>Common system operations</p>
                </div>
            </div>

            <div class="quick-actions">

                @if (Model.Role == "SuperAdmin" || Model.Role == "Admin")
                {
                    <a href="/TransportRoutes/Create"
                       class="quick-action">

                        <span class="quick-icon"><partial name="_AppIcon" model='"add"' /></span>

                        Add New Route

                    </a>

                    <a href="/Schedules/Create"
                       class="quick-action">

                        <span class="quick-icon"><partial name="_AppIcon" model='"add"' /></span>

                        Add Schedule

                    </a>

                    <a href="/TransportRoutes"
                       class="quick-action">

                        <span class="quick-icon"><partial name="_AppIcon" model='"route"' /></span>

                        Manage Routes

                    </a>

                    <a href="/TripStatus"
                       class="quick-action">

                        <span class="quick-icon"><partial name="_AppIcon" model='"trip"' /></span>

                        View Trip Status

                    </a>
                }

                @if (Model.Role == "SuperAdmin")
                {
                    <a href="/Users"
                       class="quick-action">

                        <span class="quick-icon"><partial name="_AppIcon" model='"users"' /></span>

                        Manage Users

                    </a>

                    <a href="/AuditLogs"
                       class="quick-action">

                        <span class="quick-icon"><partial name="_AppIcon" model='"audit"' /></span>

                        Audit Logs

                    </a>
                }

                @if (Model.Role == "Customer")
                {
                    <a href="/CustomerRoutes"
                       class="quick-action">

                        <span class="quick-icon"><partial name="_AppIcon" model='"search"' /></span>

                        Search Routes

                    </a>
                }

                <a href="/Account/Profile"
                   class="quick-action">

                    <span class="quick-icon"><partial name="_AppIcon" model='"profile"' /></span>

                    My Profile

                </a>

            </div>

        </div>

    </section>

</div>


@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Count-up animation
            const counters = document.querySelectorAll(".count-up");

            counters.forEach(counter => {

                const target = parseInt(counter.dataset.target || "0");
                const duration = 900;

                let startTime = null;

                function animateCounter(timestamp) {

                    if (!startTime) {
                        startTime = timestamp;
                    }

                    const progress = Math.min(
                        (timestamp - startTime) / duration,
                        1
                    );

                    const currentValue = Math.floor(
                        progress * target
                    );

                    counter.textContent = currentValue;

                    if (progress < 1) {
                        requestAnimationFrame(animateCounter);
                    } else {
                        counter.textContent = target;
                    }
                }

                requestAnimationFrame(animateCounter);
            });


            Chart.defaults.font.family =
                "Inter, Segoe UI, Arial, sans-serif";

            Chart.defaults.color = "#64748b";


            @if (Model.Role == "SuperAdmin")
            {
                <text>
                    const accountCanvas =
                        document.getElementById("accountDistributionChart");

                    if (accountCanvas) {

                        new Chart(accountCanvas, {

                            type: "doughnut",

                            data: {
                                labels: [
                                    "Admins",
                                    "Users",
                                    "Customers"
                                ],

                                datasets: [{
                                    data: [
                                        @Model.TotalAdmins,
                                        @Model.TotalUsers,
                                        @Model.TotalCustomers
                                    ],

                                    backgroundColor: [
                                        "#2563eb",
                                        "#38bdf8",
                                        "#8b5cf6"
                                    ],

                                    borderWidth: 0,

                                    hoverOffset: 8
                                }]
                            },

                            options: {
                                responsive: true,

                                maintainAspectRatio: false,

                                cutout: "72%",

                                animation: {
                                    duration: 1200,
                                    easing: "easeOutQuart"
                                },

                                plugins: {
                                    legend: {
                                        position: "bottom",

                                        labels: {
                                            usePointStyle: true,
                                            pointStyle: "circle",
                                            padding: 18
                                        }
                                    }
                                }
                            }
                        });
                    }
                </text>
            }


            const tripCanvas =
                document.getElementById("tripStatusChart");

            if (tripCanvas) {

                new Chart(tripCanvas, {

                    type: "bar",

                    data: {

                        labels: [
                            "Active",
                            "Delayed",
                            "Completed"
                        ],

                        datasets: [{
                            label: "Trips",

                            data: [
                                @Model.ActiveTrips,
                                @Model.DelayedTrips,
                                @Model.CompletedTrips
                            ],

                            backgroundColor: [
                                "#2563eb",
                                "#f59e0b",
                                "#22c55e"
                            ],

                            borderRadius: 10,

                            borderSkipped: false
                        }]
                    },

                    options: {

                        responsive: true,

                        maintainAspectRatio: false,

                        animation: {
                            duration: 1200,
                            easing: "easeOutQuart"
                        },

                        scales: {

                            y: {
                                beginAtZero: true,

                                ticks: {
                                    precision: 0
                                },

                                grid: {
                                    color: "rgba(148, 163, 184, 0.15)"
                                },

                                border: {
                                    display: false
                                }
                            },

                            x: {
                                grid: {
                                    display: false
                                },

                                border: {
                                    display: false
                                }
                            }
                        },

                        plugins: {
                            legend: {
                                display: false
                            }
                        }
                    }
                });
            }


            const activityLabels =
                @Html.Raw(activityLabelsJson);

            const activityCounts =
                @Html.Raw(activityCountsJson);

            const activityCanvas =
                document.getElementById("activityChart");

            if (activityCanvas) {

                new Chart(activityCanvas, {

                    type: "line",

                    data: {

                        labels: activityLabels,

                        datasets: [{
                            label: "System Events",

                            data: activityCounts,

                            borderColor: "#2563eb",

                            backgroundColor:
                                "rgba(37, 99, 235, 0.10)",

                            fill: true,

                            tension: 0.42,

                            borderWidth: 3,

                            pointRadius: 5,

                            pointHoverRadius: 7,

                            pointBackgroundColor: "#2563eb",

                            pointBorderColor: "#ffffff",

                            pointBorderWidth: 2
                        }]
                    },

                    options: {

                        responsive: true,

                        maintainAspectRatio: false,

                        animation: {
                            duration: 1300,
                            easing: "easeOutQuart"
                        },

                        interaction: {
                            intersect: false,
                            mode: "index"
                        },

                        scales: {

                            y: {
                                beginAtZero: true,

                                ticks: {
                                    precision: 0
                                },

                                grid: {
                                    color: "rgba(148, 163, 184, 0.15)"
                                },

                                border: {
                                    display: false
                                }
                            },

                            x: {

                                grid: {
                                    display: false
                                },

                                border: {
                                    display: false
                                }
                            }
                        },

                        plugins: {

                            legend: {
                                display: false
                            }
                        }
                    }
                });
            }

        });
    </script>
}