            cubic-bezier(.2, .8, .2, 1)
            forwards;

        animation-delay:
            var(--delay, 0s);
    }


    @@keyframes customerReveal {

        to {
            opacity: 1;

            transform:
                translateY(0);
        }
    }


    /* =========================================================
       DARK MODE
    ========================================================= */

    [data-theme="dark"] .kpi-card,
    [data-theme="dark"] .panel-card,
    [data-theme="dark"] .user-operation-card,
    [data-theme="dark"] .customer-stat-card,
