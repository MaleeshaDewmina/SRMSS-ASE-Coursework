@model SRMSS.Web.Models.Announcement

@{
    ViewData["Title"] = "Delete Announcement";
    ViewData["PageTitle"] = "Delete Announcement";
    ViewData["PageSubtitle"] = "Remove an announcement from the communication center.";
}

<div class="srmss-card danger-panel">
    <h3 class="card-title">Delete Announcement</h3>
    <p class="card-subtitle">This action permanently removes the announcement.</p>
    <div class="detail-list mb-4">
        <div><span>Title</span><strong>@Model.Title</strong></div>
        <div><span>Audience</span><strong>@Model.Audience</strong></div>
        <div><span>Status</span><strong>@Model.Status</strong></div>
    </div>
    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="enterprise-form-actions">
            <a asp-action="Index" class="srmss-btn secondary">Cancel</a>
            <button type="submit" class="srmss-btn danger">Delete Announcement</button>
        </div>
    </form>
</div>


