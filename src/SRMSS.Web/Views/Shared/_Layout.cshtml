@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    string IsActive(string controller)
    {
        return currentController == controller ? "active" : "";
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SRMSS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <div class="srmss-shell">
        <aside class="srmss-sidebar">
            <div class="brand-box">
                <div class="brand-logo">S</div>
                <div>
                    <h1>SRMSS</h1>
                    <p>Depot Control</p>
                </div>
            </div>

            <div class="sidebar-line"></div>

            <nav class="side-nav">
                <a class="side-link @IsActive("Home")" asp-controller="Home" asp-action="Index">
                    <span>D</span> Dashboard
                </a>

                <a class="side-link @IsActive("TransportRoutes")" asp-controller="TransportRoutes" asp-action="Index">
                    <span>R</span> Routes
                </a>

                <a class="side-link @IsActive("RouteStops")" asp-controller="RouteStops" asp-action="Index">
                    <span>St</span> Route Stops
                </a>

                <a class="side-link @IsActive("Schedules")" asp-controller="Schedules" asp-action="Index">
                    <span>S</span> Schedules
                </a>

                <a class="side-link @IsActive("CustomerRoutes")" asp-controller="CustomerRoutes" asp-action="Index">
                    <span>C</span> Customer Routes
                </a>

                <a class="side-link @IsActive("TripStatus")" asp-controller="TripStatus" asp-action="Index">
                    <span>T</span> Trip Status
                </a>

                <a class="side-link" href="#">
                    <span>Dr</span> Drivers
                </a>

                <a class="side-link" href="#">
                    <span>V</span> Vehicles
                </a>

                <a class="side-link" href="#">
                    <span>F</span> Fuel Logs
                </a>

                <a class="side-link" href="#">
                    <span>M</span> Maintenance
                </a>

                <a class="side-link" href="#">
                    <span>P</span> Reports
                </a>
            </nav>

            <div class="sidebar-user">
                <div class="user-avatar">D</div>
                <div>
                    <strong>Denuwan</strong>
                    <small>Route Manager</small>
                </div>
            </div>
        </aside>

        <main class="srmss-main">
            <header class="topbar">
                <div>
                    <h2>@ViewData["PageTitle"]</h2>
                    <p>@ViewData["PageSubtitle"]</p>
                </div>

                <div class="topbar-actions">
                    <input class="top-search" placeholder="Search route, bus, driver..." />
                    <div class="top-icon warning">!</div>
                    <div class="top-icon info">?</div>
                    <div class="admin-chip">
                        <div class="admin-avatar">D</div>
                        <div>
                            <strong>Admin</strong>
                            <small>Depot HQ</small>
                        </div>
                    </div>
                </div>
            </header>

            <section class="page-content">
                @RenderBody()
            </section>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>