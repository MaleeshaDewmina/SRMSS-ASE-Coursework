@model IEnumerable<SRMSS.Web.Models.TransportRoute>

@{
    ViewData["Title"] = "Explore Routes";

    ViewData["PageTitle"] = "Explore Routes";

    ViewData["PageSubtitle"] =
        "Find the right journey, explore stops and save your favourite routes.";


    string fromValue =
        ViewBag.From as string
        ?? string.Empty;


    string toValue =
        ViewBag.To as string
        ?? string.Empty;


    bool searchPerformed =
        ViewBag.SearchPerformed is bool value
        &&
        value;


    var favoriteRouteIds =
        ViewBag.FavoriteRouteIds
        as HashSet<int>
        ?? new HashSet<int>();


    var favoriteRoutes =
        ViewBag.FavoriteRoutes
        as List<SRMSS.Web.Models.FavoriteRoute>
        ?? new List<SRMSS.Web.Models.FavoriteRoute>();


    var popularRoutes =
        ViewBag.PopularRoutes
        as List<SRMSS.Web.Models.TransportRoute>
        ?? new List<SRMSS.Web.Models.TransportRoute>();


    var locationSuggestions =
        ViewBag.LocationSuggestions
        as List<string>
        ?? new List<string>();


    int totalActiveRoutes =
        ViewBag.TotalActiveRoutes is int routeCount
            ? routeCount
            : 0;


    int upcomingSchedules =
        ViewBag.UpcomingSchedules is int scheduleCount
            ? scheduleCount
            : 0;
}


<style>

    /* =========================================================
       PAGE
    ========================================================= */

    .customer-explore-page {
        display: flex;
        flex-direction: column;
        gap: 22px;
        padding-bottom: 44px;
    }


    .cr-reveal {
        opacity: 0;
        transform: translateY(20px);

        animation:
            customerRouteReveal
            0.7s
            cubic-bezier(.2, .8, .2, 1)
            forwards;

        animation-delay:
            var(--delay, 0s);
    }


    @@keyframes customerRouteReveal {

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* =========================================================
       HERO
    ========================================================= */

    .customer-route-modern-hero {
        position: relative;
        overflow: hidden;

        min-height: 340px;

        display: grid;

        grid-template-columns:
            minmax(0, 1.15fr)
            minmax(330px, 0.85fr);

        align-items: center;

        gap: 30px;

        padding:
            44px 48px;

        border-radius: 30px;

        color: #ffffff;

        background:
            radial-gradient(
                circle at 84% 14%,
                rgba(56, 189, 248, 0.28),
                transparent 30%
            ),
            radial-gradient(
                circle at 70% 110%,
                rgba(37, 99, 235, 0.25),
                transparent 38%
            ),
            linear-gradient(
                125deg,
                #041426 0%,
                #082447 48%,
                #123d7a 100%
            );

        box-shadow:
            0 24px 60px rgba(15, 23, 42, 0.17);
    }


    .customer-route-modern-hero::before {
        content: "";

        position: absolute;

        width: 450px;
        height: 450px;

        right: -160px;
        bottom: -260px;

        border:
            1px solid rgba(255, 255, 255, 0.11);

        border-radius: 50%;

        animation:
            routeHeroCircle
            8s
            ease-in-out
            infinite;
    }


    .customer-route-modern-hero::after {
        content: "";

        position: absolute;

        width: 300px;
        height: 300px;

        right: -60px;
        bottom: -170px;

        border:
            1px solid rgba(255, 255, 255, 0.08);

        border-radius: 50%;

        animation:
            routeHeroCircle
            10s
            ease-in-out
            infinite
            reverse;
    }


    @@keyframes routeHeroCircle {

        0%,
        100% {
            transform:
                translateY(0)
                scale(1);
        }

        50% {
            transform:
                translateY(-18px)
                scale(1.04);
        }
    }


    .customer-route-hero-copy {
        position: relative;
        z-index: 4;
    }


    .customer-route-eyebrow {
        display: inline-flex;
        align-items: center;

        gap: 9px;

        margin-bottom: 15px;

        color: #7dd3fc;

        font-size: 11px;
        font-weight: 850;

        letter-spacing: 1.6px;
    }


    .customer-route-live-dot {
        width: 8px;
        height: 8px;

        border-radius: 50%;

        background: #22c55e;

        box-shadow:
            0 0 0 rgba(34, 197, 94, 0.45);

        animation:
            customerRoutePulse
            1.8s
            infinite;
    }


    @@keyframes customerRoutePulse {

        0% {
            box-shadow:
                0 0 0 0
                rgba(34, 197, 94, 0.45);
        }

        70% {
            box-shadow:
                0 0 0 9px
                rgba(34, 197, 94, 0);
        }

        100% {
            box-shadow:
                0 0 0 0
                rgba(34, 197, 94, 0);
        }
    }


    .customer-route-modern-hero h1 {
        margin: 0;

        max-width: 690px;

        font-size:
            clamp(38px, 4.5vw, 64px);

        font-weight: 900;

        line-height: 1.02;

        letter-spacing: -2.5px;
    }


    .customer-route-modern-hero h1 span {
        color: #7dd3fc;
    }


    .customer-route-modern-hero p {
        max-width: 660px;

        margin:
            20px 0 0;

        color:
            rgba(226, 232, 240, 0.84);

        font-size: 15px;

        line-height: 1.8;
    }


    .customer-route-hero-stats {
        display: flex;
        flex-wrap: wrap;

        gap: 11px;

        margin-top: 27px;
    }


    .customer-route-hero-stat {
        min-width: 135px;

        padding:
            12px 15px;

        border-radius: 15px;

        background:
            rgba(255, 255, 255, 0.08);

        border:
            1px solid rgba(255, 255, 255, 0.13);

        backdrop-filter:
            blur(12px);
    }


    .customer-route-hero-stat strong {
        display: block;

        color: #ffffff;

        font-size: 22px;
        font-weight: 900;
    }


    .customer-route-hero-stat span {
        display: block;

        margin-top: 2px;

        color: #94a3b8;

        font-size: 10px;
        font-weight: 750;
    }


    /* =========================================================
       HERO VISUAL
    ========================================================= */

    .customer-route-visual {
        position: relative;
        z-index: 4;

        min-height: 250px;
    }


    .visual-route-track {
        position: absolute;

        width: 88%;
        height: 130px;

        left: 5%;
        top: 55px;

        transform:
            rotate(-7deg);
    }


    .visual-route-track::before {
        content: "";

        position: absolute;

        left: 0;
        right: 0;
        top: 62px;

        height: 4px;

        background:
            repeating-linear-gradient(
                90deg,
                rgba(125, 211, 252, 0.95)
                    0 11px,
                transparent
                    11px 20px
            );

        border-radius: 99px;
    }


    .visual-route-bus {
        position: absolute;

        width: 54px;
        height: 54px;

        left: 0;
        top: 36px;

        display: grid;
        place-items: center;

        border-radius: 16px;

        color: #ffffff;

        background:
            linear-gradient(
                135deg,
                #2563eb,
                #0ea5e9
            );

        box-shadow:
            0 15px 32px
            rgba(14, 165, 233, 0.38);

        animation:
            routeBusTravel
            5.5s
            ease-in-out
            infinite
            alternate;
    }


    @@keyframes routeBusTravel {

        from {
            left: 0;
        }

        to {
            left:
                calc(100% - 54px);
        }
    }


    .visual-route-bus svg {
        width: 29px;
        height: 29px;
    }


    .visual-location-pin {
        position: absolute;

        width: 38px;
        height: 38px;

        display: grid;
        place-items: center;

        border-radius:
            50% 50% 50% 0;

        transform:
            rotate(-45deg);

        background: #ffffff;

        box-shadow:
            0 14px 30px
            rgba(15, 23, 42, 0.25);
    }


    .visual-location-pin::after {
        content: "";

        width: 10px;
        height: 10px;

        border-radius: 50%;

        background: #2563eb;
    }


    .visual-location-pin.start {
        left: 0;
        top: 137px;
    }


    .visual-location-pin.end {
        right: 0;
        top: 63px;
    }


    .visual-floating-card {
        position: absolute;

        right: 22px;
        bottom: -3px;

        min-width: 210px;

        padding: 14px;

        display: flex;
        align-items: center;

        gap: 11px;

        border-radius: 17px;

        background:
            rgba(255, 255, 255, 0.10);

        border:
            1px solid rgba(255, 255, 255, 0.14);

        backdrop-filter:
            blur(16px);

        animation:
            visualFloat
            4s
            ease-in-out
            infinite;
    }


    @@keyframes visualFloat {

        0%,
        100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-8px);
        }
    }


    .visual-floating-icon {
        width: 42px;
        height: 42px;

        flex-shrink: 0;

        display: grid;
        place-items: center;

        border-radius: 13px;

        color: #7dd3fc;

        background:
            rgba(56, 189, 248, 0.14);
    }


    .visual-floating-icon svg {
        width: 22px;
        height: 22px;
    }


    .visual-floating-card small {
        display: block;

        color: #7dd3fc;

        font-size: 9px;
        font-weight: 850;

        letter-spacing: 1px;
    }


    .visual-floating-card strong {
        display: block;

        margin-top: 3px;

        font-size: 13px;
    }


    /* =========================================================
       ALERTS
    ========================================================= */

    .customer-modern-alert {
        display: flex;
        align-items: center;

        gap: 11px;

        padding:
            14px 17px;

        border-radius: 16px;

        font-size: 13px;
        font-weight: 700;

        animation:
            alertSlide
            0.45s
            ease
            forwards;
    }


    .customer-modern-alert.success {
        color: #166534;

        background:
            rgba(34, 197, 94, 0.10);

        border:
            1px solid rgba(34, 197, 94, 0.20);
    }


    .customer-modern-alert.warning {
        color: #92400e;

        background:
            rgba(245, 158, 11, 0.11);

        border:
            1px solid rgba(245, 158, 11, 0.23);
    }


    @@keyframes alertSlide {

        from {
            opacity: 0;
            transform:
                translateY(-8px);
        }

        to {
            opacity: 1;
            transform:
                translateY(0);
        }
    }


    /* =========================================================
       SEARCH PANEL
    ========================================================= */

    .customer-modern-search {
        position: relative;

        z-index: 5;

        margin-top: -50px;

        padding: 26px;

        border-radius: 25px;

        background: #ffffff;

        border:
            1px solid rgba(148, 163, 184, 0.20);

        box-shadow:
            0 20px 50px
            rgba(15, 23, 42, 0.11);
    }


    .customer-search-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;

        gap: 20px;

        margin-bottom: 20px;
    }


    .customer-search-heading span {
        display: block;

        margin-bottom: 5px;

        color: #2563eb;

        font-size: 10px;
        font-weight: 850;

        letter-spacing: 1.2px;
    }


    .customer-search-heading h2 {
        margin: 0;

        color: #0f172a;

        font-size: 23px;
        font-weight: 900;

        letter-spacing: -0.5px;
    }


    .customer-search-heading p {
        margin:
            7px 0 0;

        color: #64748b;

        font-size: 12px;

        line-height: 1.65;
    }


    .customer-search-icon {
        width: 50px;
        height: 50px;

        flex-shrink: 0;

        display: grid;
        place-items: center;

        border-radius: 16px;

        color: #2563eb;

        background:
            rgba(37, 99, 235, 0.09);
    }


    .customer-search-icon svg {
        width: 24px;
        height: 24px;
    }


    .customer-search-form {
        display: grid;

        grid-template-columns:
            minmax(0, 1fr)
            52px
            minmax(0, 1fr)
            auto;

        align-items: end;

        gap: 12px;
    }


    .customer-location-field {
        position: relative;
    }


    .customer-location-field label {
        display: block;

        margin-bottom: 7px;

        color: #475569;

        font-size: 11px;
        font-weight: 800;
    }


    .customer-location-input-wrap {
        position: relative;
    }


    .customer-location-input-wrap svg {
        position: absolute;

        width: 18px;
        height: 18px;

        left: 15px;
        top: 50%;

        transform:
            translateY(-50%);

        color: #2563eb;

        pointer-events: none;
    }


    .customer-location-input {
        width: 100%;
        height: 54px;

        padding:
            0 16px 0 44px;

        border-radius: 15px;

        border:
            1px solid #dbe4ee;

        background: #f8fafc;

        color: #0f172a;

        outline: none;

        font-size: 13px;
        font-weight: 700;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease,
            background 0.2s ease;
    }


    .customer-location-input:focus {
        background: #ffffff;

        border-color: #60a5fa;

        box-shadow:
            0 0 0 4px
            rgba(37, 99, 235, 0.09);
    }


    .customer-swap-btn {
        width: 52px;
        height: 52px;

        display: grid;
        place-items: center;

        border: none;

        border-radius: 15px;

        color: #2563eb;

        background:
            rgba(37, 99, 235, 0.09);

        cursor: pointer;

        transition:
            transform 0.25s ease,
            background 0.25s ease,
            color 0.25s ease;
    }


    .customer-swap-btn:hover {
        color: #ffffff;

        background: #2563eb;

        transform:
            rotate(180deg);
    }


    .customer-swap-btn svg {
        width: 20px;
        height: 20px;
    }


    .customer-search-submit {
        height: 54px;

        padding:
            0 22px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 9px;

        border: none;

        border-radius: 15px;

        color: #ffffff;

        background:
            linear-gradient(
                135deg,
                #2563eb,
                #0284c7
            );

        font-size: 13px;
        font-weight: 800;

        cursor: pointer;

        box-shadow:
            0 12px 25px
            rgba(37, 99, 235, 0.22);

        transition:
            transform 0.22s ease,
            box-shadow 0.22s ease;
    }


    .customer-search-submit:hover {
        transform: translateY(-2px);

        box-shadow:
            0 16px 30px
            rgba(37, 99, 235, 0.28);
    }


    .customer-search-submit svg {
        width: 18px;
        height: 18px;
    }


    .customer-search-bottom {
        display: flex;
        flex-wrap: wrap;
        align-items: center;

        gap: 9px;

        margin-top: 17px;
    }


    .popular-label {
        color: #94a3b8;

        font-size: 10px;
        font-weight: 850;

        letter-spacing: 0.7px;
    }


    .popular-route-chip {
        padding:
            7px 11px;

        border: none;

        border-radius: 999px;

        color: #475569;

        background: #f1f5f9;

        font-size: 10px;
        font-weight: 750;

        cursor: pointer;

        transition:
            color 0.2s ease,
            background 0.2s ease,
            transform 0.2s ease;
    }


    .popular-route-chip:hover {
        color: #1d4ed8;

        background: #dbeafe;

        transform:
            translateY(-2px);
    }


    .clear-search-link {
        margin-left: auto;

        color: #64748b;

        text-decoration: none;

        font-size: 11px;
        font-weight: 750;
    }


    .clear-search-link:hover {
        color: #2563eb;
    }


    /* =========================================================
       RESULTS HEADER
    ========================================================= */

    .customer-results-header {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 20px;
    }


    .customer-results-header span {
        display: block;

        margin-bottom: 5px;

        color: #2563eb;

        font-size: 10px;
        font-weight: 850;

        letter-spacing: 1.2px;
    }


    .customer-results-header h2 {
        margin: 0;

        color: #0f172a;

        font-size: 24px;
        font-weight: 900;
    }


    .customer-results-header p {
        margin:
            6px 0 0;

        color: #64748b;

        font-size: 12px;
    }


    .customer-result-count {
        min-width: 78px;
        height: 78px;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        border-radius: 22px;

        color: #2563eb;

        background:
            rgba(37, 99, 235, 0.08);

        border:
            1px solid rgba(37, 99, 235, 0.12);
    }


    .customer-result-count strong {
        font-size: 26px;
        font-weight: 900;

        line-height: 1;
    }


    .customer-result-count small {
        margin-top: 5px;

        color: #64748b;

        font-size: 9px;
        font-weight: 750;
    }


    /* =========================================================
       MAIN LAYOUT
    ========================================================= */

    .customer-route-modern-layout {
        display: grid;

        grid-template-columns:
            minmax(0, 1.55fr)
            minmax(300px, 0.65fr);

        gap: 20px;

        align-items: start;
    }


    .customer-results-column {
        display: flex;
        flex-direction: column;

        gap: 16px;
    }


    /* =========================================================
       ROUTE RESULT CARD
    ========================================================= */

    .modern-route-result-card {
        position: relative;

        overflow: hidden;

        padding: 24px;

        border-radius: 24px;

        background: #ffffff;

        border:
            1px solid rgba(148, 163, 184, 0.21);

        box-shadow:
            0 12px 34px
            rgba(15, 23, 42, 0.055);

        transition:
            transform 0.28s ease,
            box-shadow 0.28s ease,
            border-color 0.28s ease;
    }


    .modern-route-result-card:hover {
        transform:
            translateY(-5px);

        border-color:
            rgba(37, 99, 235, 0.28);

        box-shadow:
            0 20px 45px
            rgba(37, 99, 235, 0.10);
    }


    .modern-route-result-card::before {
        content: "";

        position: absolute;

        width: 140px;
        height: 140px;

        right: -70px;
        top: -70px;

        border-radius: 50%;

        background:
            radial-gradient(
                circle,
                rgba(37, 99, 235, 0.10),
                transparent 70%
            );
    }


    .modern-route-card-top {
        position: relative;
        z-index: 2;

        display: flex;
        align-items: flex-start;
        justify-content: space-between;

        gap: 15px;
    }


    .modern-route-number {
        display: inline-flex;
        align-items: center;

        gap: 7px;

        margin-bottom: 8px;

        color: #2563eb;

        font-size: 10px;
        font-weight: 850;

        letter-spacing: 1px;
    }


    .modern-route-number::before {
        content: "";

        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: #22c55e;
    }


    .modern-route-card-top h3 {
        margin: 0;

        color: #0f172a;

        font-size: 21px;
        font-weight: 900;

        letter-spacing: -0.4px;
    }


    .modern-route-direction {
        display: flex;
        align-items: center;
        flex-wrap: wrap;

        gap: 7px;

        margin-top: 7px;

        color: #64748b;

        font-size: 12px;
        font-weight: 700;
    }


    .modern-route-direction svg {
        width: 15px;
        height: 15px;

        color: #2563eb;
    }


    .modern-route-status {
        flex-shrink: 0;

        padding:
            7px 10px;

        border-radius: 999px;

        color: #15803d;

        background:
            rgba(34, 197, 94, 0.10);

        font-size: 10px;
        font-weight: 850;
    }


    .modern-route-meta-grid {
        position: relative;
        z-index: 2;

        display: grid;

        grid-template-columns:
            repeat(4, minmax(0, 1fr));

        gap: 10px;

        margin-top: 20px;
    }


    .modern-route-meta-item {
        min-height: 75px;

        padding: 12px;

        border-radius: 15px;

        background: #f8fafc;

        border:
            1px solid #edf2f7;
    }


    .modern-route-meta-item span {
        display: block;

        color: #94a3b8;

        font-size: 9px;
        font-weight: 800;

        text-transform: uppercase;

        letter-spacing: 0.6px;
    }


    .modern-route-meta-item strong {
        display: block;

        margin-top: 7px;

        color: #0f172a;

        font-size: 13px;
        font-weight: 850;
    }


    /* =========================================================
       ROUTE FLOW
    ========================================================= */

    .modern-route-flow {
        position: relative;
        z-index: 2;

        margin-top: 17px;

        padding: 15px;

        display: flex;
        align-items: center;

        gap: 7px;

        overflow-x: auto;

        scrollbar-width: thin;

        border-radius: 16px;

        background:
            linear-gradient(
                135deg,
                rgba(37, 99, 235, 0.045),
                rgba(14, 165, 233, 0.025)
            );

        border:
            1px solid rgba(37, 99, 235, 0.08);
    }


    .modern-flow-point {
        flex-shrink: 0;

        padding:
            7px 9px;

        border-radius: 10px;

        color: #475569;

        background: #ffffff;

        border:
            1px solid #e2e8f0;

        font-size: 10px;
        font-weight: 750;
    }


    .modern-flow-point.start {
        color: #15803d;

        background:
            rgba(34, 197, 94, 0.08);

        border-color:
            rgba(34, 197, 94, 0.15);
    }


    .modern-flow-point.end {
        color: #b91c1c;

        background:
            rgba(239, 68, 68, 0.07);

        border-color:
            rgba(239, 68, 68, 0.14);
    }


    .modern-flow-arrow {
        flex-shrink: 0;

        color: #93c5fd;

        font-size: 13px;
        font-weight: 900;
    }


    /* =========================================================
       SCHEDULE PREVIEW
    ========================================================= */

    .modern-schedule-preview {
        position: relative;
        z-index: 2;

        margin-top: 17px;

        min-height: 65px;

        padding:
            12px 14px;

        display: flex;
        align-items: center;

        gap: 12px;

        border-radius: 16px;

        background:
            linear-gradient(
                135deg,
                #f8fafc,
                #ffffff
            );

        border:
            1px solid #e2e8f0;
    }


    .modern-schedule-icon {
        width: 40px;
        height: 40px;

        flex-shrink: 0;

        display: grid;
        place-items: center;

        border-radius: 13px;

        color: #2563eb;

        background:
            rgba(37, 99, 235, 0.09);
    }


    .modern-schedule-icon svg {
        width: 20px;
        height: 20px;
    }


    .modern-schedule-copy {
        min-width: 0;
        flex: 1;
    }


    .modern-schedule-copy small {
        display: block;

        color: #94a3b8;

        font-size: 9px;
        font-weight: 850;

        letter-spacing: 0.6px;
    }


    .modern-schedule-copy strong {
        display: block;

        margin-top: 3px;

        color: #0f172a;

        font-size: 12px;
        font-weight: 800;
    }


    .modern-schedule-status {
        flex-shrink: 0;

        padding:
            6px 9px;

        border-radius: 999px;

        font-size: 9px;
        font-weight: 850;
    }


    .modern-schedule-status.green {
        color: #15803d;
        background:
            rgba(34, 197, 94, 0.10);
    }


    .modern-schedule-status.amber {
        color: #b45309;
        background:
            rgba(245, 158, 11, 0.11);
    }


    .modern-schedule-status.red {
        color: #b91c1c;
        background:
            rgba(239, 68, 68, 0.10);
    }


    .modern-schedule-status.blue {
        color: #1d4ed8;
        background:
            rgba(37, 99, 235, 0.10);
    }


    /* =========================================================
       ROUTE ACTIONS
    ========================================================= */

    .modern-route-actions {
        position: relative;
        z-index: 2;

        display: flex;
        flex-wrap: wrap;

        gap: 9px;

        margin-top: 18px;
    }


    .modern-route-action {
        min-height: 42px;

        padding:
            0 14px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 7px;

        border: none;

        border-radius: 13px;

        text-decoration: none;

        font-size: 11px;
        font-weight: 800;

        cursor: pointer;

        transition:
            transform 0.22s ease,
            box-shadow 0.22s ease,
            background 0.22s ease;
    }


    .modern-route-action:hover {
        transform:
            translateY(-2px);
    }


    .modern-route-action svg {
        width: 16px;
        height: 16px;
    }


    .modern-route-action.primary {
        color: #ffffff;

        background:
            linear-gradient(
                135deg,
                #2563eb,
                #0284c7
            );

        box-shadow:
            0 9px 20px
            rgba(37, 99, 235, 0.20);
    }


    .modern-route-action.primary:hover {
        color: #ffffff;
    }


    .modern-route-action.secondary {
        color: #475569;

        background: #f1f5f9;

        border:
            1px solid #e2e8f0;
    }


    .modern-route-action.secondary:hover {
        color: #2563eb;

        background: #eff6ff;
    }


    .modern-route-action.favorite {
        color: #7c3aed;

        background:
            rgba(124, 58, 237, 0.08);

        border:
            1px solid rgba(124, 58, 237, 0.13);
    }


    .modern-route-action.favorite.saved {
        color: #be123c;

        background:
            rgba(244, 63, 94, 0.09);

        border-color:
            rgba(244, 63, 94, 0.15);
    }


    .modern-favorite-form {
        display: inline-flex;
        margin: 0;
    }


    /* =========================================================
       SIDEBAR
    ========================================================= */

    .customer-route-sidebar {
        position: sticky;

        top: 95px;

        display: flex;
        flex-direction: column;

        gap: 16px;
    }


    .customer-side-card {
        padding: 21px;

        border-radius: 22px;

        background: #ffffff;

        border:
            1px solid rgba(148, 163, 184, 0.21);

        box-shadow:
            0 12px 32px
            rgba(15, 23, 42, 0.055);
    }


    .customer-side-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 12px;

        margin-bottom: 15px;
    }


    .customer-side-card-header h3 {
        margin: 0;

        color: #0f172a;

        font-size: 16px;
        font-weight: 900;
    }


    .customer-side-card-header span {
        min-width: 28px;
        height: 28px;

        display: grid;
        place-items: center;

        padding:
            0 7px;

        border-radius: 9px;

        color: #2563eb;

        background:
            rgba(37, 99, 235, 0.09);

        font-size: 10px;
        font-weight: 850;
    }


    .favorite-modern-list {
        display: flex;
        flex-direction: column;

        gap: 9px;
    }


    .favorite-modern-item {
        padding: 12px;

        border-radius: 15px;

        background: #f8fafc;

        border:
            1px solid #edf2f7;
    }


    .favorite-modern-item strong {
        display: block;

        color: #0f172a;

        font-size: 12px;
        font-weight: 850;
    }


    .favorite-modern-item > span {
        display: block;

        margin-top: 4px;

        color: #64748b;

        font-size: 10px;
    }


    .favorite-modern-item small {
        display: block;

        margin-top: 5px;

        color: #94a3b8;

        font-size: 9px;
    }


    .favorite-modern-actions {
        display: flex;
        align-items: center;

        gap: 7px;

        margin-top: 10px;
    }


    .favorite-modern-view,
    .favorite-modern-remove {
        min-height: 32px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        padding:
            0 10px;

        border-radius: 9px;

        border: none;

        font-size: 9px;
        font-weight: 800;

        text-decoration: none;

        cursor: pointer;
    }


    .favorite-modern-view {
        color: #2563eb;

        background:
            rgba(37, 99, 235, 0.09);
    }


    .favorite-modern-remove {
        color: #be123c;

        background:
            rgba(244, 63, 94, 0.08);
    }


    .favorite-modern-remove-form {
        margin: 0;
    }


    /* =========================================================
       HELP
    ========================================================= */

    .customer-help-modern-list {
        display: flex;
        flex-direction: column;

        gap: 13px;
    }


    .customer-help-modern-item {
        display: grid;

        grid-template-columns:
            32px
            minmax(0, 1fr);

        align-items: start;

        gap: 10px;
    }


    .customer-help-modern-number {
        width: 32px;
        height: 32px;

        display: grid;
        place-items: center;

        border-radius: 10px;

        color: #2563eb;

        background:
            rgba(37, 99, 235, 0.09);

        font-size: 10px;
        font-weight: 900;
    }


    .customer-help-modern-item p {
        margin: 3px 0 0;

        color: #64748b;

        font-size: 10px;

        line-height: 1.6;
    }


    /* =========================================================
       EMPTY STATE
    ========================================================= */

    .customer-route-empty {
        min-height: 350px;

        padding: 40px;

        display: flex;
        flex-direction: column;

        align-items: center;
        justify-content: center;

        text-align: center;

        border-radius: 24px;

        background: #ffffff;

        border:
            1px dashed #cbd5e1;
    }


    .customer-route-empty-icon {
        width: 70px;
        height: 70px;

        display: grid;
        place-items: center;

        margin-bottom: 18px;

        border-radius: 22px;

        color: #2563eb;

        background:
            rgba(37, 99, 235, 0.09);
    }


    .customer-route-empty-icon svg {
        width: 32px;
        height: 32px;
    }


    .customer-route-empty h3 {
        margin: 0;

        color: #0f172a;

        font-size: 20px;
        font-weight: 900;
    }


    .customer-route-empty p {
        max-width: 430px;

        margin:
            9px 0 0;

        color: #64748b;

        font-size: 12px;

        line-height: 1.7;
    }


    .customer-route-empty a {
        margin-top: 18px;
    }


    /* =========================================================
       DARK MODE
    ========================================================= */

    [data-theme="dark"]
    .customer-modern-search,

    [data-theme="dark"]
    .modern-route-result-card,

    [data-theme="dark"]
    .customer-side-card,

    [data-theme="dark"]
    .customer-route-empty {
        background: #0f1c2e;

        border-color:
            rgba(148, 163, 184, 0.14);
    }


    [data-theme="dark"]
    .customer-search-heading h2,

    [data-theme="dark"]
    .customer-results-header h2,

    [data-theme="dark"]
    .modern-route-card-top h3,

    [data-theme="dark"]
    .modern-route-meta-item strong,

    [data-theme="dark"]
    .modern-schedule-copy strong,

    [data-theme="dark"]
    .customer-side-card-header h3,

    [data-theme="dark"]
    .favorite-modern-item strong,

    [data-theme="dark"]
    .customer-route-empty h3 {
        color: #f8fafc;
    }


    [data-theme="dark"]
    .customer-location-input,

    [data-theme="dark"]
    .modern-route-meta-item,

    [data-theme="dark"]
    .modern-flow-point,

    [data-theme="dark"]
    .modern-schedule-preview,

    [data-theme="dark"]
    .favorite-modern-item {
        color: #f8fafc;

        background: #132238;

        border-color:
            rgba(148, 163, 184, 0.14);
    }


    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @@media (max-width: 1150px) {

        .customer-route-modern-hero {
            grid-template-columns: 1fr;
        }


        .customer-route-visual {
            display: none;
        }


        .customer-route-modern-layout {
            grid-template-columns: 1fr;
        }


        .customer-route-sidebar {
            position: static;

            display: grid;

            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }
    }


    @@media (max-width: 900px) {

        .customer-search-form {
            grid-template-columns:
                minmax(0, 1fr)
                52px
                minmax(0, 1fr);
        }


        .customer-search-submit {
            grid-column:
                1 / -1;
        }


        .modern-route-meta-grid {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }
    }


    @@media (max-width: 650px) {

        .customer-route-modern-hero {
            min-height: auto;

            padding:
                32px 24px;
        }


        .customer-route-modern-hero h1 {
            font-size: 39px;
        }


        .customer-modern-search {
            margin-top: -30px;

            padding: 20px;
        }


        .customer-search-form {
            grid-template-columns: 1fr;
        }


        .customer-swap-btn {
            width: 100%;

            transform:
                rotate(90deg);
        }


        .customer-swap-btn:hover {
            transform:
                rotate(270deg);
        }


        .modern-route-card-top {
            flex-direction: column;
        }


        .modern-route-meta-grid {
            grid-template-columns: 1fr;
        }


        .modern-schedule-preview {
            align-items: flex-start;

            flex-direction: column;
        }


        .customer-route-sidebar {
            grid-template-columns: 1fr;
        }


        .customer-results-header {
            align-items: flex-start;
        }
    }


    @@media (prefers-reduced-motion: reduce) {

        .cr-reveal,
        .customer-route-live-dot,
        .customer-route-modern-hero::before,
        .customer-route-modern-hero::after,
        .visual-route-bus,
        .visual-floating-card {
            animation: none !important;

            opacity: 1 !important;

            transform: none !important;
        }
    }

</style>


<div class="customer-explore-page">


    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="customer-route-modern-hero cr-reveal">

        <div class="customer-route-hero-copy">

            <div class="customer-route-eyebrow">

                <span class="customer-route-live-dot"></span>

                SRMSS JOURNEY DISCOVERY

            </div>


            <h1>

                Find your next
                <span>journey.</span>

            </h1>


            <p>

                Search active transport routes, explore every stop,
                review upcoming timetables and save the journeys
                that matter most to you.

            </p>


            <div class="customer-route-hero-stats">

                <div class="customer-route-hero-stat">

                    <strong class="customer-route-count"
                            data-count="@totalActiveRoutes">

                        0

                    </strong>

                    <span>
                        Active Routes
                    </span>

                </div>


                <div class="customer-route-hero-stat">

                    <strong class="customer-route-count"
                            data-count="@upcomingSchedules">

                        0

                    </strong>

                    <span>
                        Upcoming Schedules
                    </span>

                </div>


                <div class="customer-route-hero-stat">

                    <strong class="customer-route-count"
                            data-count="@favoriteRoutes.Count">

                        0

                    </strong>

                    <span>
                        Saved Routes
                    </span>

                </div>

            </div>

        </div>


        <div class="customer-route-visual">

            <div class="visual-route-track">

                <div class="visual-route-bus">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <rect x="4"
                              y="3"
                              width="16"
                              height="15"
                              rx="3">
                        </rect>

                        <path d="M4 10h16">
                        </path>

                        <path d="M8 18v2">
                        </path>

                        <path d="M16 18v2">
                        </path>

                        <circle cx="8"
                                cy="15"
                                r="1">
                        </circle>

                        <circle cx="16"
                                cy="15"
                                r="1">
                        </circle>

                    </svg>

                </div>

            </div>


            <div class="visual-location-pin start">
            </div>


            <div class="visual-location-pin end">
            </div>


            <div class="visual-floating-card">

                <div class="visual-floating-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <path d="M5 17l4-4 3 3 7-8">
                        </path>

                        <path d="M14 8h5v5">
                        </path>

                    </svg>

                </div>


                <div>

                    <small>
                        LIVE NETWORK
                    </small>

                    <strong>
                        Ready to Explore
                    </strong>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         ALERTS
    ====================================================== -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="customer-modern-alert success">

            @TempData["SuccessMessage"]

        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="customer-modern-alert warning">

            @TempData["ErrorMessage"]

        </div>
    }


    <!-- =====================================================
         SEARCH PANEL
    ====================================================== -->

    <section class="customer-modern-search cr-reveal"
             style="--delay: 0.08s;">

        <div class="customer-search-heading">

            <div>

                <span>
                    PLAN YOUR JOURNEY
                </span>


                <h2>
                    Where would you like to go?
                </h2>


                <p>

                    Enter a departure point and destination.
                    You can also search using intermediary stops.

                </p>

            </div>


            <div class="customer-search-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">

                    <circle cx="11"
                            cy="11"
                            r="7">
                    </circle>

                    <path d="M20 20l-4-4">
                    </path>

                </svg>

            </div>

        </div>


        <form asp-controller="CustomerRoutes"
              asp-action="Index"
              method="get"
              class="customer-search-form"
              id="customerJourneyForm">


            <div class="customer-location-field">

                <label for="fromInput">
                    From
                </label>


                <div class="customer-location-input-wrap">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <circle cx="12"
                                cy="12"
                                r="8">
                        </circle>

                        <circle cx="12"
                                cy="12"
                                r="3">
                        </circle>

                    </svg>


                    <input id="fromInput"
                           name="from"
                           value="@fromValue"
                           class="customer-location-input"
                           list="routeLocationSuggestions"
                           autocomplete="off"
                           placeholder="Example: Colombo" />

                </div>

            </div>


            <button type="button"
                    class="customer-swap-btn"
                    id="swapLocationsBtn"
                    title="Swap locations"
                    aria-label="Swap departure and destination">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">

                    <path d="M7 7h11l-3-3">
                    </path>

                    <path d="M17 17H6l3 3">
                    </path>

                </svg>

            </button>


            <div class="customer-location-field">

                <label for="toInput">
                    To
                </label>


                <div class="customer-location-input-wrap">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <path d="M12 21s6-5.2 6-11a6 6 0 1 0-12 0c0 5.8 6 11 6 11z">
                        </path>

                        <circle cx="12"
                                cy="10"
                                r="2">
                        </circle>

                    </svg>


                    <input id="toInput"
                           name="to"
                           value="@toValue"
                           class="customer-location-input"
                           list="routeLocationSuggestions"
                           autocomplete="off"
                           placeholder="Example: Kandy" />

                </div>

            </div>


            <button type="submit"
                    class="customer-search-submit">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">

                    <circle cx="11"
                            cy="11"
                            r="7">
                    </circle>

                    <path d="M20 20l-4-4">
                    </path>

                </svg>

                Search Routes

            </button>

        </form>


        <datalist id="routeLocationSuggestions">

            @foreach (
                var location in locationSuggestions
            )
            {
                <option value="@location">
                </option>
            }

        </datalist>


        <div class="customer-search-bottom">

            @if (popularRoutes.Any())
            {
                <span class="popular-label">

                    POPULAR JOURNEYS

                </span>


                @foreach (
                    var popularRoute in popularRoutes
                )
                {
                    <button type="button"
                            class="popular-route-chip"
                            data-from="@popularRoute.StartPoint"
                            data-to="@popularRoute.EndPoint">

                        @popularRoute.StartPoint
                        â†’
                        @popularRoute.EndPoint

                    </button>
                }
            }


            @if (searchPerformed)
            {
                <a asp-controller="CustomerRoutes"
                   asp-action="Index"
                   class="clear-search-link">

                    Clear search

                </a>
            }

        </div>

    </section>


    <!-- =====================================================
         RESULTS HEADER
    ====================================================== -->

    <section class="customer-results-header cr-reveal"
             style="--delay: 0.14s;"
             id="searchResultsSection">

        <div>

            <span>

                @(searchPerformed
                    ? "SEARCH RESULTS"
                    : "AVAILABLE JOURNEYS")

            </span>


            <h2>

                @(searchPerformed
                    ? "Routes matching your journey"
                    : "Explore active transport routes")

            </h2>


            <p>

                @if (searchPerformed)
                {
                    <text>

                        Showing routes from
                        <strong>@fromValue</strong>

                        @if (
                            !string.IsNullOrWhiteSpace(toValue)
                        )
                        {
                            <text>

                                to
                                <strong>@toValue</strong>

                            </text>
                        }

                    </text>
                }
                else
                {
                    <text>

                        Browse all active routes currently
                        available through SRMSS.

                    </text>
                }

            </p>

        </div>


        <div class="customer-result-count">

            <strong>
                @Model.Count()
            </strong>

            <small>
                ROUTES
            </small>

        </div>

    </section>


    <!-- =====================================================
         RESULTS + SIDEBAR
    ====================================================== -->

    <section class="customer-route-modern-layout">


        <!-- =================================================
             ROUTE RESULTS
        ================================================== -->

        <div class="customer-results-column">

            @if (Model.Any())
            {
                int cardIndex = 0;


                @foreach (var route in Model)
                {
                    cardIndex++;


                    var orderedStops =
                        route.RouteStops != null

                            ? route.RouteStops
                                .OrderBy(stop =>
                                    stop.StopOrder)
                                .ToList()

                            : new List<
                                SRMSS.Web.Models.RouteStop
                            >();


                    var upcomingSchedule =
                        route.Schedules != null

                            ? route.Schedules

                                .Where(schedule =>
                                    schedule.ScheduleDate.Date >=
                                        DateTime.Today

                                    &&
                                    schedule.Status !=
                                        "Cancelled"

                                    &&
                                    schedule.Status !=
                                        "Completed"
                                )

                                .OrderBy(schedule =>
                                    schedule.ScheduleDate)

                                .ThenBy(schedule =>
                                    schedule.DepartureTime)

                                .FirstOrDefault()

                            : null;


                    var origin =
                        System.Uri.EscapeDataString(
                            route.StartPoint ?? ""
                        );


                    var destination =
                        System.Uri.EscapeDataString(
                            route.EndPoint ?? ""
                        );


                    var waypoints =
                        string.Join(
                            "%7C",

                            orderedStops.Select(
                                stop =>
                                    System.Uri
                                        .EscapeDataString(
                                            stop.StopName
                                            ?? ""
                                        )
                            )
                        );


                    var mapUrl =
                        "https://www.google.com/maps/dir/?api=1"

                        + "&origin=" +
                        origin

                        + "&destination=" +
                        destination

                        + (
                            string.IsNullOrWhiteSpace(
                                waypoints
                            )

                                ? ""

                                : "&waypoints=" +
                                  waypoints
                        )

                        + "&travelmode=driving";


                    bool isFavorite =
                        favoriteRouteIds.Contains(
                            route.Id
                        );


                    double animationDelay =
                        0.16 +
                        (
                            Math.Min(cardIndex, 8)
                            *
                            0.05
                        );


                    <article class="modern-route-result-card cr-reveal"
                             style="--delay: @(animationDelay.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))s;">


                        <div class="modern-route-card-top">

                            <div>

                                <div class="modern-route-number">

                                    ACTIVE ROUTE

                                </div>


                                <h3>
                                    @route.RouteName
                                </h3>


                                <div class="modern-route-direction">

                                    <span>
                                        @route.StartPoint
                                    </span>


                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2"
                                         stroke-linecap="round"
                                         stroke-linejoin="round"
                                         aria-hidden="true">

                                        <path d="M5 12h14">
                                        </path>

                                        <path d="M13 6l6 6-6 6">
                                        </path>

                                    </svg>


                                    <span>
                                        @route.EndPoint
                                    </span>

                                </div>

