@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string fullName = Context.Session.GetString("FullName") ?? "SRMSS User";
    string username = Context.Session.GetString("Username") ?? "user";
    string role = Context.Session.GetString("Role") ?? "Guest";

    string initials = "U";

    var nameParts = fullName.Split(
        ' ',
        StringSplitOptions.RemoveEmptyEntries
    );

    if (nameParts.Length == 1 && nameParts[0].Length > 0)
    {
        initials = nameParts[0][0]
            .ToString()
            .ToUpper();
    }
    else if (nameParts.Length >= 2)
    {
        initials =
            $"{char.ToUpper(nameParts[0][0])}{char.ToUpper(nameParts[1][0])}";
    }

    bool isLoginPage =
        string.Equals(
            currentController,
            "Account",
            StringComparison.OrdinalIgnoreCase
        )
        &&
        (
            string.Equals(
                currentAction,
                "Login",
                StringComparison.OrdinalIgnoreCase
            )
            ||
            string.Equals(
                currentAction,
                "Register",
                StringComparison.OrdinalIgnoreCase
            )
        );
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SRMSS</title>


    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- Leaflet Map CSS -->
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="" />


    <!-- Main Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body class="srmss-body">

    @if (isLoginPage)
    {
        @RenderBody()
    }
    else
    {
        <div class="modern-shell"
             id="modernShell">

            <div class="mobile-overlay"
                 id="mobileOverlay"></div>


            <aside class="modern-sidebar"
                   id="modernSidebar">

                <div class="sidebar-brand">

                    <div class="brand-mark brand-mark-logo">

                        <img src="~/images/srmss-mark.png"
                             alt="SRMSS" />

                    </div>


                    <div class="brand-copy">

                        <strong>
                            SRMSS
                        </strong>

                        <small>
                            Transport Intelligence
                        </small>

                    </div>


                    <button type="button"
                            class="sidebar-collapse-btn"
                            id="sidebarCollapseBtn"
                            aria-label="Collapse sidebar">

                        <span>
                            â€¹
                        </span>

                    </button>

                </div>


                <div class="sidebar-system-status">

                    <span class="live-dot"></span>

                    <div>

                        <strong>
                            System Operational
                        </strong>

                        <small>
                            Live transport management
                        </small>

                    </div>

                </div>


                <nav class="modern-nav">

                    <div class="nav-section-label">
                        Overview
                    </div>


                    <a href="/Dashboard"
                       class="modern-nav-link @(string.Equals(currentController, "Dashboard", StringComparison.OrdinalIgnoreCase) ? "active" : "")">

                        <span class="nav-icon">
                            <partial name="_AppIcon"
                                     model='"dashboard"' />
                        </span>

                        <span class="nav-text">
                            Dashboard
                        </span>

                    </a>


                    <a href="/Account/Profile"
                       class="modern-nav-link @(string.Equals(currentController, "Account", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Profile", StringComparison.OrdinalIgnoreCase) ? "active" : "")">

                        <span class="nav-icon">
                            <partial name="_AppIcon"
                                     model='"profile"' />
                        </span>

                        <span class="nav-text">
                            My Profile
                        </span>

                    </a>


                    @if (role == "SuperAdmin")
                    {
                        <div class="nav-section-label">
                            Administration
                        </div>


                        <a href="/Users?roleFilter=Admin"
                           class="modern-nav-link @(string.Equals(currentController, "Users", StringComparison.OrdinalIgnoreCase) ? "active" : "")">

                            <span class="nav-icon">

                                <partial name="_AppIcon"
                                         model='"users"' />

                            </span>

                            <span class="nav-text">
                                Account Management
                            </span>

                        </a>


                        <a href="/AuditLogs"
                           class="modern-nav-link @(string.Equals(currentController, "AuditLogs", StringComparison.OrdinalIgnoreCase) ? "active" : "")">

                            <span class="nav-icon">

                                <partial name="_AppIcon"
                                         model='"audit"' />

                            </span>

                            <span class="nav-text">
                                Audit Logs
                            </span>

                        </a>
                    }


                    @if (
                        role == "SuperAdmin" ||
                        role == "Admin" ||
                        role == "User"
                    )
                    {
                        <div class="nav-section-label">
                            Operations
                        </div>


                        <a href="/TransportRoutes"
                           class="modern-nav-link @(string.Equals(currentController, "TransportRoutes", StringComparison.OrdinalIgnoreCase) ? "active" : "")">

                            <span class="nav-icon">

                                <partial name="_AppIcon"
                                         model='"route"' />

                            </span>

                            <span class="nav-text">
                                Routes
                            </span>

                        </a>


                        <a href="/RouteStops"
                           class="modern-nav-link @(string.Equals(currentController, "RouteStops", StringComparison.OrdinalIgnoreCase) ? "active" : "")">

                            <span class="nav-icon">

                                <partial name="_AppIcon"
                                         model='"stop"' />

                            </span>

                            <span class="nav-text">
                                Route Stops
                            </span>

                        </a>


                        <a href="/Schedules"
                           class="modern-nav-link @(string.Equals(currentController, "Schedules", StringComparison.OrdinalIgnoreCase) ? "active" : "")">

                            <span class="nav-icon">

                                <partial name="_AppIcon"
                                         model='"schedule"' />

                            </span>

                            <span class="nav-text">
                                Schedules
                            </span>

                        </a>


                        <a href="/TripStatus"
                           class="modern-nav-link @(string.Equals(currentController, "TripStatus", StringComparison.OrdinalIgnoreCase) ? "active" : "")">

                            <span class="nav-icon">

                                <partial name="_AppIcon"
                                         model='"trip"' />

                            </span>

                            <span class="nav-text">
                                Trip Status
                            </span>

                        </a>



                        <div class="nav-section-label">
                            Fleet Control
                        </div>


                        <a href="/Drivers/Index"
                        class="modern-nav-link @(string.Equals(currentController, "Drivers", StringComparison.OrdinalIgnoreCase) ? "active" : "")">

                            <span class="nav-icon">
                                <partial name="_AppIcon" model='"driver"' />
                            </span>

                            <span class="nav-text">
                                Drivers
                            </span>

                        </a>


                        <a href="/Vehicles/Index"
                        class="modern-nav-link @(string.Equals(currentController, "Vehicles", StringComparison.OrdinalIgnoreCase) ? "active" : "")">

                            <span class="nav-icon">
                                <partial name="_AppIcon" model='"vehicle"' />
                            </span>

                            <span class="nav-text">
                                Vehicles
                            </span>

                        </a>


                        <a href="/FuelLogs/Index"
                        class="modern-nav-link @(string.Equals(currentController, "FuelLogs", StringComparison.OrdinalIgnoreCase) ? "active" : "")">

                            <span class="nav-icon">
                                <partial name="_AppIcon" model='"fuel"' />
                            </span>

                            <span class="nav-text">
                                Fuel Logs
                            </span>

                        </a>


                        <a href="/MaintenanceLogs/Index"
                        class="modern-nav-link @(string.Equals(currentController, "MaintenanceLogs", StringComparison.OrdinalIgnoreCase) ? "active" : "")">

                            <span class="nav-icon">
                                <partial name="_AppIcon" model='"maintenance"' />
                            </span>

                            <span class="nav-text">
                                Maintenance
                            </span>

                        </a>


                        <a href="/Reports/Index"
                        class="modern-nav-link @(string.Equals(currentController, "Reports", StringComparison.OrdinalIgnoreCase) ? "active" : "")">

                            <span class="nav-icon">
                                <partial name="_AppIcon" model='"report"' />
                            </span>

                            <span class="nav-text">
                                Reports
                            </span>

                        </a>


                        <div class="nav-section-label">
                            Communication
                        </div>


                        <a href="/Announcements/Index"
                        class="modern-nav-link @(string.Equals(currentController, "Announcements", StringComparison.OrdinalIgnoreCase) ? "active" : "")">

                            <span class="nav-icon">
                                <partial name="_AppIcon" model='"announcement"' />
                            </span>

                            <span class="nav-text">
                                Announcements
                            </span>

                        </a>


                        <a href="/CustomerFeedback/Index"
                        class="modern-nav-link @(string.Equals(currentController, "CustomerFeedback", StringComparison.OrdinalIgnoreCase) ? "active" : "")">

                            <span class="nav-icon">
                                <partial name="_AppIcon" model='"feedback"' />
                            </span>

                            <span class="nav-text">
                                Feedback
                            </span>

                        </a>
                    }


                    @if (role == "Customer")
                    {
                        <div class="nav-section-label">
                            Customer Portal
                        </div>


                        <a href="/CustomerRoutes/Index"
                           class="modern-nav-link @(string.Equals(currentController, "CustomerRoutes", StringComparison.OrdinalIgnoreCase) ? "active" : "")">

                            <span class="nav-icon">

                                <partial name="_AppIcon"
                                         model='"route"' />

                            </span>

                            <span class="nav-text">
                                Search Routes
                            </span>

                        </a>

                        <a href="/CustomerRoutes/Timetable"
                           class="modern-nav-link @(string.Equals(currentController, "CustomerRoutes", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Timetable", StringComparison.OrdinalIgnoreCase) ? "active" : "")">

                            <span class="nav-icon">
                                <partial name="_AppIcon"
                                         model='"schedule"' />
                            </span>

                            <span class="nav-text">
                                Timetable
                            </span>

                        </a>


                        <a href="/CustomerRoutes/LiveStatus"
                           class="modern-nav-link @(string.Equals(currentController, "CustomerRoutes", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "LiveStatus", StringComparison.OrdinalIgnoreCase) ? "active" : "")">

                            <span class="nav-icon">
                                <partial name="_AppIcon"
                                         model='"trip"' />
                            </span>

                            <span class="nav-text">
                                Live Trip Status
                            </span>

                        </a>

                    }



                    @if (role == "Customer")
                    {
                        <a href="/Announcements/Index"
                           class="modern-nav-link @(string.Equals(currentController, "Announcements", StringComparison.OrdinalIgnoreCase) ? "active" : "")">

                            <span class="nav-icon">
                                <partial name="_AppIcon" model='"announcement"' />
                            </span>

                            <span class="nav-text">
                                Announcements
                            </span>

                        </a>


                        <a href="/CustomerFeedback/Index"
                           class="modern-nav-link @(string.Equals(currentController, "CustomerFeedback", StringComparison.OrdinalIgnoreCase) ? "active" : "")">

                            <span class="nav-icon">
                                <partial name="_AppIcon" model='"feedback"' />
                            </span>

                            <span class="nav-text">
                                My Feedback
                            </span>

                        </a>
                    }

                </nav>


                <div class="sidebar-profile">

                    <div class="profile-avatar">
                        @initials
                    </div>


                    <div class="profile-copy">

                        <strong>
                            @fullName
                        </strong>

                        <small>
                            @role
                        </small>

                    </div>


                    <a href="/Account/Logout"
                       class="sidebar-logout"
                       title="Logout">

                        <partial name="_AppIcon"
                                 model='"logout"' />

                    </a>

                </div>

            </aside>


            <main class="modern-main">

                <header class="modern-topbar">

                    <div class="topbar-left">

                        <button type="button"
                                class="mobile-menu-btn"
                                id="mobileMenuBtn"
                                aria-label="Open menu">

                            <partial name="_AppIcon"
                                     model='"menu"' />

                        </button>


                        <div class="page-heading">

                            <h2>
                                @(ViewData["PageTitle"] ?? ViewData["Title"] ?? "SRMSS")
                            </h2>

                            <p>
                                @(ViewData["PageSubtitle"] ?? "Smart Route Management and Scheduling System")
                            </p>

                        </div>

                    </div>


                    <div class="topbar-right">

                        <div class="topbar-clock">

                            <span class="clock-date"
                                  id="currentDate"></span>

                            <strong class="clock-time"
                                    id="currentTime"></strong>

                        </div>


                        <a href="/Announcements/Index"
                           id="topbarNotificationButton"
                           class="topbar-action-btn notification-btn"
                           title="Open announcements"
                           aria-label="Open announcements"
                           onclick="window.location.href='/Announcements/Index'; return false;">

                            <span>
                                <partial name="_AppIcon"
                                         model='"bell"' />
                            </span>

                            <i class="notification-pulse"></i>

                        </a>


                        <button type="button"
                                class="topbar-action-btn"
                                id="themeToggle"
                                title="Toggle theme"
                                aria-label="Toggle theme">

                            <span id="themeIcon">

                                <partial name="_AppIcon"
                                         model='"moon"' />

                            </span>

                        </button>


                        <a href="/Account/Profile"
                           class="topbar-user">

                            <div class="topbar-avatar">
                                @initials
                            </div>


                            <div class="topbar-user-copy">

                                <strong>
                                    @fullName
                                </strong>

                                <small>
                                    @role
                                </small>

                            </div>

                        </a>

                    </div>

                </header>


                <section class="modern-page-content">

                    @RenderBody()

                </section>

            </main>

        </div>
    }


    <!-- jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>


    <!-- Bootstrap -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <!-- Leaflet Map JavaScript -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>


    <script>
    document.addEventListener("DOMContentLoaded", function () {

        const shell =
            document.getElementById("modernShell");

        const sidebar =
            document.getElementById("modernSidebar");

        const collapseButton =
            document.getElementById("sidebarCollapseBtn");

        const mobileMenuButton =
            document.getElementById("mobileMenuBtn");

        const mobileOverlay =
            document.getElementById("mobileOverlay");

        const themeToggle =
            document.getElementById("themeToggle");

        const themeIcon =
            document.getElementById("themeIcon");



        // =============================================
        // DESKTOP SIDEBAR
        // =============================================

        if (collapseButton && shell) {

            const storedSidebarState =
                localStorage.getItem(
                    "srmss-sidebar-collapsed"
                );


            if (storedSidebarState === "true") {

                shell.classList.add(
                    "sidebar-collapsed"
                );
            }


            collapseButton.addEventListener(
                "click",
                function () {

                    shell.classList.toggle(
                        "sidebar-collapsed"
                    );


                    const collapsed =
                        shell.classList.contains(
                            "sidebar-collapsed"
                        );


                    localStorage.setItem(
                        "srmss-sidebar-collapsed",
                        collapsed
                    );

                }
            );
        }


        // =============================================
        // MOBILE SIDEBAR
        // =============================================

        function closeMobileMenu() {

            if (sidebar) {

                sidebar.classList.remove(
                    "mobile-open"
                );
            }


            if (mobileOverlay) {

                mobileOverlay.classList.remove(
                    "show"
                );
            }


            document.body.classList.remove(
                "menu-open"
            );
        }


        if (mobileMenuButton && sidebar) {

            mobileMenuButton.addEventListener(
                "click",
                function () {

                    sidebar.classList.toggle(
                        "mobile-open"
                    );


                    if (mobileOverlay) {

                        mobileOverlay.classList.toggle(
                            "show"
                        );
                    }


                    document.body.classList.toggle(
                        "menu-open"
                    );

                }
            );
        }


        if (mobileOverlay) {

            mobileOverlay.addEventListener(
                "click",
                closeMobileMenu
            );
        }


        document
            .querySelectorAll(".modern-nav-link")
            .forEach(link => {

                link.addEventListener(
                    "click",
                    closeMobileMenu
                );

            });


        // =============================================
        // DARK AND LIGHT THEME
        // =============================================

        const savedTheme =
            localStorage.getItem("srmss-theme")
            ?? "light";


        document.documentElement.setAttribute(
            "data-theme",
            savedTheme
        );


        updateThemeIcon(savedTheme);


        function updateThemeIcon(theme) {

            if (!themeIcon) {
                return;
            }


            themeIcon.innerHTML =
                theme === "dark"

                    ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"/></svg>'

                    : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"/></svg>';
        }


        if (themeToggle) {

            themeToggle.addEventListener(
                "click",
                function () {

                    const currentTheme =
                        document.documentElement.getAttribute(
                            "data-theme"
                        );


                    const nextTheme =
                        currentTheme === "dark"
                            ? "light"
                            : "dark";


                    document.documentElement.setAttribute(
                        "data-theme",
                        nextTheme
                    );


                    localStorage.setItem(
                        "srmss-theme",
                        nextTheme
                    );


                    updateThemeIcon(nextTheme);

                }
            );
        }


        // =============================================
        // LIVE CLOCK
        // =============================================

        function updateClock() {

            const now =
                new Date();


            const dateElement =
                document.getElementById(
                    "currentDate"
                );


            const timeElement =
                document.getElementById(
                    "currentTime"
                );


            if (dateElement) {

                dateElement.textContent =
                    now.toLocaleDateString(
                        "en-GB",
                        {
                            weekday: "short",
                            day: "2-digit",
                            month: "short"
                        }
                    );
            }


            if (timeElement) {

                timeElement.textContent =
                    now.toLocaleTimeString(
                        [],
                        {
                            hour: "2-digit",
                            minute: "2-digit"
                        }
                    );
            }
        }


        updateClock();


        setInterval(
            updateClock,
            1000
        );

    });
</script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>
