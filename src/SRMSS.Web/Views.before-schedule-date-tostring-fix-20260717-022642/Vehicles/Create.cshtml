@model SRMSS.Web.Models.Vehicle

@{
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Vehicle" : "Add Vehicle";
    ViewData["PageTitle"] = isEdit ? "Edit Vehicle" : "Add Vehicle";
    ViewData["PageSubtitle"] = "Maintain complete vehicle registration, compliance and fleet readiness data.";
}

<div class="srmss-card enterprise-form-card">
    <h3 class="card-title">Vehicle Profile</h3>
    <p class="card-subtitle">Register vehicle identity, capacity, service status and compliance dates.</p>

    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
        @Html.AntiForgeryToken()
        @if (isEdit)
        {
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
        }
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="enterprise-form-grid">
            <div>
                <label asp-for="RegistrationNumber" class="form-label"></label>
                <input asp-for="RegistrationNumber" class="form-control" />
                <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="VehicleType" class="form-label"></label>
                <select asp-for="VehicleType" class="form-select">
                    <option>Bus</option>
                    <option>Mini Bus</option>
                    <option>Luxury Bus</option>
                    <option>Van</option>
                    <option>Service Vehicle</option>
                </select>
                <span asp-validation-for="VehicleType" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Manufacturer" class="form-label"></label>
                <input asp-for="Manufacturer" class="form-control" />
                <span asp-validation-for="Manufacturer" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Model" class="form-label"></label>
                <input asp-for="Model" class="form-control" />
                <span asp-validation-for="Model" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="SeatingCapacity" class="form-label"></label>
                <input asp-for="SeatingCapacity" type="number" class="form-control" />
                <span asp-validation-for="SeatingCapacity" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Mileage" class="form-label"></label>
                <input asp-for="Mileage" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Mileage" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="FuelType" class="form-label"></label>
                <select asp-for="FuelType" class="form-select">
                    <option>Diesel</option>
                    <option>Petrol</option>
                    <option>Hybrid</option>
                    <option>Electric</option>
                </select>
                <span asp-validation-for="FuelType" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="ChassisNumber" class="form-label"></label>
                <input asp-for="ChassisNumber" class="form-control" />
                <span asp-validation-for="ChassisNumber" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="InsuranceExpiryDate" class="form-label"></label>
                <input asp-for="InsuranceExpiryDate" type="date" class="form-control" />
                <span asp-validation-for="InsuranceExpiryDate" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="RevenueLicenseExpiryDate" class="form-label"></label>
                <input asp-for="RevenueLicenseExpiryDate" type="date" class="form-control" />
                <span asp-validation-for="RevenueLicenseExpiryDate" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="LastServiceDate" class="form-label"></label>
                <input asp-for="LastServiceDate" type="date" class="form-control" />
                <span asp-validation-for="LastServiceDate" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="NextServiceKm" class="form-label"></label>
                <input asp-for="NextServiceKm" type="number" class="form-control" />
                <span asp-validation-for="NextServiceKm" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="AssignedDepot" class="form-label"></label>
                <input asp-for="AssignedDepot" class="form-control" />
                <span asp-validation-for="AssignedDepot" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option>Available</option>
                    <option>In Service</option>
                    <option>Maintenance</option>
                    <option>Inactive</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="MaintenanceStatus" class="form-label"></label>
                <select asp-for="MaintenanceStatus" class="form-select">
                    <option>Good</option>
                    <option>Due</option>
                    <option>Critical</option>
                    <option>In Maintenance</option>
                    <option>Unavailable</option>
                </select>
                <span asp-validation-for="MaintenanceStatus" class="text-danger"></span>
            </div>
            <div>
                <label class="form-label">Active Vehicle</label>
                <select asp-for="IsActive" class="form-select">
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
        </div>

        <div class="enterprise-form-actions">
            <a asp-action="Index" class="srmss-btn secondary">Back</a>
            <button type="submit" class="srmss-btn primary">@(isEdit ? "Update Vehicle" : "Create Vehicle")</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


