@model SRMSS.Web.Models.CustomerFeedback

@{
    ViewData["Title"] = "Feedback Details";
    ViewData["PageTitle"] = "Feedback Details";
    ViewData["PageSubtitle"] = "Feedback message, route context and response history.";
    string role = Context.Session.GetString(SessionKeys.Role) ?? string.Empty;
    bool canRespond = role == "SuperAdmin" || role == "Admin" || role == "User";
}

<div class="module-hero feedback-hero mb-4">
    <div>
        <span class="module-kicker">@Model.Category Feedback</span>
        <h2>@Model.Subject</h2>
        <p>@Model.SubmittedAt.ToString("dd MMM yyyy HH:mm") | Rating @Model.Rating/5 | @Model.Status</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Index" class="srmss-btn secondary">Back</a>
        @if (canRespond)
        {
            <a asp-action="Respond" asp-route-id="@Model.Id" class="srmss-btn primary">Respond</a>
        }
    </div>
</div>

<div class="enterprise-detail-grid">
    <div class="srmss-card">
        <h3 class="card-title">Customer Message</h3>
        <div class="detail-list">
            <div><span>Customer</span><strong>@(Model.AppUser?.FullName ?? Model.CustomerKey)</strong></div>
            <div><span>Route</span><strong>@(Model.TransportRoute?.RouteName ?? "General feedback")</strong></div>
            <div><span>Rating</span><strong>@(new string('*', Model.Rating))@(new string('-', 5 - Model.Rating))</strong></div>
            <div><span>Priority</span><strong>@Model.Priority</strong></div>
        </div>
        <p class="feedback-message-box">@Model.Message</p>
    </div>

    <div class="srmss-card green">
        <h3 class="card-title">Depot Response</h3>
        <div class="detail-list">
            <div><span>Status</span><strong>@Model.Status</strong></div>
            <div><span>Responded At</span><strong>@(Model.RespondedAt?.ToString("dd MMM yyyy HH:mm") ?? "Not responded yet")</strong></div>
        </div>
        <p class="feedback-message-box">@(string.IsNullOrWhiteSpace(Model.Response) ? "No response has been added yet." : Model.Response)</p>
    </div>
</div>





