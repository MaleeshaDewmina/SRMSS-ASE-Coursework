@model SRMSS.Web.Models.FuelLog

@{
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Fuel Log" : "Add Fuel Log";
    ViewData["PageTitle"] = isEdit ? "Edit Fuel Log" : "Add Fuel Log";
    ViewData["PageSubtitle"] = "Record fuel usage, cost and efficiency information.";
}

<div class="srmss-card enterprise-form-card">
    <h3 class="card-title">Fuel Record</h3>
    <p class="card-subtitle">Efficiency is calculated automatically using distance covered and litres.</p>

    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
        @Html.AntiForgeryToken()
        @if (isEdit)
        {
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
        }
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="enterprise-form-grid">
            <div>
                <label asp-for="VehicleId" class="form-label"></label>
                <select asp-for="VehicleId" asp-items="ViewBag.VehicleId" class="form-select">
                    <option value="">Select Vehicle</option>
                </select>
                <span asp-validation-for="VehicleId" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="FuelDate" class="form-label"></label>
                <input asp-for="FuelDate" type="date" class="form-control" />
                <span asp-validation-for="FuelDate" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Litres" class="form-label"></label>
                <input asp-for="Litres" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Litres" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Cost" class="form-label"></label>
                <input asp-for="Cost" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Cost" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="DistanceCoveredKm" class="form-label"></label>
                <input asp-for="DistanceCoveredKm" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="DistanceCoveredKm" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="OdometerReading" class="form-label"></label>
                <input asp-for="OdometerReading" type="number" class="form-control" />
                <span asp-validation-for="OdometerReading" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="FuelStation" class="form-label"></label>
                <input asp-for="FuelStation" class="form-control" />
                <span asp-validation-for="FuelStation" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="ReceiptNumber" class="form-label"></label>
                <input asp-for="ReceiptNumber" class="form-control" />
                <span asp-validation-for="ReceiptNumber" class="text-danger"></span>
            </div>
            <div class="enterprise-form-wide">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" rows="3" class="form-control"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
        </div>

        <div class="enterprise-form-actions">
            <a asp-action="Index" class="srmss-btn secondary">Back</a>
            <button type="submit" class="srmss-btn primary">@(isEdit ? "Update Fuel Log" : "Save Fuel Log")</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


