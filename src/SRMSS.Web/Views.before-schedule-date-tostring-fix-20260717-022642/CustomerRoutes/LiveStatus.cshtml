@model IEnumerable<SRMSS.Web.Models.Schedule>

@{
    ViewData["Title"] = "Live Trip Status";
    ViewData["PageTitle"] = "Live Trip Status";
    ViewData["PageSubtitle"] = "Track current and upcoming transport trip status.";
}

<section class="customer-page-shell">

    <div class="customer-hero compact live">
        <div>
            <span class="hero-kicker">
                LIVE TRIP BOARD
            </span>

            <h1>
                Current Trip Status
            </h1>

            <p>
                View scheduled, departed, delayed, completed and cancelled trip updates.
            </p>
        </div>

        <a href="/CustomerRoutes/Timetable"
           class="hero-action-btn">
            View Timetable
        </a>
    </div>


    <div class="customer-status-tabs">

        <a href="/CustomerRoutes/LiveStatus"
           class="status-filter-link @(string.IsNullOrWhiteSpace(ViewBag.Status as string) ? "active" : "")">
            All
        </a>

        <a href="/CustomerRoutes/LiveStatus?status=Scheduled"
           class="status-filter-link @((ViewBag.Status as string) == "Scheduled" ? "active" : "")">
            Scheduled
        </a>

        <a href="/CustomerRoutes/LiveStatus?status=Departed"
           class="status-filter-link @((ViewBag.Status as string) == "Departed" ? "active" : "")">
            Departed
        </a>

        <a href="/CustomerRoutes/LiveStatus?status=Delayed"
           class="status-filter-link @((ViewBag.Status as string) == "Delayed" ? "active" : "")">
            Delayed
        </a>

        <a href="/CustomerRoutes/LiveStatus?status=Completed"
           class="status-filter-link @((ViewBag.Status as string) == "Completed" ? "active" : "")">
            Completed
        </a>

        <a href="/CustomerRoutes/LiveStatus?status=Cancelled"
           class="status-filter-link @((ViewBag.Status as string) == "Cancelled" ? "active" : "")">
            Cancelled
        </a>

    </div>


    <div class="srmss-card">

        <div class="table-responsive">

            <table class="srmss-table">
                <thead>
                    <tr>
                        <th>Route</th>
                        <th>Journey</th>
                        <th>Date</th>
                        <th>Departure</th>
                        <th>Arrival</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        foreach (var schedule in Model)
                        {
                            string statusClass =
                                schedule.Status == "Completed"
                                    ? "green"
                                    : schedule.Status == "Delayed"
                                        ? "amber"
                                        : schedule.Status == "Cancelled"
                                            ? "red"
                                            : "blue";

                            <tr>
                                <td>
                                    <strong>
                                        @(schedule.TransportRoute?.RouteName ?? "Route")
                                    </strong>
                                </td>

                                <td>
                                    @(schedule.TransportRoute?.StartPoint ?? "Start")
                                    →
                                    @(schedule.TransportRoute?.EndPoint ?? "End")
                                </td>

                                <td>
                                    @schedule.ScheduleDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @(schedule.DepartureTime.ToString(@"hh\:mm"))
                                </td>

                                <td>
                                    @(schedule.ArrivalTime.ToString(@"hh\:mm"))
                                </td>

                                <td>
                                    <span class="status-pill @statusClass">
                                        @schedule.Status
                                    </span>
                                </td>

                                <td>
                                    <a href="/CustomerRoutes/Details/@schedule.TransportRouteId"
                                       class="action-link">
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center py-5">
                                No trip status records found.
                            </td>
                        </tr>
                    }

                </tbody>
            </table>

        </div>

    </div>

</section>

